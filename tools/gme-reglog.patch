@@ -0,0 +1,12 @@
+#ifndef RG_REGLOG_H
+#define RG_REGLOG_H
+extern "C" {
+extern void (*rg_rl_w)(unsigned addr, int data);
+extern void (*rg_rl_f)(long t);
+extern long long rg_rl_base;
+extern long rg_rl_rate;
+extern long rg_rl_skip;
+}
+#define RG_W(a,d) do{ if(rg_rl_w) rg_rl_w((unsigned)(a),(int)(d)&0xFF); }while(0)
+#define RG_F(t) do{ if(rg_rl_f) rg_rl_f((long)(t)); }while(0)
+#endif
