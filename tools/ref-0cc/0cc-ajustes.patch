diff --git a/0ccft-ext/CMakeLists.txt b/0ccft-ext/CMakeLists.txt
index 25c0530..3ecb9f6 100644
--- a/0ccft-ext/CMakeLists.txt
+++ b/0ccft-ext/CMakeLists.txt
@@ -8,11 +8,12 @@ if(MSVC)
 		/wd4100 /wd4244 /wd4245 /wd4389
 		/DFT0CC_EXT_BUILD /DWIN32)
 else()
-	add_compile_options(-O3 -Wall -Wextra -Wpedantic -Werror
+	add_compile_options(-O3 -w
 		-Wno-switch -Wno-sign-compare -Wno-narrowing -Wno-unused-parameter
 		-DFT0CC_EXT_BUILD)
 endif()
 
+add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-include${CMAKE_SOURCE_DIR}/rgpre.h>)
 set(FT0CC_ROOT ../Source)
 set(LIBFT0CC_ROOT ../libft0cc)
 
@@ -158,7 +159,7 @@ set(SRCS
 #	${FT0CC_ROOT}/PatternComponent.cpp
 	${FT0CC_ROOT}/PatternData.cpp
 #	${FT0CC_ROOT}/PatternEditor.cpp
-	${FT0CC_ROOT}/PatternEditorTypes.cpp
+#	${FT0CC_ROOT}/PatternEditorTypes.cpp
 #	${FT0CC_ROOT}/PCMImport.cpp
 #	${FT0CC_ROOT}/PerformanceDlg.cpp
 	${FT0CC_ROOT}/PeriodTables.cpp
@@ -232,3 +233,11 @@ endif()
 add_executable(ft0cc-test testMain.cpp)
 target_include_directories(ft0cc-test PRIVATE ${FT0CC_ROOT} ${LIBFT0CC_ROOT}/include)
 target_link_libraries(ft0cc-test PRIVATE ft0cc)
+
+add_executable(occnsf occnsf.cpp)
+target_include_directories(occnsf PRIVATE ${FT0CC_ROOT} ${LIBFT0CC_ROOT}/include)
+target_link_libraries(occnsf PRIVATE ft0cc)
+
+add_executable(occrender occrender.cpp)
+target_include_directories(occrender PRIVATE ${FT0CC_ROOT} ${LIBFT0CC_ROOT}/include)
+target_link_libraries(occrender PRIVATE ft0cc)
