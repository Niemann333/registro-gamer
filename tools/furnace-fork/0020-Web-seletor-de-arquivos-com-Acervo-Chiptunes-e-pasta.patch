+#ifdef __EMSCRIPTEN__
+// Web: no lugar dos favoritos, os "lugares": acervo do blog, pastas do computador conectadas e o botão de conectar
+void FurnaceFilePicker::drawBookmarks(ImVec2& tableSize, String& newDir) {
+  static char buf[8192];
+  rgWebPlaces(buf,sizeof(buf));
+  // formato: título\n e depois linhas "tipo\tnome\tcaminho" (tipo: a = acervo, c = computador, + = conectar)
+  String all=buf, title;
+  std::vector<String> lines;
+  size_t pos=0;
+  while (pos<=all.size()) {
+    size_t nl=all.find('\n',pos);
+    if (nl==String::npos) nl=all.size();
+    lines.push_back(all.substr(pos,nl-pos));
+    pos=nl+1;
+  }
+  if (!lines.empty()) { title=lines[0]; lines.erase(lines.begin()); }
+  if (ImGui::BeginTable("BookmarksList",1,ImGuiTableFlags_BordersOuter|ImGuiTableFlags_ScrollY,tableSize)) {
+    ImGui::TableSetupScrollFreeze(0,1);
+    ImGui::TableNextRow(ImGuiTableRowFlags_Headers);
+    ImGui::TableNextColumn();
+    ImGui::TextUnformatted(title.c_str());
+    int index=0;
+    for (String& l: lines) {
+      size_t t1=l.find('\t');
+      if (t1==String::npos) continue;
+      size_t t2=l.find('\t',t1+1);
+      if (t2==String::npos) continue;
+      String kind=l.substr(0,t1), name=l.substr(t1+1,t2-t1-1), where=l.substr(t2+1);
+      const char* icon=(kind=="a")?ICON_FA_MUSIC:((kind=="+")?ICON_FA_PLUS:ICON_FA_FOLDER);
+      String label=String(icon)+" "+name;
+      bool here=(!where.empty() && (path==where || path.find(where+"/")==0));
+      ImGui::TableNextRow();
+      ImGui::TableNextColumn();
+      ImGui::PushID(300000+(index++));
+      if (ImGui::Selectable(label.c_str(),here)) {
+        if (kind=="+") {
+          char got[2048];
+          got[0]=0;
+          rgWebConnect(got,sizeof(got));
+          if (got[0]) newDir=got;
+        } else {
+          newDir=where;
+        }
+      }
+      ImGui::PopID();
+    }
+    ImGui::EndTable();
+  }
+}
+#else
 void FurnaceFilePicker::drawBookmarks(ImVec2& tableSize, String& newDir) {
   if (ImGui::BeginTable("BookmarksList",1,ImGuiTableFlags_BordersOuter|ImGuiTableFlags_ScrollY,tableSize)) {
     ImGui::TableSetupScrollFreeze(0,1);
@@ -1299,6 +1362,7 @@ void FurnaceFilePicker::drawBookmarks(ImVec2& tableSize, String& newDir) {
