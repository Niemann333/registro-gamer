+// Web: a pasta inicial é a pasta do computador conectada (ou o acervo, para abrir), nunca a pasta interna do motor
+EM_JS(void, rgWebDefaultDir, (int save, char* buf, int len), { var s = Module.rgDefaultDir ? Module.rgDefaultDir(!!save) : ''; stringToUTF8(s || '', buf, len); });
+static String rgWebStartDir(const String& path, bool save) {
+  if (path.find("/Acervo")==0 || path.find("/Computador/")==0) {
+    if (!(save && path.find("/Acervo")==0)) return path;
+  }
+  char buf[2048];
+  buf[0]=0;
+  rgWebDefaultDir(save?1:0,buf,sizeof(buf));
+  return buf[0]?String(buf):path;
+}
