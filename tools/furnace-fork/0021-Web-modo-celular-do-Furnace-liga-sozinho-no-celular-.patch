From d085d3959c97e41af48501f35ef142bad0f861b2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 02:57:04 -0300
Subject: [PATCH 21/37] Web: modo celular do Furnace (liga sozinho no celular,
 menu para alternar)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RkyeBarU4jeQnXhRw3i52u
---
 src/gui/gui.cpp | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/gui/gui.cpp b/src/gui/gui.cpp
index f94307a..ed8ceb8 100644
--- a/src/gui/gui.cpp
+++ b/src/gui/gui.cpp
@@ -4120,6 +4120,9 @@ void FurnaceGUI::editOptions(bool topMenu) {
   }
 }
 
+#ifdef __EMSCRIPTEN__
+EM_JS(int, rgWebMobile, (), { return Module.rgMobile ? 1 : 0; });
+#endif
 void FurnaceGUI::toggleMobileUI(bool enable, bool force) {
   if (mobileUI!=enable || force) {
     // the only moment force is true is during GUI init.
@@ -4149,6 +4152,12 @@ void FurnaceGUI::toggleMobileUI(bool enable, bool force) {
       ImGui::GetIO().AlwaysScrollText=true;
       fileDialog->mobileUI=true;
       newFilePicker->setMobile(true);
+#ifdef __EMSCRIPTEN__
+      // Web: no celular estas janelas abriam soltas por cima dos padrões
+      effectListOpen=false;
+      oscOpen=false;
+      volMeterOpen=false;
+#endif
     } else {
       ImGui::GetIO().ConfigFlags&=~ImGuiConfigFlags_InertialScrollEnable;
       ImGui::GetIO().ConfigFlags&=~ImGuiConfigFlags_NoHoverColors;
@@ -4960,6 +4969,9 @@ bool FurnaceGUI::loop() {
       int prevScrW=scrW;
       int prevScrH=scrH;
       SDL_GetWindowSize(sdlWin,&scrW,&scrH);
+#ifdef __EMSCRIPTEN__
+      portrait=(scrW<scrH); // Web: celular em pé usa o layout vertical do modo celular
+#endif
       if (prevScrW!=scrW || prevScrH!=scrH) {
         logV("size change 2: %dx%d (from %dx%d)",scrW,scrH,prevScrW,prevScrH);
       }
@@ -5646,7 +5658,7 @@ bool FurnaceGUI::loop() {
         if (ImGui::MenuItem(_("reset layout"))) {
           showWarning(_("Are you sure you want to reset the workspace layout?"),GUI_WARN_RESET_LAYOUT);
         }
-#ifdef IS_MOBILE
+#if defined(IS_MOBILE) || defined(__EMSCRIPTEN__)
         if (ImGui::MenuItem(_("switch to mobile view"))) {
           toggleMobileUI(!mobileUI);
         }
@@ -9336,6 +9348,10 @@ void FurnaceGUI::syncState() {
   fullScreen=e->getConfBool("fullScreen",false);
 #endif
   mobileUI=e->getConfBool("mobileUI",MOBILE_UI_DEFAULT);
+#ifdef __EMSCRIPTEN__
+  // Web: o modo celular liga sozinho quando a página foi aberta num celular/tablet (a página avisa em Module.rgMobile)
+  mobileUI=rgWebMobile();
+#endif
   edit=e->getConfBool("edit",false);
   orderLock=e->getConfBool("orderLock",false);
   followOrders=e->getConfBool("followOrders",true);
-- 
