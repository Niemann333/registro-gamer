diff --git a/src/gui/newFilePicker.cpp b/src/gui/newFilePicker.cpp
index 604af78..fae982a 100644
--- a/src/gui/newFilePicker.cpp
+++ b/src/gui/newFilePicker.cpp
@@ -589,11 +589,21 @@ bool FurnaceFilePicker::readDirectory(String path) {
   haveStat=false;
   stopReading=false;
   scheduledSort=1;
+#ifdef __EMSCRIPTEN__
+  // navegador sem threads: lê a pasta (que fica na memória) na hora
+  fileThread=NULL;
+  if (isSearch) {
+    _searchThread(this);
+  } else {
+    _fileThread(this);
+  }
+#else
   if (isSearch) {
     fileThread=new std::thread(_searchThread,this);
   } else {
     fileThread=new std::thread(_fileThread,this);
   }
+#endif
 
   // check whether this path is bookmarked
   isPathBookmarked=false;
diff --git a/src/main.cpp b/src/main.cpp
index e3da604..1abeb29 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -700,9 +700,25 @@ static void handleTermGUI(int) {
 #endif
 #endif
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+// Registro Gamer: pasta do usuário guardada no navegador (IndexedDB)
+EM_ASYNC_JS(void, rgWebMountHome, (), {
+  try { FS.mkdir('/home/web_user'); } catch (e) {}
+  FS.mount(IDBFS, {}, '/home/web_user');
+  await new Promise(function (ok) { FS.syncfs(true, function () { ok(); }); });
+  ['Projetos', 'Exportados', 'Instrumentos'].forEach(function (d) { try { FS.mkdir('/home/web_user/' + d); } catch (e) {} });
+  if (!Module.rgSyncTimer) Module.rgSyncTimer = setInterval(function () { FS.syncfs(false, function () {}); }, 4000);
+  if (Module.onRgReady) Module.onRgReady();
+});
+#endif
+
 // TODO: CoInitializeEx on Windows?
 // TODO: add crash log
 int main(int argc, char** argv) {
+#ifdef __EMSCRIPTEN__
+  rgWebMountHome();
+#endif
