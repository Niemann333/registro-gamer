diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9c7619f..9f5b894 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1456,6 +1456,14 @@ endif()
 target_include_directories(${FURNACE} SYSTEM PRIVATE ${DEPENDENCIES_INCLUDE_DIRS})
 target_compile_options(${FURNACE} PRIVATE ${DEPENDENCIES_COMPILE_OPTIONS})
 target_link_libraries(${FURNACE} PRIVATE ${DEPENDENCIES_LIBRARIES})
+if (EMSCRIPTEN)
+  # Registro Gamer: build para navegador
+  target_link_options(${FURNACE} PRIVATE
+    "SHELL:-sASYNCIFY" "SHELL:-sASYNCIFY_STACK_SIZE=131072" "SHELL:-sALLOW_MEMORY_GROWTH=1" "SHELL:-sINITIAL_MEMORY=134217728"
+    "SHELL:-sTOTAL_STACK=5242880" "-lidbfs.js" "SHELL:-sFORCE_FILESYSTEM=1" "SHELL:-sMIN_WEBGL_VERSION=1" "SHELL:-sMAX_WEBGL_VERSION=2"
+    "SHELL:-sEXPORTED_RUNTIME_METHODS=FS,ccall" "SHELL:-sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$UTF8ToString,$stringToUTF8,$autoResumeAudioContext,$dynCall"
+    "-fexceptions" "SHELL:-sEXIT_RUNTIME=0" "SHELL:-sENVIRONMENT=web")
+endif()
 if (PKG_CONFIG_FOUND AND (SYSTEM_FMT OR SYSTEM_LIBSNDFILE OR SYSTEM_ZLIB OR SYSTEM_SDL2 OR SYSTEM_RTMIDI OR WITH_JACK))
   if ("${CMAKE_VERSION}" VERSION_LESS "3.13")
     message(WARNING
