From 10c8e650368d19173325d072d176a3991b537d35 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 02:25:26 -0300
Subject: [PATCH 19/35] Web: idioma da interface (en_US ou pt_BR) vem de
 Module.rgLang

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RkyeBarU4jeQnXhRw3i52u
---
 src/gui/settings/loadSettings.cpp | 6 +++++-
 src/main.cpp                      | 5 ++++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/gui/settings/loadSettings.cpp b/src/gui/settings/loadSettings.cpp
index e15374a..d814ee7 100644
--- a/src/gui/settings/loadSettings.cpp
+++ b/src/gui/settings/loadSettings.cpp
@@ -20,6 +20,10 @@
 // loadSettings.cpp: the code which loads and stores settings from/to the config file.
 
 #include "../gui.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+EM_JS(int, rgWebLangEN_set, (), { return (Module.rgLang === 'en') ? 1 : 0; });
+#endif
 #include "../guiConst.h"
 
 // yes, this array must live here.
@@ -245,7 +249,7 @@ void FurnaceGUI::readConfig(DivConfig& conf, FurnaceGUISettingGroups groups) {
     settings.autoFillSave=conf.getBool("autoFillSave",0);
 
 #ifdef __EMSCRIPTEN__
-    settings.locale=conf.getString("locale","pt_BR"); // Chiptune Studio: português por padrão
+    settings.locale=rgWebLangEN_set()?"en_US":"pt_BR"; // Chiptune Studio: idioma do blog (PT | EN)
 #else
     settings.locale=conf.getString("locale","");
 #endif
diff --git a/src/main.cpp b/src/main.cpp
index c98d605..dbe3611 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -705,6 +705,8 @@ static void handleTermGUI(int) {
 
 #ifdef __EMSCRIPTEN__
 #include <emscripten.h>
+// Registro Gamer: idioma escolhido no blog (Module.rgLang = 'en' ou 'pt')
+EM_JS(int, rgWebLangEN, (), { return (Module.rgLang === 'en') ? 1 : 0; });
 // Registro Gamer: a pasta do usuário fica só na memória (como um programa: fechou sem salvar, perdeu).
 // Só as configurações do Furnace (~/.config) ficam guardadas no navegador.
 EM_ASYNC_JS(void, rgWebMountHome, (), {
@@ -802,7 +804,8 @@ int main(int argc, char** argv) {
 
 #ifdef HAVE_LOCALE
 #ifdef __EMSCRIPTEN__
-  String reqLocale=e.getConfString("locale","pt_BR"); // Chiptune Studio: português por padrão
+  // Chiptune Studio: o idioma vem da página (botão PT | EN do blog)
+  String reqLocale=rgWebLangEN()?"en_US":"pt_BR";
 #else
   String reqLocale=e.getConfString("locale","");
 #endif
-- 
