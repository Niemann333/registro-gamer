@@ -438,6 +438,9 @@ namespace ImGui
     //    BeginXXX function returned true. Begin and BeginChild are the only odd ones out. Will be fixed in a future update.]
     // - Note that the bottom of window stack always contains a window called "Debug".
     IMGUI_API bool          Begin(const char* name, bool* p_open = NULL, ImGuiWindowFlags flags = 0, const char* displayedName = NULL);
+    // Registro Gamer (web, celular): a proxima janela de topo (nao popup/filha) ocupa exatamente este retangulo, sem barra de titulo
+    IMGUI_API void          RgForceNextWindow(const ImVec2& pos, const ImVec2& size);
+    IMGUI_API void          RgForceClear();
     IMGUI_API void          End();
 
     // Child Windows
diff --git a/src/gui/editControls.cpp b/src/gui/editControls.cpp
index 14ffe3e..1176d9d 100644
--- a/src/gui/editControls.cpp
+++ b/src/gui/editControls.cpp
@@ -1215,3 +1215,253 @@ void FurnaceGUI::drawEditControls() {
