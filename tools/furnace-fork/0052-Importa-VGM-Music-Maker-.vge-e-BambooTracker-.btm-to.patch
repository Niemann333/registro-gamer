+#include "instrument/envelope_fm.cpp"
+#define DEF_PARAMS DEF_PARAMS_LFO
+#include "instrument/lfo_fm.cpp"
+#undef DEF_PARAMS
+#include "instrument/sample_adpcm.cpp"
