+
+int convertDtFromDmpTfiVgi(int dt)
+{
+	switch (dt) {
+	case 0:		return 7;
+	case 1:		return 6;
+	case 2:		return 5;
+	case 3:		return 0;
+	case 4:		return 1;
+	case 5:		return 2;
+	case 6:		return 3;
+	case 7:		return 3;
+	default:	throw std::out_of_range("Out of range dt");
+	}
