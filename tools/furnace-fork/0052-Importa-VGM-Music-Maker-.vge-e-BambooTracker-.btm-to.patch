+// RG: escrita do tocador do BambooTracker; o mudo de cada canal vai junto (pan/volume)
+static unsigned char rgBTMasked(DivPlatformYM2608* d, unsigned short addr, unsigned char val, bool* isMuted, bool* opMute) {
+  unsigned char r=addr&0xff;
+  bool b=(addr&0x100)!=0;
+  if (r>=0xb4 && r<=0xb6) {
+    int ch=(b?3:0)+(r-0xb4);
+    if (isMuted[ch]) return val&0x3f;
+  } else if (!b && r>=0x08 && r<=0x0a) {
+    if (isMuted[6+(r-0x08)]) return 0;
+  } else if (!b && r>=0x18 && r<=0x1d) {
+    if (isMuted[9+(r-0x18)]) return val&0x1f;
+  } else if (b && r==0x01) {
+    if (isMuted[15]) return val&0x3f;
+  } else if (!b && r>=0x40 && r<=0x4f && (r&3)==2) {
+    // nível dos operadores do FM3 (modo estendido): operador mudo = 127
+    const int slot[4]={0,2,1,3}; // 0x42, 0x46, 0x4a, 0x4e = operadores 1, 3, 2, 4
+    int op=slot[(r-0x40)>>2];
+    if (opMute[op]) return 0x7f;
+  }
+  return val;
+}
+
+void DivPlatformYM2608::rgBTWrite(unsigned short addr, unsigned char val) {
+  addr&=0x1ff;
+  rgBTReg[addr]=val;
+  immWrite(addr,rgBTMasked(this,addr,val,isMuted,rgBTOpMute));
+}
+
+void DivPlatformYM2608::rgBTMute(int ch) {
+  if (ch<6) {
+    unsigned short a=((ch>=3)?0x100:0)|(0xb4+(ch%3));
+    immWrite(a,rgBTMasked(this,a,rgBTReg[a],isMuted,rgBTOpMute));
+  } else if (ch<9) {
+    immWrite(0x08+(ch-6),rgBTMasked(this,0x08+(ch-6),rgBTReg[0x08+(ch-6)],isMuted,rgBTOpMute));
+  } else if (ch<15) {
+    immWrite(0x18+(ch-9),rgBTMasked(this,0x18+(ch-9),rgBTReg[0x18+(ch-9)],isMuted,rgBTOpMute));
+  } else {
+    immWrite(0x101,rgBTMasked(this,0x101,rgBTReg[0x101],isMuted,rgBTOpMute));
+  }
+}
+
+void DivPlatformYM2608::rgBTOpMuted(int op, bool mute) {
+  rgBTOpMute[op&3]=mute;
+  for (int r=0x42; r<=0x4e; r+=4) immWrite(r,rgBTMasked(this,r,rgBTReg[r],isMuted,rgBTOpMute));
+}
