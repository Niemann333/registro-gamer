+# VGM Music Maker (núcleo do tocador)
+
+Cópia de `src/core` de https://github.com/Drozerix/VGMMM — reconstrução em C++ do VGM Music Maker 1.1 do Shiru
+(publicada com a permissão dele, segundo o README do projeto). Usada pelo importador de .vge do Furnace (fork do
+Registro Gamer) para tocar os módulos exatamente como o programa original: o tocador gera as escritas nos
+registradores do YM2612 e do SN76489 a cada tique, e o Furnace as manda para os chips.
+
+Mudança local: `player.cpp` chama `g_rgDacHook` em `dac_start`/`dac_stop` (o DAC toca pelo Furnace).
+Tudo é compilado dentro do namespace `rgvgmmm` por `rgvge_unity.cpp`.
diff --git a/extern/vgmmm/instrument.cpp b/extern/vgmmm/instrument.cpp
new file mode 100644
index 0000000..7e428ea
--- /dev/null
+++ b/extern/vgmmm/instrument.cpp
@@ -0,0 +1,291 @@
+// FM instruments: defaults and the instrument file formats the editor can read.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "song.h"
+
+const uint8_t g_defaultInsVgi[43] = {
+    4, 0, 0,
+    0, 3, 127, 0, 31, 31, 31, 15, 0, 0,
+    1, 3, 15, 0, 31, 31, 8, 15, 0, 0,
+    0, 3, 127, 0, 31, 31, 31, 15, 0, 0,
+    1, 3, 16, 0, 31, 31, 10, 15, 0, 0,
+};
+
+void ins_clear(Instrument *ins)
+{
+    memset(ins, 0, sizeof(Instrument));
+    memcpy(ins->name, "empty", 6);
+    for (int i = 0; i < 4; i++) {
+        ins->op[i].tl = 0x7f;
+        ins->op[i].ar = 0x1f;
+        ins->op[i].dr = 0x1f;
+        ins->op[i].sr = 0x1f;
+        ins->op[i].rr = 0xf;
+    }
+}
+
+bool ins_is_empty(const Instrument *ins)
+{
+    Instrument blank;
+    ins_clear(&blank);
+    return memcmp(ins, &blank, sizeof(Instrument)) == 0;
+}
+
+static void ins_op_add_tl(Instrument *ins, int op, int delta)
+{
+    int v = ins->op[op].tl + delta;
+    if (v < 0)
+        v = 0;
+    if (v > 0x7f)
+        v = 0x7f;
+    ins->op[op].tl = (uint8_t)v;
+}
+
+// Changes the level of the carrier operators of the instrument's algorithm.
+void ins_change_volume(Instrument *ins, int delta)
+{
+    if (ins->alg == 7)
+        ins_op_add_tl(ins, 0, delta);
+    if (ins->alg > 4)
+        ins_op_add_tl(ins, 1, delta);
+    if (ins->alg > 3)
+        ins_op_add_tl(ins, 2, delta);
+    ins_op_add_tl(ins, 3, delta);
+}
+
+// Detune: register value (0..7) <-> signed amount (-3..3)
+int dt_from_reg(int v)
+{
+    switch (v) {
+    case 1: return 1;
+    case 2: return 2;
+    case 3: return 3;
+    case 5: return -1;
+    case 6: return -2;
+    case 7: return -3;
+    default: return 0;
+    }
+}
+
+int dt_to_reg(int v)
+{
+    switch (v) {
+    case 1: return 1;
+    case 2: return 2;
+    case 3: return 3;
+    case -3: return 7;
+    case -2: return 6;
+    case -1: return 5;
+    default: return 0;
+    }
+}
+
+// Ten bytes per operator as stored in .vgi/.tfi files.
+static void op_from_tfi(Operator *op, const uint8_t *p)
+{
+    op->mult = p[0] & 0xf;
+    op->dt = (int8_t)((p[1] & 7) - 3);
+    op->tl = p[2] & 0x7f;
+    op->rs = p[3] & 3;
+    op->ar = p[4] & 0x1f;
+    op->dr = p[5] & 0x9f;
+    op->sr = p[6] & 0x1f;
+    op->rr = p[7] & 0xf;
+    op->sl = p[8] & 0xf;
+    op->ssg = p[9] & 0xf;
+}
+
+void ins_from_vgi(Instrument *ins, const uint8_t *vgi)
+{
+    ins->alg = vgi[0];
+    ins->fb = vgi[1];
+    ins->ams = (vgi[2] >> 4) & 3;
+    ins->fms = vgi[2] & 7;
+    for (int i = 0; i < 4; i++)
+        op_from_tfi(&ins->op[i], vgi + 3 + i * 10);
+}
+
+enum { FMT_NONE, FMT_VGI, FMT_TFI, FMT_DAT, FMT_Y12, FMT_INS, FMT_BIN };
+
+bool ins_load(Instrument *ins, const char *filename)
+{
+    static const int opOrder[4] = {0, 2, 1, 3};
+    char ext[3];
+    size_t n = strlen(filename);
+    if (n < 3)
+        return false;
+    memcpy(ext, filename + n - 3, 3);
+    for (int i = 0; i < 3; i++)
+        if (ext[i] > '@' && ext[i] < '[')
+            ext[i] += ' ';
+    int fmt = memcmp(ext, "vgi", 3) == 0 ? FMT_VGI : FMT_NONE;
+    if (memcmp(ext, "tfi", 3) == 0) fmt = FMT_TFI;
+    if (memcmp(ext, "dat", 3) == 0) fmt = FMT_DAT;
+    if (memcmp(ext, "y12", 3) == 0) fmt = FMT_Y12;
+    if (memcmp(ext, "ins", 3) == 0) fmt = FMT_INS;
+    if (memcmp(ext, "bin", 3) == 0) fmt = FMT_BIN;
+
+    FILE *f = fopen(filename, "rb");
+    if (f == nullptr)
+        return false;
+    fseek(f, 0, SEEK_END);
+    int size = (int)ftell(f);
+    fseek(f, 0, SEEK_SET);
+    switch (fmt) {
+    case FMT_VGI: if (size != 0x2b) fmt = FMT_NONE; break;
+    case FMT_TFI: if (size != 0x2a) fmt = FMT_NONE; break;
+    case FMT_DAT: if (size != 0x34) fmt = FMT_NONE; break;
+    case FMT_Y12: if (size != 0x80) fmt = FMT_NONE; break;
+    case FMT_INS: if (size > 0xff) fmt = FMT_NONE; break;
+    case FMT_BIN: if (size != 0x19) fmt = FMT_NONE; break;
+    }
+    if (fmt == FMT_NONE) {
+        fclose(f);
+        return false;
+    }
+    // zero padding so a short .ins file cannot be read out of bounds
+    uint8_t *d = (uint8_t *)calloc((size_t)size + 0x200, 1);
+    if (fread(d, 1, size, f) != (size_t)size) {
+        fclose(f);
+        free(d);
+        return false;
+    }
+    fclose(f);
+
+    switch (fmt) {
+    case FMT_VGI:
+        ins_clear(ins);
+        ins_from_vgi(ins, d);
+        break;
+    case FMT_TFI:
+        ins_clear(ins);
+        ins->alg = d[0];
+        ins->fb = d[1];
+        for (int i = 0; i < 4; i++)
+            op_from_tfi(&ins->op[i], d + 2 + i * 10);
+        break;
+    case FMT_DAT:       // pairs of (YM2612 register, value)
+        ins_clear(ins);
+        for (int i = 0; i < size; i += 2) {
+            unsigned reg = d[i];
+            uint8_t val = d[i + 1];
+            unsigned base = reg & 0xfffffff3;
+            if (base == 0x30) {
+                Operator *op = &ins->op[(int)(reg - 0x30) >> 2];
+                op->mult = val & 0xf;
+                op->dt = (int8_t)dt_from_reg((val & 0x70) >> 4);
+            } else if (base == 0x40) {
+                ins->op[(int)(reg - 0x40) >> 2].tl = val & 0x7f;
+            } else if (base == 0x50) {
+                Operator *op = &ins->op[(int)(reg - 0x50) >> 2];
+                op->ar = val & 0x1f;
+                op->rs = val >> 6;
+            } else if (base == 0x60) {
+                ins->op[(int)(reg - 0x60) >> 2].dr = val & 0x9f;
+            } else if (base == 0x70) {
+                ins->op[(int)(reg - 0x70) >> 2].sr = val & 0x1f;
+            } else if (base == 0x80) {
+                Operator *op = &ins->op[(int)(reg - 0x80) >> 2];
+                op->rr = val & 0xf;
+                op->sl = val >> 4;
+            } else if (reg == 0xb0) {
+                ins->alg = val & 7;
+                ins->fb = (val >> 3) & 7;
+            }
+        }
+        break;
+    case FMT_Y12:
+        ins_clear(ins);
+        for (int i = 0; i < 4; i++) {
+            const uint8_t *p = d + i * 0x10;
+            Operator *op = &ins->op[i];
+            op->mult = p[0] & 0xf;
+            op->dt = (int8_t)dt_from_reg(p[0] >> 4);
+            op->tl = p[1] & 0x7f;
+            op->rs = p[2] >> 6;
+            op->ar = p[2] & 0x1f;
+            op->dr = p[3] & 0x9f;
+            op->sr = p[4] & 0x1f;
+            op->rr = p[5] & 0xf;
+            op->sl = p[5] >> 4;
+        }
+        ins->alg = d[0x40] & 7;
+        ins->fb = d[0x41] & 7;
+        break;
+    case FMT_INS:
+        if (memcmp(d, "MVSI1", 5) == 0) {
+            ins_clear(ins);
+            int off = 5;
+            for (const uint8_t *p = d + 4; *p != 0; p++)
+                off++;
+            for (int i = 0; i < 4; i++) {
+                int o = opOrder[i] + off;
+                Operator *op = &ins->op[i];
+                op->mult = d[o] & 0xf;
+                op->dt = (int8_t)dt_from_reg(d[o] >> 4);
+                op->tl = d[o + 4] & 0x7f;
+                op->rs = d[o + 8] >> 6;
+                op->ar = d[o + 8] & 0x1f;
+                op->dr = d[o + 0xc] & 0x9f;
+                op->sr = d[o + 0x10] & 0x1f;
+                op->rr = d[o + 0x14] & 0xf;
+                op->sl = d[o + 0x14] >> 4;
+            }
+            ins->alg = d[off + 0x18] & 7;
+            ins->fb = (d[off + 0x18] >> 3) & 7;
+        }
+        break;
+    case FMT_BIN: {
+        ins_clear(ins);
+        ins->alg = d[0] & 7;
+        ins->fb = (d[0] >> 3) & 7;
+        const uint8_t *p = d;
+        for (int i = 0; i < 4; i++) {
+            Operator *op = &ins->op[opOrder[i]];
+            op->dt = (int8_t)dt_from_reg(p[1] >> 4);
+            op->mult = p[1] & 0xf;
+            op->ar = p[5] & 0x1f;
+            op->rs = p[5] >> 6;
+            op->dr = p[9] & 0x9f;
+            op->sr = p[0xd] & 0x1f;
+            op->rr = p[0x11] & 0xf;
+            op->sl = p[0x11] >> 4;
+            op->tl = p[0x15] & 0x7f;
+            p++;
+        }
+        break;
+    }
+    }
+    free(d);
+    return true;
+}
+
+bool ins_save_vgi(const Instrument *ins, const char *filename)
+{
+    uint8_t d[43];
+    d[0] = ins->alg;
+    d[1] = ins->fb;
+    d[2] = (uint8_t)(ins->ams << 4 | ins->fms);
+    for (int i = 0; i < 4; i++) {
+        const Operator *op = &ins->op[i];
+        uint8_t *p = d + 3 + i * 10;
+        p[0] = op->mult;
+        p[1] = (uint8_t)(op->dt + 3);
+        p[2] = op->tl;
+        p[3] = op->rs;
+        p[4] = op->ar;
+        p[5] = op->dr;
+        p[6] = op->sr;
+        p[7] = op->rr;
+        p[8] = op->sl;
+        p[9] = op->ssg;
+    }
+    FILE *f = fopen(filename, "wb");
+    if (f == nullptr)
+        return false;
+    fwrite(d, sizeof(d), 1, f);
+    fclose(f);
+    return true;
+}
diff --git a/extern/vgmmm/pack.cpp b/extern/vgmmm/pack.cpp
new file mode 100644
index 0000000..d5e94bf
--- /dev/null
+++ b/extern/vgmmm/pack.cpp
@@ -0,0 +1,166 @@
+// Run-length coded byte stream used by the .vge module format.
+//
+// A run of three or more equal bytes is stored as: the byte, the marker 0x80, then the run
+// length as a little-endian base-128 number whose last digit has bit 7 set. A literal 0x80 is
+// stored as 0x80 0x80 (a run length of zero).
+#include <cstdlib>
+#include <cstring>
+
+#include "song.h"
+
+uint8_t *pack_init(Packer *p, uint8_t *buf, int size, bool compress)
+{
+    if (buf == nullptr) {
+        p->size = 0x8000;
+        p->buf = (uint8_t *)malloc(0x8000);
+    } else {
+        p->buf = buf;
+        p->size = size;
+    }
+    p->marker = 0x80;
+    p->pos = 0;
+    p->prev = 0x101;
+    p->count = 0;
+    p->compress = compress;
+    return p->buf;
+}
+
+static inline uint8_t pack_get(Packer *p)
+{
+    // The original reads without a bounds check; a truncated file must not crash the port.
+    if (p->pos >= p->size) {
+        p->pos++;
+        return 0x80;
+    }
+    return p->buf[p->pos++];
+}
+
+uint8_t pack_read_byte(Packer *p)
+{
+    uint8_t b;
+    if (!p->compress) {
+        b = pack_get(p);
+    } else if (p->count < 2) {
+        b = pack_get(p);
+        if (b == (uint8_t)p->marker) {
+            uint8_t shift = 0;
+            p->count = 0;
+            for (;;) {
+                uint8_t c = pack_get(p);
+                p->count |= (unsigned)(c & 0x7f) << (shift & 0x1f);
+                if (c & 0x80)
+                    break;
+                shift += 7;
+            }
+            if (p->count == 0) {
+                b = (uint8_t)p->marker;
+            } else {
+                p->count--;
+                b = (uint8_t)p->prev;
+            }
+        } else {
+            p->prev = b;
+        }
+    } else {
+        p->count--;
+        b = (uint8_t)p->prev;
+    }
+    return b;
+}
+
+static inline void pack_grow(Packer *p)
+{
+    if ((unsigned)(p->size - 8) < (unsigned)p->pos) {
+        p->size += 0x8000;
+        p->buf = (uint8_t *)realloc(p->buf, p->size);
+    }
+}
+
+void pack_write(Packer *p, unsigned value)
+{
+    unsigned v = value & 0xff;
+    if (!p->compress) {
+        p->buf[p->pos++] = (uint8_t)value;
+        pack_grow(p);
+    } else if (v != (unsigned)p->prev || value > 0xff) {
+        if (p->count > 2) {
+            p->buf[p->pos++] = (uint8_t)p->marker;
+            while (p->count != 0) {
+                uint8_t last = p->count < 0x80 ? 0x80 : 0;
+                p->buf[p->pos++] = (uint8_t)((p->count & 0x7f) | last);
+                p->count >>= 7;
+            }
+        }
+        if (p->count == 2)
+            p->buf[p->pos++] = (uint8_t)p->prev;
+        if (value <= 0xff) {
+            p->count = 1;
+            p->buf[p->pos++] = (uint8_t)value;
+            if (v == (unsigned)p->marker) {
+                p->buf[p->pos++] = 0x80;
+                p->prev = 0x100;
+            } else {
+                p->prev = (int)v;
+            }
+            pack_grow(p);
+        }
+    } else {
+        p->count++;
+    }
+}
+
+void pack_write_byte(Packer *p, unsigned value)
+{
+    pack_write(p, value & 0xff);
+}
+
+void pack_flush(Packer *p)
+{
+    pack_write(p, 0xffffffff);
+}
+
+void pack_write_str(Packer *p, const char *s, int len)
+{
+    int n = (int)strlen(s);
+    for (int i = 0; i < n; i++)
+        pack_write_byte(p, (uint8_t)s[i]);
+    for (int i = 0; i < len - n; i++)
+        pack_write_byte(p, 0);
+}
+
+void pack_read_bytes(Packer *p, void *dst, int len)
+{
+    uint8_t *d = (uint8_t *)dst;
+    for (int i = 0; i < len; i++)
+        d[i] = pack_read_byte(p);
+}
+
+void pack_write16(Packer *p, unsigned v)
+{
+    pack_write_byte(p, v & 0xff);
+    pack_write_byte(p, v >> 8);
+}
+
+unsigned pack_read16(Packer *p)
+{
+    unsigned lo = pack_read_byte(p);
+    unsigned hi = pack_read_byte(p);
+    return lo | hi << 8;
+}
+
+void pack_write32(Packer *p, unsigned v)
+{
+    pack_write_byte(p, v & 0xff);
+    pack_write_byte(p, v >> 8 & 0xff);
+    pack_write_byte(p, v >> 16 & 0xff);
+    pack_write_byte(p, v >> 24);
+}
+
+unsigned pack_read32(Packer *p)
+{
+    unsigned b0 = pack_read_byte(p);
+    unsigned b1 = pack_read_byte(p);
+    unsigned b2 = pack_read_byte(p);
+    unsigned b3 = pack_read_byte(p);
+    return b0 | b1 << 8 | b2 << 16 | b3 << 24;
+}
diff --git a/extern/vgmmm/player.cpp b/extern/vgmmm/player.cpp
new file mode 100644
index 0000000..b33ce51
--- /dev/null
+++ b/extern/vgmmm/player.cpp
@@ -0,0 +1,1063 @@
+// Playback engine (ported from the original player; effect numbering as in the editor):
+//   00 arpeggio        01/02 portamento up/down   03 tone portamento   04 vibrato
+//   05 porta+volslide  06 vibrato+volslide        08/09/0C/0D operator 1-4 level
+//   0A volume slide    0B FM channel 3 special mode                    0E extended
+//   0F speed           15 LFO    17 noise mode    19 panning    1A sample timing    1C play sample
+//
+// Floating-point expressions follow the original x87 code (extended intermediates, float stores).
+#include <cmath>
+#include <cstring>
+
+#include "player.h"
+
+typedef long double ld;
+
+Player g_player;
+RegWrite g_regq[REGQ_MAX];
+int g_regqCount;
+int g_regqRead;
+PsgEnv g_psgEnv[5];
+float g_psgRateTab[32];
+int g_fnumTab[12 * 32];
+int g_psgPeriodTab[8 * 12 * 32];
+int g_vibTab[16 * 32];
+volatile uint8_t g_rendering;
+
+#define P g_player
+
+// ---------------------------------------------------------------- tables
+
+void tables_init(void)
+{
+    static const int fnum[14] = {645, 683, 724, 767, 812, 861, 912, 966, 1024, 1085, 1149, 1217, 1290, 1366};
+    static const float psgFreq[14] = {2093.0f, 2217.46f, 2349.32f, 2489.02f, 2637.02f, 2793.83f, 2959.96f,
+                                      3135.96f, 3322.44f, 3520.0f, 3729.31f, 3951.07f, 4186.01f, 4434.92f};
+    int idx = 0;
+    for (int n = 0; n < 12; n++) {
+        float a = (float)fnum[n];
+        float b = (float)fnum[n + 1];
+        float step = (float)(((ld)b - (ld)a) * (ld)0.03125f);
+        for (int i = 0; i < 32; i++) {
+            g_fnumTab[idx++] = (int)(ld)a;
+            a = (float)((ld)step + (ld)a);
+        }
+    }
+    idx = 0;
+    for (int oct = 0; oct < 8; oct++) {
+        for (int n = 0; n < 12; n++) {
+            float a = (float)((ld)psgFreq[n] * (ld)4.0f);
+            float b = (float)((ld)psgFreq[n + 1] * (ld)4.0f);
+            for (int k = 0; k < 7 - oct; k++) {
+                a = (float)((ld)0.5f * (ld)a);
+                b = (float)((ld)0.5f * (ld)b);
+            }
+            // the period table is always built for the default PSG clock
+            a = (float)((ld)3546894 * (ld)0.0625f * (ld)0.5f / (ld)a);
+            b = (float)((ld)3546894 * (ld)0.0625f * (ld)0.5f / (ld)b);
+            float step = (float)(((ld)b - (ld)a) * (ld)0.03125f);
+            for (int i = 0; i < 32; i++) {
+                int v = (int)(ld)a;
+                if (v < 0)
+                    v = 0;
+                if (v > 0x3ff)
+                    v = 0x3ff;
+                g_psgPeriodTab[idx++] = v;
+                a = (float)((ld)step + (ld)a);
+            }
+        }
+    }
+    idx = 0;
+    for (int depth = 0; depth < 16; depth++) {
+        for (int i = 0; i < 32; i++) {
+            double x = (double)((ld)i * (ld)0.19634954631328583f);
+            float v = (float)(sinl((ld)x) * (ld)(depth * 2));
+            g_vibTab[idx++] = (int)(ld)v;
+        }
+    }
+}
+
+// ---------------------------------------------------------------- register queue
+
+void regq_push(uint8_t type, uint8_t reg, uint8_t val)
+{
+    if (g_regqCount < 0xfffd) {
+        g_regq[g_regqCount].type = type;
+        g_regq[g_regqCount].reg = reg;
+        g_regq[g_regqCount].val = val;
+        g_regqCount++;
+    }
+}
+
+void fm_write(int ch, int reg, int val)
+{
+    if (ch < 3)
+        regq_push(REG_FM0, (uint8_t)(reg + ch), (uint8_t)val);
+    else
+        regq_push(REG_FM1, (uint8_t)(reg + ch - 3), (uint8_t)val);
+}
+
+void fm_key(int ch, int v)
+{
+    static const uint8_t keyCh[8] = {0, 1, 2, 4, 5, 6, 0, 0};
+    regq_push(REG_FM0, 0x28, (uint8_t)((v & 0xf0) | keyCh[ch & 7]));
+}
+
+void fm_set_volume(int ch)
+{
+    static const int volTab[32] = {0, 0, 88, 90, 91, 93, 95, 96, 97, 98, 100, 102, 104, 106, 107, 109,
+                                   110, 112, 113, 114, 115, 116, 118, 119, 120, 121, 122, 123, 124, 125, 126, 127};
+    static const unsigned carrierMask[8] = {8, 8, 8, 8, 12, 14, 14, 15};
+    PlayerChannel *c = &P.ch[ch];
+    if (c->alg < 0)
+        return;
+    int v = volTab[(c->vol >> 3) & 0x1f];
+    unsigned mask = carrierMask[c->alg & 7];
+    int tl[4];
+    for (int i = 0; i < 4; i++) {
+        tl[i] = c->tl[i];
+        if (mask & (1u << i))
+            tl[i] = 0x7f - ((0x7f - tl[i]) * v) / 0x7f;
+    }
+    fm_write(ch, 0x40, tl[0]);
+    fm_write(ch, 0x44, tl[1]);
+    fm_write(ch, 0x48, tl[2]);
+    fm_write(ch, 0x4c, tl[3]);
+}
+
+void psg_queue_volume(unsigned ch, uint8_t vol)
+{
+    if ((int)vol != P.ch[ch].psgVol)
+        regq_push(REG_PSG, 0, (uint8_t)(((ch & 3) << 5) | 0x80 | (vol & 0xf) | 0x10));
+    P.ch[ch].psgVol = vol;
+}
+
+// ---------------------------------------------------------------- PSG envelopes
+
+void psg_env_init(void)
+{
+    memset(g_psgEnv, 0, sizeof(g_psgEnv));
+    for (int i = 0; i < 5; i++) {
+        g_psgEnv[i].state = 3;
+        g_psgEnv[i].level = 0.0f;
+        g_psgEnv[i].lastOut = 0xff;
+    }
+    float v = 1.0f;
+    for (int i = 0; i < 32; i++) {
+        g_psgRateTab[31 - i] = v;
+        v = (float)((ld)v * (ld)0.8f);
+    }
+    g_psgRateTab[0] = 0.0f;
+}
+
+static void psg_env_restart(int k)
+{
+    PsgEnv *e = &g_psgEnv[k];
+    e->state = 0;
+    e->level = e->attack < 1.0f ? 0.0f : 1.0f;
+}
+
+void psg_env_tick(void)
+{
+    for (unsigned k = 0; k < 5; k++) {
+        PsgEnv *e = &g_psgEnv[k];
+        switch (e->state) {
+        case 0:
+            e->level = (float)((ld)e->attack + (ld)e->level);
+            if (1.0f <= e->level) {
+                e->level = 1.0f;
+                e->state = 1;
+            }
+            break;
+        case 1:
+            e->level = (float)((ld)e->level - (ld)e->decay);
+            if (e->level <= e->sustainLevel) {
+                e->level = e->sustainLevel;
+                e->state = 2;
+            }
+            break;
+        case 2:
+            e->level = (float)((ld)e->level - (ld)e->sustain);
+            if (e->level < 0.0f)
+                e->level = 0.0f;
+            break;
+        case 3:
+            e->level = (float)((ld)e->level - (ld)e->release);
+            if (e->level < 0.0f)
+                e->level = 0.0f;
+            break;
+        }
+        int out = (int)((ld)15.0 - (ld)e->level * (ld)e->scale * (ld)15.0);
+        uint8_t b = (uint8_t)out;
+        if (k < 4) {
+            if (out != (int)e->lastOut) {
+                psg_queue_volume(k, b);
+                e->lastOut = b;
+            }
+        } else {
+            for (int c = 0; c < 4; c++)
+                chips_psg2_write((uint8_t)((c << 5) | 0x80 | (b & 0xf) | 0x10));
+        }
+    }
+}
+
+// ---------------------------------------------------------------- DAC (sample channel)
+
+void dac_set_log_mode(uint8_t on)
+{
+    P.dacSample = -1;
+    P.dacLog = on;
+}
+
+// RG (Furnace): o DAC toca pelo Furnace; o tocador só avisa quando começa (amostra) ou para (-1)
+void (*g_rgDacHook)(int sample) = nullptr;
+
+void dac_start(int sample)
+{
+    if (g_rgDacHook)
+        g_rgDacHook(sample);
+    P.dacSample = sample;
+    P.dacPos = 0;
+    if (P.dacLog && sample >= 0) {
+        vgm_put(0x52);
+        vgm_put(0x2b);
+        vgm_put(0x80);
+        vgm_put(0x93);          // VGM 1.60: start stream 0 at offset, play "length" bytes
+        vgm_put(0);
+        vgm_put32((uint32_t)g_vgmSampleOffset[sample % MAX_SAMPLES]);
+        vgm_put(1);
+        vgm_put32((uint32_t)g_vgmSampleLen[sample % MAX_SAMPLES]);
+    }
+}
+
+void dac_stop(void)
+{
+    if (g_rgDacHook)
+        g_rgDacHook(-1);
+    chips_ym_write(0, 0x2b);
+    chips_ym_write(1, 0);
+    P.dacSample = -1;
+    if (P.dacLog) {
+        vgm_put(0x94);          // stop stream 0
+        vgm_put(0);
+        vgm_put(0x52);
+        vgm_put(0x2b);
+        vgm_put(0);
+    }
+}
+
+// Called at the module's sample rate while rendering audio.
+void dac_tick_emul(void)
+{
+    if (P.dacSample < 0 || P.dacSample >= MAX_SAMPLES)
+        return;
+    int idx = g_song.sample[P.dacSample].data;
+    if (idx < 0 || g_sampleData[idx].conv == nullptr)
+        return;
+    if (g_sampleData[idx].convLen <= P.dacPos) {
+        chips_ym_write(0, 0x2b);
+        chips_ym_write(1, 0);
+        P.dacSample = -1;
+        return;
+    }
+    if (P.dacPos == 0) {
+        chips_ym_write(0, 0x2b);
+        chips_ym_write(1, 0x80);
+    }
+    uint8_t v = g_sampleData[idx].conv[P.dacPos++];
+    chips_ym_write(0, 0x2a);
+    chips_ym_write(1, v);
+    if (v == 0x80) {
+        chips_ym_write(0, 0x2b);
+        chips_ym_write(1, 0);
+        P.dacSample = -1;
+    }
+}
+
+// ---------------------------------------------------------------- transport
+
+void player_channels_reset(void)
+{
+    for (int i = 0; i < CHANNELS; i++) {
+        PlayerChannel *c = &P.ch[i];
+        c->ins = -1;
+        c->vol = 0xf8;
+        c->alg = -1;
+        c->pitch = -1;
+        c->portaTarget = -1;
+        c->vibOffset = 0;
+        c->arpOffset = 0;
+        c->arpPhase = 0;
+        c->arpParam = 0xff;
+        c->portaUp = 0;
+        c->portaDown = 0;
+        c->volSlide = 0;
+        c->vibParam = 0;
+        c->reserved = 0;
+        c->vibPhase = 0;
+        c->tonePorta = 0;
+        c->volDirty = 0;
+        c->freqDirty = 0;
+        c->pan = 0xc0;
+        for (int j = 0; j < 4; j++) {
+            c->tl[j] = 0x7f;
+            c->fx[j] = 0;
+        }
+    }
+    P.ch3Special = 0;
+    for (int i = 0; i < 3; i++)
+        P.ch3Offset[i] = 0;
+    P.pendingIns = -1;
+    psg_env_init();
+}
+
+static inline int pan_from_param(uint8_t p)
+{
+    if (p == 0)
+        return 0xc0;
+    return ((p & 0xf0) ? 0x80 : 0) | ((p & 0x0f) ? 0x40 : 0);
+}
+
+static inline void speed_effect(uint8_t p, bool withInterleaveReset)
+{
+    if (p == 0) {
+        P.speedEven = (int)g_song.speedEven;
+        P.speedOdd = (int)g_song.speedOdd;
+        if (withInterleaveReset)
+            P.interleave = (int)g_song.interleave;
+    } else if ((p & 0xf0) == 0) {
+        P.interleave = p & 0xf;
+    } else {
+        P.speedEven = p >> 4;
+        P.speedOdd = p & 0xf;
+        if (P.speedEven == 0)
+            P.speedEven = 1;
+        if ((p & 0xf) == 0)
+            P.speedOdd = 1;
+    }
+}
+
+// Works out instrument, volume and panning of every channel as if the song had been played
+// up to (order, row), by scanning backwards.
+void player_seek_state(int order, int row)
+{
+    char panFound[CHANNELS], volFound[CHANNELS], insFound[CHANNELS];
+    memset(panFound, 0, sizeof(panFound));
+    memset(volFound, 0, sizeof(volFound));
+    memset(insFound, 0, sizeof(insFound));
+    bool first = true;
+    int found = 0;
+    int startRow = row;
+    for (int o = order; o >= 0; o--) {
+        int pat = g_song.order[o].pattern;
+        if (!first)
+            row = g_song.pattern[pat].length - 1;
+        first = false;
+        for (int r = row; r >= 0; r--) {
+            for (int ch = 0; ch < CHANNELS; ch++) {
+                const Cell *cell = &g_song.pattern[pat].cell[r][ch];
+                PlayerChannel *c = &P.ch[ch];
+                if (!insFound[ch] && cell->ins != 0) {
+                    found++;
+                    c->ins = cell->ins;
+                    insFound[ch] = 1;
+                    if (found == 0x1e)
+                        break;
+                }
+                if (!volFound[ch] && cell->volume != 0) {
+                    found++;
+                    c->vol = (int)cell->volume << 3;
+                    volFound[ch] = 1;
+                    if (found == 0x1e)
+                        break;
+                }
+                if (!panFound[ch]) {
+                    for (int f = 0; f < 4; f++) {
+                        if (cell->fx[f] == 0x19) {
+                            found++;
+                            c->pan = pan_from_param(cell->param[f]);
+                            panFound[ch] = 1;
+                            if (found == 0x1e)
+                                break;
+                        }
+                    }
+                }
+            }
+            if (found == 0x1e)
+                break;
+        }
+        if (found == 0x1e)
+            break;
+    }
+    for (int ch = 0; ch < CHANNELS; ch++) {
+        if (!insFound[ch])
+            P.ch[ch].ins = 1;
+        if (!volFound[ch])
+            P.ch[ch].vol = 0xf8;
+    }
+    P.speedEven = g_song.order[order].speedEven;
+    P.speedOdd = g_song.order[order].speedOdd;
+    P.interleave = g_song.order[order].interleave;
+    const Pattern *pat = &g_song.pattern[g_song.order[order].pattern];
+    for (int r = 0; r < startRow; r++) {
+        for (int ch = 0; ch < CHANNELS; ch++)
+            for (int f = 0; f < 4; f++)
+                if (pat->cell[r][ch].fx[f] == 0x0f)
+                    speed_effect(pat->cell[r][ch].param[f], false);
+        P.interleaveCount++;
+        if (P.interleave <= P.interleaveCount) {
+            P.interleaveCount = 0;
+            P.oddFlag ^= 1;
+        }
+    }
+}
+
+static void gg_stereo_update(int ch)
+{
+    int sh = (ch - 6) & 0x1f;
+    uint8_t v = (uint8_t)(P.ggStereo & ~(0x11 << sh));
+    int bits = ((P.ch[ch].pan & 0x80) ? 0x10 : 0) | ((P.ch[ch].pan & 0x40) != 0);
+    P.ggStereo = (uint8_t)(v | (bits << sh));
+}
+
+static void gg_stereo_flush(void)
+{
+    if (g_regqCount < 0xfffd && P.ggStereo != P.ggStereoSent) {
+        P.ggStereoSent = P.ggStereo;
+        regq_push(REG_GG_STEREO, 0, P.ggStereo);
+    }
+}
+
+void player_start(int order, int row, uint8_t singleRow, uint8_t loopPattern, uint8_t autoStop, int solo)
+{
+    if (P.playing)
+        return;
+    memset(&P, 0, sizeof(P));
+    player_channels_reset();
+    P.singleRow = singleRow;
+    P.loopPattern = loopPattern;
+    P.autoStop = autoStop;
+    P.interleaveCount = 0;
+    P.oddFlag = 0;
+    P.solo = solo;
+    P.loopCount = 0x10;
+    P.loopJump = 0;
+    P.loopRow = -1;
+    P.loopOrder = -1;
+    P.ggStereo = 0xff;
+    P.ggStereoSent = 0;
+    P.noiseMode = 0;
+    P.pendingIns = -1;
+    if (P.speedEven < 1)
+        P.speedEven = 1;
+    if (P.speedOdd < 1)
+        P.speedOdd = 1;
+    if (P.interleave < 1)
+        P.interleave = 1;
+    if (g_song.orderLen <= order)
+        order = 0;
+    P.pattern = g_song.order[order].pattern;
+    if (g_song.pattern[P.pattern].length <= row)
+        row = g_song.pattern[P.pattern].length - 1;
+    P.order = order;
+    P.row = row;
+    for (int i = 0; i < CHANNELS; i++) {
+        P.ch[i].reloadIns = 1;
+        P.ch[i].psgPeriod = -1;
+        P.ch[i].psgVol = -1;
+        P.ch[i].ins = -1;
+    }
+    player_seek_state(order, row);
+    psg_env_init();
+    chips_reset();
+    g_regq[0] = {REG_FM0, 0x22, 0};
+    g_regq[1] = {REG_FM0, 0x27, 0};
+    g_regq[2] = {REG_FM0, 0x2b, 0};
+    g_regqCount = 3;
+    g_regqRead = 0;
+    for (unsigned k = 0; k < 4; k++) {
+        if (P.ch[k].psgVol != 0xf)
+            regq_push(REG_PSG, 0, (uint8_t)(((k & 3) << 5) | 0x9f));
+        P.ch[k].psgVol = 0xf;
+        regq_push(REG_PSG, 0, (uint8_t)(((k & 3) << 5) | 0x80));
+        if (((P.ch[k].psgPeriod >> 4) & 0x3f) != 0)
+            regq_push(REG_PSG, 0, 0);
+        P.ch[k].psgPeriod = 0;
+    }
+    for (int ch = 0; ch < CHANNELS; ch++) {
+        if (ch < 6) {
+            const Instrument *ins = ins_ptr(P.ch[ch].ins);
+            fm_write(ch, 0xb4, (uint8_t)(ins->ams << 4 | ins->fms | (uint8_t)P.ch[ch].pan));
+        } else {
+            gg_stereo_update(ch);
+        }
+    }
+    gg_stereo_flush();
+    P.playing = 1;
+}
+
+void player_stop(void)
+{
+    P.playing = 0;
+    // (the original waits here for the audio thread to leave audio_render; callers hold the audio lock)
+    g_regqCount = 0;
+    g_regqRead = 0;
+    psg_env_init();
+    chips_reset();
+}
+
+bool player_auto_stop(void)
+{
+    if (P.autoStop) {
+        player_stop();
+        P.autoStop = 0;
+        return true;
+    }
+    return false;
+}
+
+bool player_is_playing(void)
+{
+    return P.playing != 0;
+}
+
+void player_set_position(int order)
+{
+    if (P.playing && order >= 0 && order < g_song.orderLen) {
+        P.pattern = g_song.order[order].pattern;
+        P.order = order;
+        P.row = 0;
+        P.tick = 0;
+        P.oddFlag = 0;
+        P.interleaveCount = 0;
+    }
+}
+
+void player_refresh_instrument(int ins)
+{
+    P.pendingIns = ins;
+}
+
+// ---------------------------------------------------------------- tick
+
+static void ins_write_mult(int ch, const Instrument *ins, int op, int mult)
+{
+    fm_write(ch, 0x30 + op * 4, (uint8_t)(dt_to_reg(ins->op[op].dt) << 4 | (mult & 0xf)));
+}
+
+static void note_restart(int ch)
+{
+    if (ch < 6) {
+        fm_key(ch, 0);
+        fm_key(ch, 0xf0);
+    } else {
+        psg_env_restart(ch - 6);
+    }
+}
+
+int player_tick(bool exporting)
+{
+    if (!P.playing) {
+        psg_env_tick();
+        return 0;
+    }
+    int looped = 0;
+    if (g_song.loopPos == P.order && P.row == 0 && P.tick == 0) {
+        looped = 1;
+        if (exporting)
+            for (int ch = 0; ch < CHANNELS; ch++)
+                P.ch[ch].reloadIns = 1;
+    }
+    g_regqCount = 0;
+    g_regqRead = 0;
+
+    // an instrument was edited while playing: refresh the channels that use it
+    if (P.pendingIns >= 0) {
+        for (int ch = 0; ch < CHANNELS; ch++) {
+            PlayerChannel *c = &P.ch[ch];
+            if (P.pendingIns + 1 != c->ins)
+                continue;
+            const Instrument *ins = ins_ptr(c->ins);
+            if (ch < 6) {
+                fm_write(ch, 0xb0, (uint8_t)((ins->alg & 7) | (ins->fb & 7) << 3));
+                for (int o = 0; o < 4; o++)
+                    ins_write_mult(ch, ins, o, ins->op[o].mult);
+                for (int o = 0; o < 4; o++)
+                    c->tl[o] = ins->op[o].tl & 0x7f;
+                c->volDirty = 1;
+            } else {
+                c->tl[3] = ins->op[3].tl & 0x7f;
+                c->volDirty = 1;
+            }
+        }
+        P.pendingIns = -1;
+    }
+
+    int dacTrigger = -1;
+    if (P.tick == 0) {
+        P.dacCut = -1;
+        P.dacDelay = -1;
+        P.dacRetrig = -1;
+        for (int ch = 0; ch < CHANNELS; ch++) {
+            const Cell *cell = &g_song.pattern[P.pattern].cell[P.row][ch];
+            PlayerChannel *c = &P.ch[ch];
+            c->cutTick = -1;
+            c->delayTick = -1;
+            c->retrig = -1;
+            bool porta = false, delayed = false, customKey = false;
+
+            // effects that must be known before the note is handled
+            for (int f = 0; f < 4; f++) {
+                uint8_t p = cell->param[f];
+                unsigned hi = p & 0xf0;
+                switch (cell->fx[f]) {
+                case 0x03:
+                    porta = true;
+                    break;
+                case 0x0b:
+                    if (hi == 0) {
+                        if (p == 0) {
+                            if (P.ch3Special) {
+                                P.ch3Special = 0;
+                                regq_push(REG_FM0, 0x27, 0);
+                            }
+                        } else if (!P.ch3Special) {
+                            P.ch3Special = 1;
+                            regq_push(REG_FM0, 0x27, 0x40);
+                        }
+                    } else if (hi == 0x10) {
+                        P.ch3Offset[0] = p & 0xf;
+                    } else if (hi == 0x20) {
+                        P.ch3Offset[1] = p & 0xf;
+                    } else if (hi == 0x30) {
+                        P.ch3Offset[2] = p & 0xf;
+                    }
+                    break;
+                case 0x0e:
+                    if (hi == 0xd0) {
+                        if (p & 0xf) {
+                            c->delayTick = p & 0xf;
+                            delayed = true;
+                        }
+                    } else if (hi == 0x50) {
+                        customKey = true;
+                    } else if (hi == 0x90) {
+                        if (p & 0xf)
+                            c->retrig = p & 0xf;
+                    } else if (hi == 0xc0) {
+                        if (p & 0xf)
+                            c->cutTick = p & 0xf;
+                    } else if (hi == 0xe0) {
+                        c->reloadIns = 1;
+                    }
+                    break;
+                case 0x15:
+                    if (p == 0)
+                        regq_push(REG_FM0, 0x22, 0);
+                    else
+                        regq_push(REG_FM0, 0x22, (uint8_t)((p & 7) | 8));
+                    break;
+                case 0x17:
+                    P.noiseMode = p != 0;
+                    break;
+                case 0x19:
+                    c->pan = pan_from_param(p);
+                    if (ch < 6) {
+                        const Instrument *ins = ins_ptr(c->ins);
+                        fm_write(ch, 0xb4, (uint8_t)(ins->ams << 4 | ins->fms | (uint8_t)c->pan));
+                    } else {
+                        gg_stereo_update(ch);
+                    }
+                    break;
+                case 0x1a:
+                    if (hi == 0x90)
+                        P.dacRetrig = p & 0xf;
+                    else if (hi == 0xc0)
+                        P.dacCut = p & 0xf;
+                    else if (hi == 0xd0)
+                        P.dacDelay = p & 0xf;
+                    break;
+                case 0x1c: {
+                    int s = p;
+                    if (s == 0xff)
+                        s = 0xfe;
+                    dacTrigger = s;
+                    P.dacPending = s;
+                    break;
+                }
+                }
+            }
+
+            if (cell->note != NOTE_EMPTY) {
+                if (cell->note == NOTE_OFF || !porta) {
+                    if (ch < 6)
+                        fm_key(ch, 0);
+                    else
+                        g_psgEnv[ch - 6].state = 3;
+                }
+                if (cell->note != NOTE_OFF) {
+                    if ((cell->ins != 0 && cell->ins != c->ins) || c->reloadIns) {
+                        int n = cell->ins;
+                        if (n == 0 && c->ins > 0)
+                            n = c->ins;
+                        if (n == 0)
+                            n = 1;
+                        c->reloadIns = 0;
+                        c->ins = n;
+                        const Instrument *ins = ins_ptr(n);
+                        if (cell->volume != 0)
+                            c->vol = (int)cell->volume << 3;
+                        c->volDirty = 1;
+                        if (ch < 6) {
+                            for (int o = 0; o < 4; o++)
+                                c->tl[o] = ins->op[o].tl & 0x7f;
+                            c->alg = ins->alg;
+                            fm_write(ch, 0xb0, (uint8_t)((ins->alg & 7) | (ins->fb & 7) << 3));
+                            fm_write(ch, 0xb4, (uint8_t)(ins->ams << 4 | ins->fms | (uint8_t)c->pan));
+                            uint8_t mult[4] = {ins->op[0].mult, ins->op[1].mult, ins->op[2].mult, ins->op[3].mult};
+                            for (int f = 0; f < 4; f++) {
+                                if (cell->fx[f] == 0x0e) {
+                                    uint8_t pp = cell->param[f];
+                                    if ((pp & 0xf0) == 0x00) mult[0] = pp;
+                                    if ((pp & 0xf0) == 0x10) mult[1] = pp;
+                                    if ((pp & 0xf0) == 0x20) mult[2] = pp;
+                                    if ((pp & 0xf0) == 0x30) mult[3] = pp;
+                                }
+                            }
+                            for (int o = 0; o < 4; o++)
+                                ins_write_mult(ch, ins, o, mult[o]);
+                            for (int o = 0; o < 4; o++)
+                                fm_write(ch, 0x50 + o * 4, (uint8_t)((ins->op[o].ar & 0x1f) | ins->op[o].rs << 6));
+                            for (int o = 0; o < 4; o++)
+                                fm_write(ch, 0x60 + o * 4, ins->op[o].dr & 0x9f);
+                            for (int o = 0; o < 4; o++)
+                                fm_write(ch, 0x70 + o * 4, ins->op[o].sr & 0x1f);
+                            for (int o = 0; o < 4; o++)
+                                fm_write(ch, 0x80 + o * 4, (uint8_t)((ins->op[o].rr & 0xf) | ins->op[o].sl << 4));
+                            for (int o = 0; o < 4; o++)
+                                fm_write(ch, 0x90 + o * 4, ins->op[o].ssg & 0xf);
+                        } else {
+                            // PSG channels take their envelope from operator 4 of the instrument
+                            PsgEnv *e = &g_psgEnv[ch - 6];
+                            c->tl[3] = ins->op[3].tl & 0x7f;
+                            e->attack = g_psgRateTab[ins->op[3].ar & 0x1f];
+                            e->decay = g_psgRateTab[ins->op[3].dr & 0x1f];
+                            e->sustain = g_psgRateTab[ins->op[3].sr & 0x1f];
+                            e->release = g_psgRateTab[(ins->op[3].rr & 0xf) * 2];
+                            e->sustainLevel = (float)((ld)(1.0 / 15.0) * (ld)(0xf - (ins->op[3].sl & 0xf)));
+                        }
+                    }
+                    int pitch = ((int)cell->octave * 0xc + (int)cell->note - 0xc) * 0x20;
+                    if (porta) {
+                        c->portaTarget = pitch;
+                    } else {
+                        c->arpPhase = 0;
+                        c->arpParam = 0xff;
+                        c->arpOffset = 0;
+                        c->pitch = pitch;
+                        c->reserved = 0;
+                        c->vibOffset = 0;
+                        c->freqDirty = 1;
+                        if ((P.solo < 0 || ch == P.solo) && !delayed && !customKey) {
+                            if (ch < 6)
+                                fm_key(ch, 0xf0);
+                            else
+                                psg_env_restart(ch - 6);
+                        }
+                    }
+                }
+            }
+            if (cell->volume != 0 && (int)cell->volume * 8 != c->vol) {
+                c->vol = (int)cell->volume << 3;
+                c->volDirty = 1;
+            }
+
+            // remaining effects
+            for (int f = 0; f < 4; f++) {
+                uint8_t p = cell->param[f];
+                unsigned hi = p & 0xf0;
+                const Instrument *ins = ins_ptr(c->ins);
+                c->fx[f] = (int)(int8_t)cell->fx[f];
+                switch (cell->fx[f]) {
+                case 0x00:
+                    if (p != 0)
+                        c->arpParam = p;
+                    c->arpPhase = 0;
+                    break;
+                case 0x01:
+                    if (p != 0)
+                        c->portaUp = p;
+                    break;
+                case 0x02:
+                    if (p != 0)
+                        c->portaDown = p;
+                    break;
+                case 0x03:
+                    if (p != 0)
+                        c->tonePorta = p;
+                    break;
+                case 0x04:
+                    if (p & 0x0f)
+                        c->vibParam = (c->vibParam & 0xf0) | (p & 0x0f);
+                    if (p & 0xf0)
+                        c->vibParam = (c->vibParam & 0x0f) | (p & 0xf0);
+                    break;
+                case 0x05:
+                case 0x06:
+                case 0x0a:
+                    if (p != 0)
+                        c->volSlide = p;
+                    break;
+                case 0x08:
+                case 0x09:
+                case 0x0c:
+                case 0x0d: {
+                    int o = cell->fx[f] == 0x08 ? 0 : cell->fx[f] == 0x09 ? 1 : cell->fx[f] == 0x0c ? 2 : 3;
+                    if (c->tl[o] != (p & 0x7f)) {
+                        c->tl[o] = p & 0x7f;
+                        c->volDirty = 1;
+                    }
+                    break;
+                }
+                case 0x0e:
+                    if (hi <= 0x30) {
+                        if (ch < 6)
+                            ins_write_mult(ch, ins, (int)(hi >> 4), p);
+                    } else if (hi == 0x50) {
+                        if (ch < 6)
+                            fm_key(ch, (p & 0x0f) << 4);
+                    } else if (hi == 0x60) {
+                        if ((p & 0xf) == 0) {
+                            if (P.loopRow != P.row || P.loopOrder != P.order) {
+                                P.loopCount = 0;
+                                P.saveEven = P.speedEven;
+                                P.saveOdd = P.speedOdd;
+                                P.saveInterleave = P.interleave;
+                                P.saveOddFlag = P.oddFlag;
+                                P.saveInterleaveCount = P.interleaveCount;
+                                P.loopRow = P.row;
+                                P.loopOrder = P.order;
+                            }
+                        } else if (P.loopCount < (int)(p & 0xf)) {
+                            P.loopCount++;
+                            if ((int)(p & 0xf) <= P.loopCount)
+                                P.loopCount = 0x10;
+                            P.loopJump = 1;
+                        }
+                    } else if (hi == 0xf0) {
+                        if (ch < 6)
+                            fm_write(ch, 0xb0, (uint8_t)((ins->alg & 7) | (p & 7) << 3));
+                    }
+                    break;
+                case 0x0f:
+                    speed_effect(p, true);
+                    break;
+                }
+            }
+        }
+
+        if (!P.singleRow) {
+            if (!P.loopJump) {
+                P.row++;
+                if (g_song.pattern[P.pattern].length <= P.row) {
+                    P.row = 0;
+                    if (!P.loopPattern) {
+                        P.order++;
+                        if (g_song.orderLen <= P.order)
+                            P.order = g_song.loopPos;
+                        P.pattern = g_song.order[P.order].pattern;
+                    }
+                }
+            } else {
+                P.loopJump = 0;
+                P.speedEven = P.saveEven;
+                P.speedOdd = P.saveOdd;
+                P.interleave = P.saveInterleave;
+                P.oddFlag = P.saveOddFlag;
+                P.interleaveCount = P.saveInterleaveCount;
+                P.row = P.loopRow;
+                P.order = P.loopOrder;
+                P.pattern = g_song.order[P.loopOrder].pattern;
+            }
+        }
+    }
+
+    gg_stereo_flush();
+
+    if (P.dacDelay > 0) {
+        dacTrigger = P.dacPending;
+        if (P.dacDelay != P.tick)
+            dacTrigger = -1;
+    }
+    if (P.dacRetrig > 0 && P.tick % P.dacRetrig == 0)
+        dacTrigger = P.dacPending;
+    if (dacTrigger >= 0)
+        dac_start(dacTrigger);
+    if (P.dacCut > 0 && P.dacCut == P.tick)
+        dac_stop();
+
+    for (int ch = 0; ch < CHANNELS; ch++) {
+        PlayerChannel *c = &P.ch[ch];
+        bool vibrato = false;
+        // NB: everything in this loop runs once per effect column, as in the original
+        for (int f = 0; f < 4; f++) {
+            int fx = c->fx[f];
+            if ((fx == 3 || fx == 5) && c->portaTarget >= 0) {
+                int old = c->pitch;
+                if (c->pitch < c->portaTarget) {
+                    c->pitch += c->tonePorta;
+                    if (c->portaTarget < c->pitch)
+                        c->pitch = c->portaTarget;
+                } else {
+                    c->pitch -= c->tonePorta;
+                    if (c->pitch < c->portaTarget)
+                        c->pitch = c->portaTarget;
+                }
+                if (old != c->pitch)
+                    c->freqDirty = 1;
+            }
+            if (fx == 4 || fx == 6) {
+                vibrato = true;
+                int old = c->vibOffset;
+                c->vibOffset = g_vibTab[(c->vibPhase >> 1) + (c->vibParam & 0xf) * 0x20];
+                c->vibPhase = ((c->vibParam >> 4) + c->vibPhase) & 0x3f;
+                if (old != c->vibOffset)
+                    c->freqDirty = 1;
+            }
+            if (fx == 1) {
+                int old = c->pitch;
+                c->pitch += c->portaUp;
+                if (c->pitch > 0xbff)
+                    c->pitch = 0xbff;
+                if (old != c->pitch)
+                    c->freqDirty = 1;
+            } else if (fx == 2) {
+                int old = c->pitch;
+                c->pitch -= c->portaDown;
+                if (c->pitch < 0)
+                    c->pitch = 0;
+                if (old != c->pitch)
+                    c->freqDirty = 1;
+            } else if (fx == 5 || fx == 6 || fx == 10) {
+                int v = c->volSlide;
+                if ((v & 0x0f) != 0 && c->vol > 0) {
+                    c->vol -= v & 0xf;
+                    if (c->vol < 0)
+                        c->vol = 0;
+                    c->volDirty = 1;
+                }
+                if ((v & 0xf0) != 0 && c->vol < 0xf8) {
+                    c->vol += v >> 4;
+                    if (c->vol > 0xf8)
+                        c->vol = 0xf8;
+                    c->volDirty = 1;
+                }
+            }
+            if (c->arpParam == 0xff) {
+                if (c->arpOffset != 0) {
+                    c->arpOffset = 0;
+                    c->freqDirty = 1;
+                }
+            } else {
+                if (c->arpPhase == 0)
+                    c->arpOffset = 0;
+                else if (c->arpPhase == 1)
+                    c->arpOffset = (c->arpParam & 0xf0) * 2;
+                else if (c->arpPhase == 2)
+                    c->arpOffset = (c->arpParam & 0x0f) << 5;
+                c->arpPhase = (c->arpPhase + 1) % 3;
+                c->freqDirty = 1;
+            }
+            if (c->retrig >= 0 && P.tick % c->retrig == 0)
+                note_restart(ch);
+            if (c->cutTick >= 0 && c->cutTick == P.tick) {
+                if (ch < 6)
+                    fm_key(ch, 0);
+                else
+                    g_psgEnv[ch - 6].state = 3;
+            }
+            if (c->delayTick >= 0 && c->delayTick == P.tick)
+                note_restart(ch);
+        }
+        if (!vibrato && c->vibOffset != 0) {
+            c->vibOffset = 0;
+            c->vibPhase = 0;
+            c->reserved = 0;
+            c->freqDirty = 1;
+        }
+
+        if (c->freqDirty) {
+            c->freqDirty = 0;
+            if (ch < 6) {
+                int mod = c->vibOffset + c->arpOffset;
+                int pitch = c->pitch + mod;
+                if (pitch < 0)
+                    pitch = 0;
+                if (pitch > 0xbff)
+                    pitch = 0xbff;
+                int fn = g_fnumTab[pitch % 0x180];
+                uint8_t hi = (uint8_t)(((fn >> 8) & 7) | ((pitch >> 5) / 0xc) << 3);
+                if (!P.ch3Special || ch != 2) {
+                    fm_write(ch, 0xa4, hi);
+                    fm_write(ch, 0xa0, (uint8_t)fn);
+                } else {
+                    static const uint8_t opReg[3][2] = {{0xac, 0xa8}, {0xae, 0xaa}, {0xad, 0xa9}};
+                    regq_push(REG_FM0, 0xa6, hi);
+                    regq_push(REG_FM0, 0xa2, (uint8_t)fn);
+                    for (int k = 0; k < 3; k++) {
+                        int p2 = P.ch[2].pitch + mod + P.ch3Offset[k] * 0x20;
+                        if (p2 < 0)
+                            p2 = 0;
+                        if (p2 > 0xbff)
+                            p2 = 0xbff;
+                        int fn2 = g_fnumTab[p2 % 0x180];
+                        regq_push(REG_FM0, opReg[k][0], (uint8_t)(((fn2 >> 8) & 7) | ((p2 >> 5) / 0xc) << 3));
+                        regq_push(REG_FM0, opReg[k][1], (uint8_t)fn2);
+                    }
+                }
+            } else if (ch < 9) {
+                int pitch = c->pitch + c->vibOffset + c->arpOffset;
+                if (pitch < 0)
+                    pitch = 0;
+                if (pitch > 0xbff)
+                    pitch = 0xbff;
+                int period = g_psgPeriodTab[pitch] + (int)ins_ptr(c->ins)->op[3].dt;
+                if (period < 0)
+                    period = 0;
+                if (period > 0x3ff)
+                    period = 0x3ff;
+                unsigned k = (unsigned)(ch - 6);
+                regq_push(REG_PSG, 0, (uint8_t)(((k & 3) << 5) | 0x80 | (period & 0xf)));
+                if (((period >> 4) & 0x3f) != ((P.ch[k].psgPeriod >> 4) & 0x3f))
+                    regq_push(REG_PSG, 0, (uint8_t)((period >> 4) & 0x3f));
+                P.ch[k].psgPeriod = period;
+            } else {
+                regq_push(REG_PSG, 0, (uint8_t)((P.noiseMode ? 0 : 4) | 0xe0 | ((c->pitch >> 5) & 3)));
+            }
+        }
+        if (c->volDirty) {
+            c->volDirty = 0;
+            if (ch < 6) {
+                fm_set_volume(ch);
+            } else {
+                g_psgEnv[ch - 6].scale =
+                    (float)((ld)(1.0 / 127.0) * (ld)(0x7f - (0x7f - ((0x7f - c->tl[3]) * (c->vol >> 1)) / 0x7f)));
+            }
+        }
+    }
+    psg_env_tick();
+
+    if (P.singleRow) {
+        P.playing = 0;
+        return 0;
+    }
+    int speed = P.oddFlag ? P.speedOdd : P.speedEven;
+    P.tick = (P.tick + 1) % speed;
+    if (P.tick == 0) {
+        P.interleaveCount++;
+        if (P.interleave <= P.interleaveCount) {
+            P.interleaveCount = 0;
+            P.oddFlag ^= 1;
+        }
+    }
+    return looped;
+}
diff --git a/extern/vgmmm/player.h b/extern/vgmmm/player.h
new file mode 100644
index 0000000..03c7cac
--- /dev/null
+++ b/extern/vgmmm/player.h
@@ -0,0 +1,142 @@
+// Playback engine: turns pattern data into YM2612 / SN76489 register writes, one tick at a time.
+#pragma once
+#include <cstdint>
+
+#include "song.h"
+
+struct PlayerChannel {
+    int ins;                // current instrument (1-based), -1 = unset
+    int vol;                // 0..0xf8 (pattern volume * 8)
+    int tl[4];              // operator total levels before channel volume is applied
+    int alg;
+    int arpPhase;
+    int pitch;              // 1/32 semitone units
+    int portaTarget;
+    int vibOffset;
+    int arpOffset;
+    int reserved;
+    int vibPhase;
+    int fx[4];              // effect types of the current row
+    int arpParam;           // 0xff = off
+    int portaUp;
+    int portaDown;
+    int tonePorta;
+    int vibParam;
+    int volSlide;
+    int cutTick;
+    int delayTick;
+    int retrig;
+    int pan;
+    uint8_t reloadIns;
+    uint8_t volDirty;
+    uint8_t freqDirty;
+    uint8_t pad;
+    int psgPeriod;          // NB: indexed by PSG channel 0..3, stored in the first four entries
+    int psgVol;
+};
+
+struct Player {
+    int speedEven, speedOdd, interleave;
+    int tick, order, pattern, row;
+    int interleaveCount, oddFlag;
+    PlayerChannel ch[CHANNELS];
+    uint8_t ch3Special;     // FM channel 3 per-operator frequency mode
+    int ch3Offset[3];
+    uint8_t singleRow;      // play one row, then stop
+    uint8_t loopPattern;    // stay in the current pattern
+    uint8_t autoStop;
+    int saveEven, saveOdd, saveInterleave, saveOddFlag, saveInterleaveCount, loopRow, loopOrder;
+    int loopCount;
+    uint8_t loopJump;
+    int pendingIns;         // instrument edited in the UI whose registers must be refreshed
+    int solo;               // only key this channel (-1 = all)
+    int dacSample, dacPos;
+    uint8_t dacLog;         // log DAC starts as VGM 1.60 stream commands
+    int dacRetrig, dacCut, dacDelay, dacPending;
+    uint8_t ggStereo, ggStereoSent;
+    uint8_t noiseMode;
+    uint8_t playing;
+};
+
+// Queue of register writes produced by one tick.
+enum { REG_FM0 = 0, REG_FM1 = 1, REG_PSG = 2, REG_GG_STEREO = 3, REGQ_MAX = 0xffff };
+struct RegWrite {
+    uint8_t type, reg, val;
+};
+extern RegWrite g_regq[REGQ_MAX];
+extern int g_regqCount;
+extern int g_regqRead;
+
+// Software ADSR used for the PSG channels (index 4 drives the second PSG for instrument preview).
+struct PsgEnv {
+    int state;              // 0 attack, 1 decay, 2 sustain, 3 release
+    float attack, decay, sustain, release;
+    float scale;
+    float sustainLevel;
+    float level;
+    uint8_t lastOut;
+};
+extern PsgEnv g_psgEnv[5];
+extern float g_psgRateTab[32];
+
+extern Player g_player;
+extern int g_fnumTab[12 * 32];          // FM F-numbers, 32 steps per semitone
+extern int g_psgPeriodTab[8 * 12 * 32]; // PSG tone periods
+extern int g_vibTab[16 * 32];           // vibrato offsets by depth
+extern volatile uint8_t g_rendering;    // set while the audio thread is inside audio_render
+
+void tables_init(void);
+void regq_push(uint8_t type, uint8_t reg, uint8_t val);
+void fm_write(int ch, int reg, int val);
+void fm_key(int ch, int v);
+void fm_set_volume(int ch);
+void psg_queue_volume(unsigned ch, uint8_t vol);
+void psg_env_init(void);
+void psg_env_tick(void);
+
+void player_channels_reset(void);
+void player_seek_state(int order, int row);
+void player_start(int order, int row, uint8_t singleRow, uint8_t loopPattern, uint8_t autoStop, int solo);
+void player_stop(void);
+bool player_auto_stop(void);
+bool player_is_playing(void);
+void player_set_position(int order);
+void player_refresh_instrument(int ins);
+int player_tick(bool exporting);        // returns 1 when the loop position is reached
+
+void dac_set_log_mode(uint8_t on);
+void dac_start(int sample);
+void dac_stop(void);
+void dac_tick_emul(void);
+
+// ---- chips.cpp
+bool chips_init(int fmClock, int psgClock, unsigned rate);
+void chips_shutdown(void);
+void chips_reset(void);
+void chips_set_mute(unsigned mask);
+void chips_render_mode(bool rendering, bool allChannels);
+void chips_set_balance(int fm, int psg);
+void chips_ym_write(int port, uint8_t v);           // main YM2612, a = 0..3
+void chips_psg_write(uint8_t v);                    // main SN76489
+void chips_psg_stereo(uint8_t v);                   // Game Gear stereo register
+void chips_ym2_write(int port, uint8_t v);          // preview YM2612
+void chips_psg2_write(uint8_t v);                   // preview PSG
+void chips_psg2_set_mute(int mask);
+unsigned chips_get_mute(void);
+void chips_flush_queue(int16_t *out, int frames);   // send queued writes to the chips, then render
+void audio_render(int16_t *out, int frames);        // runs the player and renders stereo frames
+float chips_fm_level(int ch);
+float chips_psg_level(int ch);
+const char *chips_about_fm(void);
+const char *chips_about_psg(void);
+extern unsigned g_outputRate;
+extern int g_frameCounter;
+extern uint8_t g_clipped;
+extern uint8_t g_testSignal;
+extern int g_outputVolume, g_fmVolume;
+
+// ---- vgmexport.cpp (the DAC logger writes into the VGM being built)
+void vgm_put(uint8_t b);
+void vgm_put32(uint32_t v);
+extern int g_vgmSampleOffset[MAX_SAMPLES];
+extern int g_vgmSampleLen[MAX_SAMPLES];
diff --git a/extern/vgmmm/rgvge.h b/extern/vgmmm/rgvge.h
new file mode 100644
index 0000000..5a432c1
--- /dev/null
+++ b/extern/vgmmm/rgvge.h
@@ -0,0 +1,88 @@
+// RG: ponte entre o Furnace e o tocador do VGM Music Maker (extern/vgmmm).
+// Nada daqui expõe os tipos do VGMMM: o núcleo fica no namespace rgvgmmm (rgvge_unity.cpp).
+// O módulo do VGMMM é um só (variável global do programa original), então só existe uma música por vez.
+#ifndef _RGVGE_H
+#define _RGVGE_H
+
+#include <vector>
+#include <cstddef>
+
+namespace rgvge {
+  enum {
+    CHANNELS=10,     // FM 1-6, PSG 1-3, ruído
+    MAX_ROWS=256,
+    MAX_PATTERNS=256,
+    MAX_ORDERS=256,
+    MAX_INSTRUMENTS=255,
+    MAX_SAMPLES=255,
+    NOTE_EMPTY=0xff,
+    NOTE_OFF=0xfe
+  };
+
+  struct Write {
+    unsigned char type; // 0/1 = YM2612 parte 0/1, 2 = SN76489, 3 = estéreo do Game Gear
+    unsigned char reg, val;
+  };
+
+  struct Cell {
+    short note;          // 0..11, NOTE_OFF, NOTE_EMPTY
+    signed char octave;
+    signed char volume;  // 0 = nada, 1..31
+    unsigned char fx[4];
+    unsigned char param[4];
+    short ins;           // 0 = nada, senão instrumento+1
+  };
+
+  struct Op {
+    unsigned char mult;
+    signed char dt;      // -3..3
+    unsigned char tl, rs, ar;
+    unsigned char dr;    // bit 7 = AM
+    unsigned char sr, rr, sl, ssg;
+  };
+
+  struct Ins {
+    Op op[4];
+    unsigned char alg, fb, ams, fms;
+    char name[17];
+  };
+
+  struct Header {
+    unsigned int fmClock, psgClock, fps;
+    unsigned int speedEven, speedOdd, interleave;
+    unsigned int sampleRate;
+    int orderLen, loopPos;
+    char name[65], author[65], message[385];
+    unsigned short dateCreated, dateModified, saveCount;
+  };
+
+  // lê um .vge (0 = certo, 2 = formato errado, 3 = sem memória)
+  int load(const unsigned char* buf, size_t len);
+  // música vazia
+  void clear();
+
+  void getHeader(Header& h);
+  void setHeader(const Header& h);
+  int orderPattern(int i);
+  void setOrderPattern(int i, int p);
+  int patternLength(int p);
+  void setPatternLength(int p, int len);
+  void getCell(int p, int row, int ch, Cell& c);
+  void setCell(int p, int row, int ch, const Cell& c);
+  bool insEmpty(int i);
+  void getIns(int i, Ins& ins);
+  void setIns(int i, const Ins& ins);
+  // amostra já convertida (8 bits sem sinal na taxa da música, sem o 0x80 do fim); NULL se vazia
+  const unsigned char* sampleData(int i, int& len);
+  const char* sampleName(int i);
+
+  // tocador: começa na posição; as escritas iniciais saem em out
+  void start(int order, int row, std::vector<Write>& out, std::vector<int>& dac);
+  // um tique: escritas em out, DAC em dac (amostra que começou ou -1 = parou);
+  // order/row = linha que este tique leu (newRow = true quando é o primeiro tique dela).
+  // devolve true quando o tocador passa pelo ponto de volta (laço)
+  bool tick(std::vector<Write>& out, std::vector<int>& dac, int& order, int& row, bool& newRow);
+  bool playing();
+}
+
+#endif
diff --git a/extern/vgmmm/rgvge_unity.cpp b/extern/vgmmm/rgvge_unity.cpp
new file mode 100644
index 0000000..f8513c7
--- /dev/null
+++ b/extern/vgmmm/rgvge_unity.cpp
@@ -0,0 +1,284 @@
+// RG: núcleo do VGM Music Maker (extern/vgmmm) num namespace próprio + a ponte rgvge.h
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <ctime>
+#include <cstdint>
+#include <cstddef>
+#include <vector>
+#include "rgvge.h"
+
+namespace rgvgmmm {
+#include "song.h"
+#include "player.h"
+
+// o tocador chama estas funções do chips.cpp/vgmexport.cpp do programa; aqui as escritas vão para a fila
+static int rgLatch[2]={0,0};
+void chips_reset(void) {}
+void chips_psg2_write(uint8_t) {}
+void chips_ym_write(int port, uint8_t v) {
+  if (port&1) {
+    regq_push((uint8_t)((port>>1)&1),(uint8_t)rgLatch[(port>>1)&1],v);
+  } else {
+    rgLatch[(port>>1)&1]=v;
+  }
+}
+void vgm_put(uint8_t) {}
+void vgm_put32(uint32_t) {}
+int g_vgmSampleOffset[MAX_SAMPLES];
+int g_vgmSampleLen[MAX_SAMPLES];
+
+#include "pack.cpp"
+#include "song.cpp"
+#include "sample.cpp"
+#include "instrument.cpp"
+#include "player.cpp"
+
+// song_load() lendo da memória em vez de um arquivo (mesma lógica)
+static int rgSongLoadMem(const uint8_t* src, long size) {
+  song_new();
+  if (size<16 || (memcmp(src,"VGEfmtV3",8)!=0 && memcmp(src,"VGEfmtV2",8)!=0 && memcmp(src,"VGEfmtV1",8)!=0)) return 2;
+  uint8_t* buf=(uint8_t*)malloc(size);
+  if (buf==nullptr) return 3;
+  memcpy(buf,src,size);
+  int version=buf[7]-'0';
+  int songLen=rd32(buf+8);
+  int smpLen=rd32(buf+12);
+  if (songLen<0 || smpLen<0 || (long)songLen+smpLen+16>size || !song_unpack(buf+16,songLen,version)) {
+    song_new();
+    free(buf);
+    return 2;
+  }
+  Packer pk;
+  pack_init(&pk,buf+16+songLen,smpLen,true);
+  for (int i=0; i<MAX_SAMPLES; i++) {
+    sample_data_free(i);
+    g_sampleData[i].rawLen=(int)pack_read32(&pk);
+    g_sampleData[i].rate=(int)pack_read16(&pk);
+    g_sampleData[i].bits=pack_read_byte(&pk);
+  }
+  long off=16L+songLen+smpLen;
+  for (int i=0; i<MAX_SAMPLES; i++) {
+    SampleData* d=&g_sampleData[i];
+    if (d->rawLen!=0) {
+      if (d->rawLen<0 || off+d->rawLen>size) {
+        d->rawLen=0;
+        continue;
+      }
+      d->raw=(uint8_t*)malloc(d->rawLen);
+      memcpy(d->raw,buf+off,d->rawLen);
+      off+=d->rawLen;
+    }
+  }
+  free(buf);
+  samples_convert_all();
+  return 0;
+}
+
+static std::vector<int>* rgDacOut=nullptr;
+static void rgDacEvent(int s) {
+  if (rgDacOut) rgDacOut->push_back(s);
+}
+static bool rgInit=false;
+static void rgEnsureInit() {
+  if (rgInit) return;
+  rgInit=true;
+  tables_init();
+  sample_data_init();
+  psg_env_init();
+  g_rgDacHook=rgDacEvent;
+}
+static void rgFlush(std::vector<rgvge::Write>& out) {
+  for (int i=0; i<g_regqCount; i++) {
+    rgvge::Write w;
+    w.type=g_regq[i].type;
+    w.reg=g_regq[i].reg;
+    w.val=g_regq[i].val;
+    out.push_back(w);
+  }
+  g_regqCount=0;
+  g_regqRead=0;
+}
+}
+
+using namespace rgvgmmm;
+
+namespace rgvge {
+
+int load(const unsigned char* buf, size_t len) {
+  rgEnsureInit();
+  if (P.playing) player_stop();
+  return rgSongLoadMem(buf,(long)len);
+}
+
+void clear() {
+  rgEnsureInit();
+  if (P.playing) player_stop();
+  song_new();
+}
+
+static void cpyStr(char* dst, const char* src, int n) {
+  memcpy(dst,src,n);
+  dst[n]=0;
+}
+
+void getHeader(Header& h) {
+  h.fmClock=g_song.fmClock;
+  h.psgClock=g_song.psgClock;
+  h.fps=g_song.fps;
+  h.speedEven=g_song.speedEven;
+  h.speedOdd=g_song.speedOdd;
+  h.interleave=g_song.interleave;
+  h.sampleRate=g_song.sampleRate;
+  h.orderLen=g_song.orderLen;
+  h.loopPos=g_song.loopPos;
+  cpyStr(h.name,g_song.name,0x40);
+  cpyStr(h.author,g_song.author,0x40);
+  cpyStr(h.message,g_song.message,0x180);
+  h.dateCreated=g_song.dateCreated;
+  h.dateModified=g_song.dateModified;
+  h.saveCount=g_song.saveCount;
+}
+
+void setHeader(const Header& h) {
+  g_song.fmClock=h.fmClock;
+  g_song.psgClock=h.psgClock;
+  g_song.fps=h.fps;
+  g_song.speedEven=h.speedEven;
+  g_song.speedOdd=h.speedOdd;
+  g_song.interleave=h.interleave;
+  g_song.sampleRate=h.sampleRate;
+  g_song.orderLen=(uint16_t)h.orderLen;
+  g_song.loopPos=(uint16_t)h.loopPos;
+  memcpy(g_song.name,h.name,0x40);
+  memcpy(g_song.author,h.author,0x40);
+  memcpy(g_song.message,h.message,0x180);
+  g_song.dateCreated=h.dateCreated;
+  g_song.dateModified=h.dateModified;
+  g_song.saveCount=h.saveCount;
+}
+
+int orderPattern(int i) {
+  return g_song.order[i&255].pattern;
+}
+void setOrderPattern(int i, int p) {
+  g_song.order[i&255].pattern=(uint8_t)p;
+}
+int patternLength(int p) {
+  return g_song.pattern[p&255].length;
+}
+void setPatternLength(int p, int len) {
+  g_song.pattern[p&255].length=len;
+}
+
+void getCell(int p, int row, int ch, Cell& c) {
+  const rgvgmmm::Cell& s=g_song.pattern[p&255].cell[row&255][ch%CHANNELS];
+  c.note=s.note;
+  c.octave=s.octave;
+  c.volume=s.volume;
+  for (int i=0; i<4; i++) {
+    c.fx[i]=s.fx[i];
+    c.param[i]=s.param[i];
+  }
+  c.ins=s.ins;
+}
+void setCell(int p, int row, int ch, const Cell& c) {
+  rgvgmmm::Cell& s=g_song.pattern[p&255].cell[row&255][ch%CHANNELS];
+  s.note=c.note;
+  s.octave=c.octave;
+  s.volume=c.volume;
+  for (int i=0; i<4; i++) {
+    s.fx[i]=c.fx[i];
+    s.param[i]=c.param[i];
+  }
+  s.ins=c.ins;
+}
+
+bool insEmpty(int i) {
+  return ins_is_empty(&g_song.ins[i%MAX_INSTRUMENTS]);
+}
+void getIns(int i, Ins& ins) {
+  const Instrument& s=g_song.ins[i%MAX_INSTRUMENTS];
+  for (int j=0; j<4; j++) {
+    ins.op[j].mult=s.op[j].mult;
+    ins.op[j].dt=s.op[j].dt;
+    ins.op[j].tl=s.op[j].tl;
+    ins.op[j].rs=s.op[j].rs;
+    ins.op[j].ar=s.op[j].ar;
+    ins.op[j].dr=s.op[j].dr;
+    ins.op[j].sr=s.op[j].sr;
+    ins.op[j].rr=s.op[j].rr;
+    ins.op[j].sl=s.op[j].sl;
+    ins.op[j].ssg=s.op[j].ssg;
+  }
+  ins.alg=s.alg;
+  ins.fb=s.fb;
+  ins.ams=s.ams;
+  ins.fms=s.fms;
+  cpyStr(ins.name,s.name,16);
+}
+void setIns(int i, const Ins& ins) {
+  Instrument& s=g_song.ins[i%MAX_INSTRUMENTS];
+  for (int j=0; j<4; j++) {
+    s.op[j].mult=ins.op[j].mult;
+    s.op[j].dt=ins.op[j].dt;
+    s.op[j].tl=ins.op[j].tl;
+    s.op[j].rs=ins.op[j].rs;
+    s.op[j].ar=ins.op[j].ar;
+    s.op[j].dr=ins.op[j].dr;
+    s.op[j].sr=ins.op[j].sr;
+    s.op[j].rr=ins.op[j].rr;
+    s.op[j].sl=ins.op[j].sl;
+    s.op[j].ssg=ins.op[j].ssg;
+  }
+  s.alg=ins.alg;
+  s.fb=ins.fb;
+  s.ams=ins.ams;
+  s.fms=ins.fms;
+  memcpy(s.name,ins.name,16);
+  s.name[16]=0;
+}
+
+const unsigned char* sampleData(int i, int& len) {
+  len=0;
+  int idx=g_song.sample[i%MAX_SAMPLES].data;
+  if (idx<0 || idx>=MAX_SAMPLES) return NULL;
+  SampleData* d=&g_sampleData[idx];
+  if (d->conv==nullptr) return NULL;
+  // o tocador para no primeiro 0x80 (fim da amostra)
+  int n=0;
+  while (n<d->convLen && d->conv[n]!=0x80) n++;
+  len=n;
+  return d->conv;
+}
+const char* sampleName(int i) {
+  return g_song.sample[i%MAX_SAMPLES].name;
+}
+
+void start(int order, int row, std::vector<Write>& out, std::vector<int>& dac) {
+  rgEnsureInit();
+  if (P.playing) player_stop();
+  song_calc_timing();
+  rgDacOut=&dac;
+  player_start(order,row,0,0,0,-1);
+  rgFlush(out);
+  rgDacOut=nullptr;
+}
+
+bool tick(std::vector<Write>& out, std::vector<int>& dac, int& order, int& row, bool& newRow) {
+  newRow=(P.tick==0);
+  order=P.order;
+  row=P.row;
+  rgDacOut=&dac;
+  int looped=player_tick(false);
+  rgFlush(out);
+  rgDacOut=nullptr;
+  return looped!=0;
+}
+
+bool playing() {
+  return P.playing!=0;
+}
+
+}
diff --git a/extern/vgmmm/sample.cpp b/extern/vgmmm/sample.cpp
new file mode 100644
index 0000000..43fa6ba
--- /dev/null
+++ b/extern/vgmmm/sample.cpp
@@ -0,0 +1,295 @@
+// PCM samples: WAV import and conversion to the 8-bit stream the YM2612 DAC plays.
+//
+// The floating-point code mirrors the original x87 arithmetic (extended-precision
+// intermediates, results rounded when stored to float) so converted data is bit-identical.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "song.h"
+
+typedef long double ld;
+
+void sample_data_init(void)
+{
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        g_sampleData[i].raw = nullptr;
+        g_sampleData[i].conv = nullptr;
+    }
+}
+
+void sample_data_free(int idx)
+{
+    SampleData *d = &g_sampleData[idx];
+    if (d->raw != nullptr) {
+        free(d->raw);
+        d->raw = nullptr;
+    }
+    if (d->conv != nullptr) {
+        free(d->conv);
+        d->conv = nullptr;
+    }
+}
+
+// Frees sample data no sample slot refers to any more.
+void sample_data_gc(void)
+{
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        bool unused = true;
+        for (int j = 0; j < MAX_SAMPLES; j++) {
+            if (g_song.sample[j].data == i) {
+                unused = false;
+                break;
+            }
+        }
+        if (unused)
+            sample_data_free(i);
+    }
+}
+
+int sample_data_find_free(void)
+{
+    for (int i = 0; i < MAX_SAMPLES; i++)
+        if (g_sampleData[i].raw == nullptr)
+            return i;
+    return -1;
+}
+
+void sample_clear(Sample *s)
+{
+    memset(s, 0, sizeof(Sample));
+    memcpy(s->name, "empty", 6);
+    s->volume = 0x80;
+    s->data = -1;
+    sample_data_gc();
+}
+
+bool sample_is_empty(const Sample *s)
+{
+    if (s->data < 0)
+        return true;
+    return g_sampleData[s->data].raw == nullptr;
+}
+
+void samples_clear_all(void)
+{
+    for (int i = 0; i < MAX_SAMPLES; i++)
+        sample_clear(&g_song.sample[i]);
+}
+
+static inline uint8_t dac_byte(ld v)
+{
+    int o = (int)v + 0x80;
+    if (o < 0)
+        o = 0;
+    if (o > 0xff)
+        o = 0xff;
+    if (o == 0x80)          // 0x80 is the end-of-sample marker
+        o = 0x81;
+    return (uint8_t)o;
+}
+
+void sample_convert(Sample *s)
+{
+    int idx = s->data;
+    if (idx < 0)
+        return;
+    SampleData *d = &g_sampleData[idx];
+    if (d->raw == nullptr)
+        return;
+    if (d->conv != nullptr) {
+        free(d->conv);
+        d->conv = nullptr;
+    }
+    int srcLen = d->rawLen;
+    if (d->bits == 0x10)
+        srcLen /= 2;
+    const ld k255 = (ld)(1.0 / 255.0);
+    ld r;
+    if (s->tune < 0)
+        r = (ld)d->rate / ((ld)2.0 - k255 * ((ld)s->tune + (ld)255.0));
+    else
+        r = (k255 * (ld)s->tune + (ld)1.0) * (ld)d->rate;
+    float rate = (float)r;
+    int dstLen;
+    if ((ld)(int)g_song.sampleRate == (ld)rate)
+        dstLen = srcLen;
+    else
+        dstLen = (int)((ld)(int)g_song.sampleRate * ((ld)srcLen / (ld)rate));
+    if (dstLen < 0)
+        dstLen = 0;
+    uint8_t *dst = (uint8_t *)malloc((size_t)dstLen + 1);
+    memset(dst, 0, (size_t)dstLen + 1);
+    int count = 0;
+    float vol = (float)((ld)s->volume * (ld)0.0078125);
+    const uint8_t *raw = d->raw;
+    float a = 0.0f, b = 0.0f;
+    if ((int)(ld)rate == (int)g_song.sampleRate) {
+        const uint8_t *p8 = raw;
+        const uint8_t *p16 = raw;
+        for (int i = 0; i < srcLen; i++) {
+            if (d->bits == 8) {
+                a = (float)(((ld)*p8 - (ld)128.0) * (ld)0.00390625);
+                p16 += 2;
+                p8 += 1;
+            } else if (d->bits == 0x10) {
+                a = (float)((ld)(int16_t)rd16(p16) * (ld)1.52587890625e-05);
+                p16 += 2;
+                p8 += 1;
+            }
+            dst[count++] = dac_byte((ld)a * (ld)vol * (ld)255.0);
+        }
+    } else {
+        float outRate = (float)(int)g_song.sampleRate;
+        float pos = 0.0f;
+        for (int i = 0; i < dstLen; i++) {
+            int ip = (int)(ld)pos;
+            if (d->rawLen - 1 <= ip) {
+                ip = d->rawLen - 2;
+                pos = (float)ip;
+            }
+            if (ip < 0)
+                ip = 0;
+            if (d->bits == 8) {
+                a = (float)(((ld)raw[ip] - (ld)128.0) * (ld)0.00390625);
+                b = (float)(((ld)raw[ip + 1] - (ld)128.0) * (ld)0.00390625);
+            } else if (d->bits == 0x10) {
+                // The original clamps 16-bit positions with the byte length, so the interpolation
+                // partner of the last sample lies past the buffer; treat that as silence.
+                int o = ip * 2;
+                a = o + 1 < d->rawLen ? (float)((ld)(int16_t)rd16(raw + o) * (ld)1.52587890625e-05) : 0.0f;
+                b = o + 3 < d->rawLen ? (float)((ld)(int16_t)rd16(raw + o + 2) * (ld)1.52587890625e-05) : 0.0f;
+            }
+            ip = (int)(ld)pos;
+            a = (float)(((ld)b - (ld)a) * ((ld)pos - (ld)ip) + (ld)a);
+            pos = (float)((ld)rate / (ld)outRate + (ld)pos);
+            dst[count++] = dac_byte((ld)a * (ld)vol * (ld)255.0);
+        }
+    }
+    dst[count] = 0x80;
+    d->conv = dst;
+    d->convLen = count + 1;
+}
+
+void samples_convert_all(void)
+{
+    for (int i = 0; i < MAX_SAMPLES; i++)
+        sample_convert(&g_song.sample[i]);
+}
+
+static int find_tag(const uint8_t *buf, int from, int size, const char *tag, int len)
+{
+    for (int i = from; i < size - 4; i++)
+        if (i + len <= size && memcmp(buf + i, tag, len) == 0)
+            return i;
+    return -1;
+}
+
+bool sample_load_wav(Sample *s, const char *filename, char *error)
+{
+    int slot = sample_data_find_free();
+    if (slot < 0)
+        return false;
+    FILE *f = fopen(filename, "rb");
+    if (f == nullptr)
+        return false;
+    fseek(f, 0, SEEK_END);
+    int size = (int)ftell(f);
+    if (size >= 0x100000) {
+        strcpy(error, "File is too big.");
+        fclose(f);
+        return false;
+    }
+    fseek(f, 0, SEEK_SET);
+    uint8_t *buf = (uint8_t *)malloc(size > 0 ? size : 1);
+    if (buf == nullptr) {
+        fclose(f);
+        return false;
+    }
+    if (fread(buf, 1, size, f) != (size_t)size)
+        size = 0;
+    fclose(f);
+
+    int pos = find_tag(buf, 0, size, "RIFF", 4);
+    if (pos < 0) {
+        strcpy(error, "RIFF chunk is not found.");
+        free(buf);
+        return false;
+    }
+    pos = find_tag(buf, pos, size, "WAVEfmt ", 8);
+    if (pos < 0 || pos + 0x1c > size) {
+        strcpy(error, "WAVEfmt chunk is not found.");
+        free(buf);
+        return false;
+    }
+    if (rd16(buf + pos + 0xc) != 1) {
+        strcpy(error, "Only unpacked PCM is supported.");
+        free(buf);
+        return false;
+    }
+    if (rd16(buf + pos + 0xe) != 1) {
+        strcpy(error, "Only mono files are supported.");
+        free(buf);
+        return false;
+    }
+    int rate = rd32(buf + pos + 0x10);
+    int bits = rd16(buf + pos + 0x1a);
+    if (bits != 8 && bits != 0x10) {
+        strcpy(error, "Only 8/16bit PCM are supported.");
+        free(buf);
+        return false;
+    }
+    pos = find_tag(buf, pos + 0x1c, size, "data", 4);
+    if (pos < 0 || pos + 8 > size) {
+        strcpy(error, "DATA chunk is not found.");
+        free(buf);
+        return false;
+    }
+    int len = rd32(buf + pos + 4);
+    if (len < 0 || len > size - (pos + 8))      // a lying header must not overrun the file
+        len = size - (pos + 8);
+    SampleData *d = &g_sampleData[slot];
+    s->data = slot;
+    s->volume = 0x80;
+    s->tune = 0;
+    d->rawLen = len;
+    d->bits = bits;
+    d->rate = rate;
+    d->raw = (uint8_t *)malloc(len > 0 ? len : 1);
+    memcpy(d->raw, buf + pos + 8, len);
+    free(buf);
+    sample_convert(s);
+    return true;
+}
+
+bool sample_copy(const Sample *src, Sample *dst)
+{
+    if (src->data < 0)
+        return false;
+    int slot = sample_data_find_free();
+    if (slot < 0)
+        return false;
+    dst->data = slot;
+    dst->volume = src->volume;
+    memcpy(dst->name, src->name, 0x11);
+    SampleData *from = &g_sampleData[src->data];
+    SampleData *to = &g_sampleData[slot];
+    to->rawLen = from->rawLen;
+    to->rate = from->rate;
+    to->bits = from->bits;
+    to->raw = (uint8_t *)malloc(to->rawLen > 0 ? to->rawLen : 1);
+    memcpy(to->raw, from->raw, from->rawLen);
+    sample_convert(dst);
+    return true;
+}
+
+int samples_total_size(void)
+{
+    int total = 0;
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        int idx = g_song.sample[i].data;
+        if (idx >= 0 && g_sampleData[idx].raw != nullptr && g_sampleData[idx].conv != nullptr)
+            total += g_sampleData[idx].convLen + 2;
+    }
+    return total;
+}
diff --git a/extern/vgmmm/song.cpp b/extern/vgmmm/song.cpp
new file mode 100644
index 0000000..97a2423
--- /dev/null
+++ b/extern/vgmmm/song.cpp
@@ -0,0 +1,710 @@
+// Module data: creation, .vge load/save, order list and pattern housekeeping.
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+
+#include "player.h"
+#include "song.h"
+
+Song g_song;
+SampleData g_sampleData[MAX_SAMPLES];
+bool g_defaultInstrument = true;
+
+static uint16_t date_now_system(void)
+{
+    time_t t = time(nullptr);
+    struct tm tmv;
+#ifdef _WIN32
+    localtime_s(&tmv, &t);
+#else
+    localtime_r(&t, &tmv);
+#endif
+    return (uint16_t)(((tmv.tm_year + 1900) % 100) | (tmv.tm_mday & 0x1f) << 11 | (tmv.tm_mon & 0xf) << 7);
+}
+
+uint16_t (*g_dateNow)(void) = date_now_system;
+
+uint16_t date_now(void)
+{
+    return g_dateNow();
+}
+
+void date_to_str(char *dst, unsigned date)
+{
+    if (date == 0) {
+        strcpy(dst, "--.--.--");
+        return;
+    }
+    unsigned month = ((date >> 7) & 0xf) + 1;
+    unsigned day = date >> 11;
+    unsigned year = date & 0x7f;
+    sprintf(dst, "%u%u.%u%u.%u%u", day / 10, day % 10, month / 10, month % 10, year / 10, year % 10);
+}
+
+void pattern_clear(int pat)
+{
+    Pattern *p = &g_song.pattern[pat];
+    memset(p, 0, sizeof(Pattern));
+    p->length = 0x40;
+    for (int row = 0; row < MAX_ROWS; row++)
+        for (int ch = 0; ch < CHANNELS; ch++)
+            p->cell[row][ch].note = NOTE_EMPTY;
+}
+
+static void song_header_defaults(void)
+{
+    g_song.fps = 50;
+    g_song.fmClock = 7600489;
+    g_song.psgClock = 3546894;
+    g_song.speedEven = 3;
+    g_song.speedOdd = 3;
+    g_song.interleave = 1;
+    g_song.sampleRate = 11025;
+    g_song.saveCount = 0;
+    g_song.dateCreated = date_now();
+    g_song.dateModified = 0;
+    g_song.orderLen = 1;
+    for (int i = 0; i < MAX_PATTERNS; i++)
+        pattern_clear(i);
+}
+
+void song_new(void)
+{
+    memset(&g_song, 0, sizeof(Song));
+    song_header_defaults();
+    for (int i = 0; i < MAX_INSTRUMENTS; i++)
+        ins_clear(&g_song.ins[i]);
+    for (int i = 0; i < MAX_SAMPLES; i++)
+        sample_clear(&g_song.sample[i]);
+    player_channels_reset();
+    if (g_defaultInstrument) {
+        ins_from_vgi(&g_song.ins[0], g_defaultInsVgi);
+        memcpy(g_song.ins[0].name, "default", 8);
+    }
+}
+
+void song_clear(void)
+{
+    memset(&g_song.fmClock, 0, sizeof(Song) - offsetof(Song, fmClock));
+    song_header_defaults();
+    player_channels_reset();
+}
+
+// ---------------------------------------------------------------- .vge
+
+uint8_t *song_pack(int *outLen)
+{
+    Packer pk;
+    if (g_song.saveCount != 0xffff)
+        g_song.saveCount++;
+    g_song.dateModified = date_now();
+    if (pack_init(&pk, nullptr, 0, true) == nullptr)
+        return nullptr;
+    pack_write32(&pk, g_song.fmClock);
+    pack_write32(&pk, g_song.psgClock);
+    pack_write16(&pk, g_song.fps);
+    pack_write_byte(&pk, g_song.speedEven);
+    pack_write_byte(&pk, g_song.speedOdd);
+    pack_write_byte(&pk, g_song.interleave);
+    pack_write16(&pk, g_song.sampleRate);
+    pack_write16(&pk, g_song.dateCreated);
+    pack_write16(&pk, g_song.dateModified);
+    pack_write16(&pk, g_song.saveCount);
+    pack_write_byte(&pk, g_song.orderLen);
+    pack_write_byte(&pk, g_song.loopPos);
+    pack_write_str(&pk, g_song.author, 0x40);
+    pack_write_str(&pk, g_song.name, 0x40);
+    pack_write_str(&pk, g_song.message, 0x180);
+    for (int i = 0; i < MAX_ORDERS; i++)
+        pack_write_byte(&pk, g_song.order[i].pattern);
+    for (int i = 0; i < MAX_INSTRUMENTS; i++) {
+        if (!ins_is_empty(&g_song.ins[i])) {
+            pack_write_str(&pk, g_song.ins[i].name, 0x10);
+        } else {
+            for (int j = 0; j < 0x10; j++)
+                pack_write_byte(&pk, 0xff);
+        }
+    }
+    for (int i = 0; i < MAX_INSTRUMENTS; i++) {
+        const Instrument *ins = &g_song.ins[i];
+        pack_write_byte(&pk, ins->alg);
+        pack_write_byte(&pk, ins->fb);
+        pack_write_byte(&pk, (unsigned)ins->ams << 4 | ins->fms);
+        for (int o = 0; o < 4; o++) {
+            const Operator *op = &ins->op[o];
+            pack_write_byte(&pk, op->mult);
+            pack_write_byte(&pk, (uint8_t)op->dt);
+            pack_write_byte(&pk, op->tl ^ 0x7f);
+            pack_write_byte(&pk, op->rs);
+            pack_write_byte(&pk, op->ar ^ 0x1f);
+            pack_write_byte(&pk, op->dr ^ 0x1f);
+            pack_write_byte(&pk, op->sr ^ 0x1f);
+            pack_write_byte(&pk, op->rr ^ 0xf);
+            pack_write_byte(&pk, op->sl);
+            pack_write_byte(&pk, op->ssg);
+        }
+    }
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        if (!sample_is_empty(&g_song.sample[i])) {
+            pack_write_str(&pk, g_song.sample[i].name, 0x10);
+        } else {
+            for (int j = 0; j < 0x10; j++)
+                pack_write_byte(&pk, 0xff);
+        }
+    }
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        const Sample *s = &g_song.sample[i];
+        if (s->data < 0) {
+            pack_write_byte(&pk, 0xff);
+            pack_write_byte(&pk, 0xff);
+            pack_write16(&pk, 0xffff);
+        } else {
+            pack_write_byte(&pk, s->data);
+            pack_write_byte(&pk, s->volume);
+            pack_write16(&pk, (unsigned)s->tune);
+        }
+    }
+    for (int i = 0; i < MAX_PATTERNS; i++)
+        pack_write_byte(&pk, g_song.pattern[i].length);
+    for (int i = 0; i < MAX_PATTERNS; i++) {
+        const Pattern *pat = &g_song.pattern[i];
+        for (int ch = 0; ch < CHANNELS; ch++) {
+            for (int row = 0; row < MAX_ROWS; row++) {
+                const Cell *c = &pat->cell[row][ch];
+                unsigned n = (unsigned)(int)c->note;
+                if ((int)n < 0xc)
+                    n += c->octave * 0xc;
+                pack_write_byte(&pk, n ^ 0xff);
+            }
+            for (int row = 0; row < MAX_ROWS; row++)
+                pack_write_byte(&pk, (unsigned)(int)pat->cell[row][ch].volume);
+            for (int row = 0; row < MAX_ROWS; row++)
+                pack_write_byte(&pk, (unsigned)(int)pat->cell[row][ch].ins);
+            for (int f = 0; f < 4; f++) {
+                for (int row = 0; row < MAX_ROWS; row++)
+                    pack_write_byte(&pk, pat->cell[row][ch].fx[f]);
+                for (int row = 0; row < MAX_ROWS; row++)
+                    pack_write_byte(&pk, pat->cell[row][ch].param[f]);
+            }
+        }
+    }
+    pack_flush(&pk);
+    *outLen = pk.pos;
+    return pk.buf;
+}
+
+bool song_unpack(uint8_t *buf, int len, int version)
+{
+    Packer pk;
+    pack_init(&pk, buf, len, true);
+    if (version < 3) {
+        g_song.fmClock = 7600489;
+        g_song.psgClock = 3546894;
+        g_song.fps = 50;
+    } else {
+        g_song.fmClock = pack_read32(&pk);
+        g_song.psgClock = pack_read32(&pk);
+        g_song.fps = pack_read16(&pk);
+    }
+    g_song.speedEven = pack_read_byte(&pk);
+    g_song.speedOdd = pack_read_byte(&pk);
+    g_song.interleave = pack_read_byte(&pk);
+    g_song.sampleRate = pack_read16(&pk);
+    g_song.dateCreated = pack_read16(&pk);
+    g_song.dateModified = pack_read16(&pk);
+    g_song.saveCount = pack_read16(&pk);
+    g_song.orderLen = pack_read_byte(&pk);
+    if (g_song.orderLen == 0)
+        g_song.orderLen = 0x100;
+    g_song.loopPos = pack_read_byte(&pk);
+    pack_read_bytes(&pk, g_song.author, 0x40);
+    pack_read_bytes(&pk, g_song.name, 0x40);
+    pack_read_bytes(&pk, g_song.message, 0x180);
+    for (int i = 0; i < MAX_ORDERS; i++)
+        g_song.order[i].pattern = pack_read_byte(&pk);
+    for (int i = 0; i < MAX_INSTRUMENTS; i++) {
+        char *name = g_song.ins[i].name;
+        pack_read_bytes(&pk, name, 0x10);
+        if ((uint8_t)name[0] == 0xff) {
+            memset(name, 0, 0x10);
+            memcpy(name, "empty", 6);
+        }
+    }
+    for (int i = 0; i < MAX_INSTRUMENTS; i++) {
+        Instrument *ins = &g_song.ins[i];
+        ins->alg = pack_read_byte(&pk);
+        ins->fb = pack_read_byte(&pk);
+        uint8_t b = pack_read_byte(&pk);
+        ins->ams = (b >> 4) & 3;
+        ins->fms = b & 7;
+        for (int o = 0; o < 4; o++) {
+            Operator *op = &ins->op[o];
+            op->mult = pack_read_byte(&pk);
+            op->dt = (int8_t)pack_read_byte(&pk);
+            op->tl = pack_read_byte(&pk) ^ 0x7f;
+            op->rs = pack_read_byte(&pk);
+            op->ar = pack_read_byte(&pk) ^ 0x1f;
+            op->dr = pack_read_byte(&pk) ^ 0x1f;
+            op->sr = pack_read_byte(&pk) ^ 0x1f;
+            op->rr = pack_read_byte(&pk) ^ 0xf;
+            op->sl = pack_read_byte(&pk);
+            op->ssg = pack_read_byte(&pk);
+        }
+    }
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        char *name = g_song.sample[i].name;
+        pack_read_bytes(&pk, name, 0x10);
+        if ((uint8_t)name[0] == 0xff) {
+            memset(name, 0, 0x10);
+            memcpy(name, "empty", 6);
+        }
+    }
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        Sample *s = &g_song.sample[i];
+        unsigned d = pack_read_byte(&pk);
+        s->data = (int)d;
+        if (d == 0xff)
+            s->data = -1;
+        s->volume = pack_read_byte(&pk);
+        if (version < 2)
+            s->tune = 0;
+        else
+            s->tune = (int16_t)pack_read16(&pk);
+    }
+    for (int i = 0; i < MAX_PATTERNS; i++) {
+        unsigned l = pack_read_byte(&pk);
+        g_song.pattern[i].length = (int)l;
+        if (l == 0)
+            g_song.pattern[i].length = 0x100;
+    }
+    for (int i = 0; i < MAX_PATTERNS; i++) {
+        Pattern *pat = &g_song.pattern[i];
+        for (int ch = 0; ch < CHANNELS; ch++) {
+            for (int row = 0; row < MAX_ROWS; row++) {
+                Cell *c = &pat->cell[row][ch];
+                unsigned n = pack_read_byte(&pk) ^ 0xff;
+                if (n < 0x80) {
+                    c->note = (int16_t)(n % 0xc);
+                    c->octave = (int8_t)(n / 0xc);
+                } else {
+                    c->note = (int16_t)n;
+                    c->octave = 0;
+                }
+            }
+            for (int row = 0; row < MAX_ROWS; row++)
+                pat->cell[row][ch].volume = (int8_t)pack_read_byte(&pk);
+            for (int row = 0; row < MAX_ROWS; row++)
+                pat->cell[row][ch].ins = pack_read_byte(&pk);
+            for (int f = 0; f < 4; f++) {
+                for (int row = 0; row < MAX_ROWS; row++)
+                    pat->cell[row][ch].fx[f] = pack_read_byte(&pk);
+                for (int row = 0; row < MAX_ROWS; row++)
+                    pat->cell[row][ch].param[f] = pack_read_byte(&pk);
+            }
+        }
+    }
+    return abs(pk.pos - len) < 1;
+}
+
+static void fwrite32(FILE *f, uint32_t v)
+{
+    uint8_t b[4];
+    wr32(b, v);
+    fwrite(b, 4, 1, f);
+}
+
+bool song_save(const char *filename)
+{
+    int songLen = 0;
+    sample_data_gc();
+    uint8_t *songBuf = song_pack(&songLen);
+    if (songBuf == nullptr)
+        return false;
+    Packer pk;
+    if (pack_init(&pk, nullptr, 0, true) == nullptr) {
+        free(songBuf);
+        return false;
+    }
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        const SampleData *d = &g_sampleData[i];
+        if (d->raw == nullptr) {
+            pack_write32(&pk, 0);
+            pack_write16(&pk, 0);
+            pack_write_byte(&pk, 0);
+        } else {
+            pack_write32(&pk, (unsigned)d->rawLen);
+            pack_write16(&pk, (unsigned)d->rate);
+            pack_write_byte(&pk, (unsigned)d->bits);
+        }
+    }
+    pack_flush(&pk);
+    int smpLen = pk.pos;
+    FILE *f = fopen(filename, "wb");
+    if (f == nullptr) {
+        free(songBuf);
+        free(pk.buf);
+        return false;
+    }
+    fwrite("VGEfmtV3", 8, 1, f);
+    fwrite32(f, (uint32_t)songLen);
+    fwrite32(f, (uint32_t)smpLen);
+    fwrite(songBuf, songLen, 1, f);
+    fwrite(pk.buf, smpLen, 1, f);
+    free(songBuf);
+    free(pk.buf);
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        if (g_sampleData[i].raw != nullptr)
+            fwrite(g_sampleData[i].raw, g_sampleData[i].rawLen, 1, f);
+    }
+    fclose(f);
+    return true;
+}
+
+int song_load(const char *filename)
+{
+    FILE *f = fopen(filename, "rb");
+    if (f == nullptr)
+        return 1;
+    song_new();
+    fseek(f, 0, SEEK_END);
+    long size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    uint8_t *buf = (uint8_t *)malloc(size > 0 ? size : 1);
+    if (buf == nullptr) {
+        fclose(f);
+        return 3;
+    }
+    if (fread(buf, 1, size, f) != (size_t)size)
+        size = 0;
+    fclose(f);
+    if (size < 16 || (memcmp(buf, "VGEfmtV3", 8) != 0 && memcmp(buf, "VGEfmtV2", 8) != 0 &&
+                      memcmp(buf, "VGEfmtV1", 8) != 0)) {
+        free(buf);
+        return 2;
+    }
+    int version = buf[7] - '0';
+    int songLen = rd32(buf + 8);
+    int smpLen = rd32(buf + 12);
+    if (songLen < 0 || smpLen < 0 || (long)songLen + smpLen + 16 > size ||
+        !song_unpack(buf + 16, songLen, version)) {
+        song_new();
+        free(buf);
+        return 2;
+    }
+    Packer pk;
+    pack_init(&pk, buf + 16 + songLen, smpLen, true);
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        sample_data_free(i);
+        g_sampleData[i].rawLen = (int)pack_read32(&pk);
+        g_sampleData[i].rate = (int)pack_read16(&pk);
+        g_sampleData[i].bits = pack_read_byte(&pk);
+    }
+    long off = 16L + songLen + smpLen;
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        SampleData *d = &g_sampleData[i];
+        if (d->rawLen != 0) {
+            if (d->rawLen < 0 || off + d->rawLen > size) {      // truncated file
+                d->rawLen = 0;
+                continue;
+            }
+            d->raw = (uint8_t *)malloc(d->rawLen);
+            memcpy(d->raw, buf + off, d->rawLen);
+            off += d->rawLen;
+        }
+    }
+    free(buf);
+    samples_convert_all();
+    return 0;
+}
+
+// ---------------------------------------------------------------- timing
+
+// Speed effect (0x0f) handling shared by the two timing scans below.
+static inline void timing_scan_row(const Cell *row, unsigned *even, unsigned *odd, unsigned *interleave)
+{
+    for (int ch = 0; ch < CHANNELS; ch++) {
+        for (int f = 0; f < 4; f++) {
+            if (row[ch].fx[f] == 0x0f) {
+                uint8_t p = row[ch].param[f];
+                if ((p & 0xf0) == 0) {
+                    *interleave = p & 0xf;
+                } else {
+                    *even = p >> 4;
+                    *odd = p & 0xf;
+                    if (*even == 0)
+                        *even = 1;
+                    if ((p & 0xf) == 0)
+                        *odd = 1;
+                }
+            }
+        }
+    }
+}
+
+int song_calc_timing(void)
+{
+    int total = 0;
+    bool useOdd = false;
+    int count = 0;
+    unsigned interleave = g_song.interleave;
+    unsigned odd = g_song.speedOdd;
+    unsigned even = g_song.speedEven;
+    for (int pos = 0; pos < g_song.orderLen; pos++) {
+        Order *o = &g_song.order[pos];
+        o->startTick = total;
+        o->speedEven = (uint8_t)even;
+        o->speedOdd = (uint8_t)odd;
+        o->interleave = (uint8_t)interleave;
+        const Pattern *pat = &g_song.pattern[o->pattern];
+        for (int row = 0; row < pat->length; row++) {
+            timing_scan_row(pat->cell[row], &even, &odd, &interleave);
+            total += (int)(useOdd ? odd : even);
+            count++;
+            if ((int)interleave <= count) {
+                count = 0;
+                useOdd = !useOdd;
+            }
+        }
+    }
+    return total;
+}
+
+int song_position_tick(int order, int row)
+{
+    const Order *o = &g_song.order[order];
+    bool useOdd = false;
+    int count = 0;
+    int total = o->startTick;
+    unsigned odd = o->speedOdd;
+    unsigned even = o->speedEven;
+    unsigned interleave = o->interleave;
+    const Pattern *pat = &g_song.pattern[o->pattern];
+    for (int r = 0; r < pat->length && r != row; r++) {
+        timing_scan_row(pat->cell[r], &even, &odd, &interleave);
+        total += (int)(useOdd ? odd : even);
+        count++;
+        if ((int)interleave <= count) {
+            count = 0;
+            useOdd = !useOdd;
+        }
+    }
+    return total;
+}
+
+// ---------------------------------------------------------------- instruments / samples
+
+int ins_find_empty(void)
+{
+    for (int i = 0; i < MAX_INSTRUMENTS; i++)
+        if (ins_is_empty(&g_song.ins[i]))
+            return i;
+    return -1;
+}
+
+int sample_find_empty(void)
+{
+    for (int i = 0; i < MAX_SAMPLES; i++)
+        if (sample_is_empty(&g_song.sample[i]))
+            return i;
+    return -1;
+}
+
+void ins_swap_refs(int a, int b)
+{
+    if (a == b)
+        return;
+    for (int p = 0; p < MAX_PATTERNS; p++) {
+        Pattern *pat = &g_song.pattern[p];
+        for (int row = 0; row < pat->length; row++) {
+            for (int ch = 0; ch < CHANNELS; ch++) {
+                Cell *c = &pat->cell[row][ch];
+                if (c->ins == a + 1)
+                    c->ins = (int16_t)(b + 1);
+                else if (c->ins == b + 1)
+                    c->ins = (int16_t)(a + 1);
+            }
+        }
+    }
+}
+
+void sample_swap_refs(unsigned a, unsigned b)
+{
+    if (a == b)
+        return;
+    for (int p = 0; p < MAX_PATTERNS; p++) {
+        Pattern *pat = &g_song.pattern[p];
+        for (int row = 0; row < pat->length; row++) {
+            for (int ch = 0; ch < CHANNELS; ch++) {
+                Cell *c = &pat->cell[row][ch];
+                for (int f = 0; f < 4; f++) {
+                    if (c->fx[f] == 0x1c) {
+                        if (c->param[f] == a)
+                            c->param[f] = (uint8_t)b;
+                        else if (c->param[f] == b)
+                            c->param[f] = (uint8_t)a;
+                    }
+                }
+            }
+        }
+    }
+}
+
+int cleanup_unused_instruments(void)
+{
+    char used[0x100];
+    memset(used, 0, sizeof(used));
+    for (int p = 0; p < MAX_PATTERNS; p++) {
+        const Pattern *pat = &g_song.pattern[p];
+        for (int row = 0; row < pat->length; row++)
+            for (int ch = 0; ch < CHANNELS; ch++)
+                if (pat->cell[row][ch].ins != 0)
+                    used[(uint8_t)(pat->cell[row][ch].ins - 1)] = 1;
+    }
+    int removed = 0;
+    for (int i = 0; i < MAX_INSTRUMENTS; i++) {
+        if (!used[i] && !ins_is_empty(&g_song.ins[i])) {
+            ins_clear(&g_song.ins[i]);
+            removed++;
+        }
+    }
+    return removed;
+}
+
+void rearrange_instruments(void)
+{
+    for (int i = 0; i < MAX_INSTRUMENTS; i++) {
+        if (!ins_is_empty(&g_song.ins[i]))
+            continue;
+        int j = i;
+        int found;
+        do {
+            j++;
+            found = -1;
+            if (j > 0xfe)
+                break;
+            found = j;
+        } while (ins_is_empty(&g_song.ins[j]));
+        if (found < 1)
+            return;
+        Instrument tmp = g_song.ins[i];
+        g_song.ins[i] = g_song.ins[found];
+        g_song.ins[found] = tmp;
+        ins_swap_refs(i, found);
+    }
+}
+
+void pattern_swap(unsigned a, unsigned b)
+{
+    if (a == b)
+        return;
+    Cell tmp[CHANNELS];
+    for (int row = 0; row < MAX_ROWS; row++) {
+        memcpy(tmp, g_song.pattern[a].cell[row], sizeof(tmp));
+        memcpy(g_song.pattern[a].cell[row], g_song.pattern[b].cell[row], sizeof(tmp));
+        memcpy(g_song.pattern[b].cell[row], tmp, sizeof(tmp));
+    }
+    int32_t l = g_song.pattern[a].length;
+    g_song.pattern[a].length = g_song.pattern[b].length;
+    g_song.pattern[b].length = l;
+    for (int i = 0; i < g_song.orderLen; i++) {
+        if (g_song.order[i].pattern == a)
+            g_song.order[i].pattern = (uint8_t)b;
+        else if (g_song.order[i].pattern == b)
+            g_song.order[i].pattern = (uint8_t)a;
+    }
+}
+
+void rearrange_patterns(void)
+{
+    int map[0x100];
+    for (int i = 0; i < 0x100; i++)
+        map[i] = -1;
+    int count = 0;
+    for (int i = 0; i < g_song.orderLen; i++) {
+        bool found = false;
+        uint8_t p = g_song.order[i].pattern;
+        for (int j = 0; j < g_song.orderLen; j++) {
+            if (g_song.order[j].pattern == p && map[j] < 0) {
+                map[j] = count;
+                found = true;
+            }
+        }
+        if (found)
+            count++;
+    }
+    for (int i = 0; i < g_song.orderLen; i++)
+        pattern_swap((unsigned)map[i], g_song.order[i].pattern);
+    for (int i = count; i < MAX_PATTERNS; i++)
+        pattern_clear(i);
+}
+
+// ---------------------------------------------------------------- order list
+
+bool order_delete(int pos)
+{
+    if (g_song.orderLen < 2)
+        return false;
+    if (pos >= g_song.orderLen)
+        return false;
+    // The original shifts 256 entries, pulling the bytes that follow the table into the last one.
+    uint8_t *base = (uint8_t *)g_song.order;
+    memmove(base + pos * sizeof(Order), base + (pos + 1) * sizeof(Order), (MAX_ORDERS - pos) * sizeof(Order));
+    if (pos < g_song.loopPos)
+        g_song.loopPos--;
+    g_song.orderLen--;
+    if (g_song.orderLen <= g_song.loopPos)
+        g_song.loopPos = (uint16_t)(g_song.orderLen - 1);
+    return true;
+}
+
+bool order_insert(int pos, int mode)
+{
+    if (g_song.orderLen >= 0x100)
+        return false;
+    for (int i = 0xff; pos < i && pos < 0xff; i--)
+        g_song.order[i] = g_song.order[i - 1];
+    g_song.orderLen++;
+    int fresh = -1;
+    if (mode != 0) {
+        char used[0x100];
+        memset(used, 0, sizeof(used));
+        for (int i = 0; i < g_song.orderLen; i++)
+            used[g_song.order[i].pattern] = 1;
+        for (int i = 0; i < 0x100; i++) {
+            if (!used[i]) {
+                fresh = i;
+                break;
+            }
+        }
+        if (fresh < 0)
+            mode = 0;
+        else
+            g_song.order[pos].pattern = (uint8_t)fresh;
+    }
+    if (mode == 1) {
+        pattern_clear(fresh);
+    } else if (mode == 2) {
+        // pos == 255 reads one entry past the table in the original, i.e. the low byte of orderLen
+        uint8_t next = ((uint8_t *)g_song.order)[(pos + 1) * sizeof(Order)];
+        memcpy(&g_song.pattern[g_song.order[pos].pattern], &g_song.pattern[next], sizeof(Pattern));
+    }
+    if (pos < g_song.loopPos) {
+        g_song.loopPos++;
+        if (g_song.loopPos > 0xff)
+            g_song.loopPos = 0x100;
+    }
+    return true;
+}
+
+bool order_swap(int a, int b)
+{
+    if (a < 0 || a >= g_song.orderLen)
+        return false;
+    if (b < 0 || b >= g_song.orderLen)
+        return false;
+    Order t = g_song.order[a];
+    g_song.order[a] = g_song.order[b];
+    g_song.order[b] = t;
+    return true;
+}
diff --git a/extern/vgmmm/song.h b/extern/vgmmm/song.h
new file mode 100644
index 0000000..f589662
--- /dev/null
+++ b/extern/vgmmm/song.h
@@ -0,0 +1,203 @@
+// Song data model of VGM Music Maker 1.1.
+//
+// The layout of Song mirrors the original program's memory image byte for byte (the original
+// keeps these tables in consecutive globals and occasionally reads across their borders, e.g.
+// "instrument 0" reads the tail of the last pattern), so the structs must not be reordered.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+enum {
+    CHANNELS = 10,          // 6 FM + 3 PSG tone + 1 PSG noise
+    FM_CHANNELS = 6,
+    MAX_ROWS = 256,
+    MAX_PATTERNS = 256,
+    MAX_ORDERS = 256,
+    MAX_INSTRUMENTS = 255,
+    MAX_SAMPLES = 255,
+    NOTE_EMPTY = 0xff,
+    NOTE_OFF = 0xfe,
+};
+
+struct Cell {
+    int16_t note;           // 0..11 semitone, NOTE_OFF, NOTE_EMPTY
+    int8_t octave;
+    int8_t volume;          // 0 = none, 1..31
+    uint8_t fx[4];          // effect type per effect column
+    uint8_t param[4];       // effect parameter per effect column
+    int16_t ins;            // 0 = none, else instrument number + 1
+};
+
+struct Pattern {
+    Cell cell[MAX_ROWS][CHANNELS];
+    int32_t length;
+};
+
+struct Operator {
+    uint8_t mult;
+    int8_t dt;              // -3..3
+    uint8_t tl;
+    uint8_t rs;
+    uint8_t ar;
+    uint8_t dr;             // bit 7 = AM enable
+    uint8_t sr;
+    uint8_t rr;
+    uint8_t sl;
+    uint8_t ssg;
+};
+
+struct Instrument {
+    Operator op[4];
+    uint8_t alg;
+    uint8_t fb;
+    uint8_t ams;
+    uint8_t fms;
+    char name[17];
+};
+
+struct Sample {
+    int32_t data;           // index into g_sampleData, -1 = none
+    uint8_t volume;         // 0x80 = 100%
+    int32_t tune;
+    char name[17];
+};
+
+struct Order {
+    uint8_t pattern;
+    uint8_t speedEven;      // speeds in effect at the start of this position (song_calc_timing)
+    uint8_t speedOdd;
+    uint8_t interleave;
+    int32_t startTick;
+};
+
+struct Song {
+    Pattern pattern[MAX_PATTERNS];
+    Instrument ins[MAX_INSTRUMENTS];
+    Sample sample[MAX_SAMPLES];
+    Order order[MAX_ORDERS];
+    uint16_t orderLen;
+    uint16_t loopPos;
+    uint32_t fmClock;
+    uint32_t psgClock;
+    uint32_t fps;
+    uint32_t speedEven;
+    uint32_t speedOdd;
+    uint32_t interleave;
+    uint32_t sampleRate;
+    char name[0x40];
+    char author[0x40];
+    char message[0x180];
+    uint16_t dateCreated;
+    uint16_t dateModified;
+    uint16_t saveCount;
+    uint16_t pad;
+};
+
+static_assert(sizeof(Cell) == 14, "Cell layout");
+static_assert(sizeof(Pattern) == 0x8c04, "Pattern layout");
+static_assert(sizeof(Instrument) == 0x3d, "Instrument layout");
+static_assert(sizeof(Sample) == 0x20, "Sample layout");
+static_assert(offsetof(Song, ins) == 0x8c0400, "Song layout");
+static_assert(offsetof(Song, sample) == 0x8c40c4, "Song layout");
+static_assert(offsetof(Song, order) == 0x8c60a4, "Song layout");
+static_assert(offsetof(Song, orderLen) == 0x8c68a4, "Song layout");
+static_assert(offsetof(Song, fmClock) == 0x8c68a8, "Song layout");
+static_assert(sizeof(Song) == 0x8c6acc, "Song layout");
+
+struct SampleData {
+    uint8_t *raw;           // WAV data as loaded (8 or 16 bit mono)
+    uint8_t *conv;          // unsigned 8-bit at the module's sample rate, 0x80-terminated
+    int32_t rawLen;         // bytes
+    int32_t rate;
+    int32_t bits;
+    int32_t convLen;
+};
+
+extern Song g_song;
+extern SampleData g_sampleData[MAX_SAMPLES];
+extern bool g_defaultInstrument;        // put a default instrument into slot 0 of a new module
+extern uint16_t (*g_dateNow)(void);     // packed current date; replaceable for tests
+
+// Instrument N as the player addresses it (1-based; 0 and -1 deliberately alias pattern memory).
+inline Instrument *ins_ptr(int n)
+{
+    return (Instrument *)((uint8_t *)g_song.ins + (ptrdiff_t)(n - 1) * (ptrdiff_t)sizeof(Instrument));
+}
+
+// ---- pack.cpp: RLE stream used inside .vge files
+struct Packer {
+    uint8_t *buf;
+    int marker;
+    int prev;
+    unsigned count;
+    int size;
+    int pos;
+    bool compress;
+};
+uint8_t *pack_init(Packer *p, uint8_t *buf, int size, bool compress);
+uint8_t pack_read_byte(Packer *p);
+void pack_write(Packer *p, unsigned value);     // value > 0xff flushes a pending run
+void pack_write_byte(Packer *p, unsigned value);
+void pack_flush(Packer *p);
+void pack_write_str(Packer *p, const char *s, int len);
+void pack_read_bytes(Packer *p, void *dst, int len);
+void pack_write16(Packer *p, unsigned v);
+unsigned pack_read16(Packer *p);
+void pack_write32(Packer *p, unsigned v);
+unsigned pack_read32(Packer *p);
+
+// ---- song.cpp
+uint16_t date_now(void);
+void date_to_str(char *dst, unsigned date);     // "dd.mm.yy" or "--.--.--"
+void pattern_clear(int pat);
+void song_new(void);                            // everything
+void song_clear(void);                          // song data only, keeps instruments and samples
+uint8_t *song_pack(int *outLen);                 // malloc'ed image of the whole module (undo snapshots)
+bool song_unpack(uint8_t *buf, int len, int version);
+bool song_save(const char *filename);
+int song_load(const char *filename);            // 0 ok, 1 can't open, 2 wrong format, 3 no memory
+int song_calc_timing(void);                     // fills Order speed/startTick, returns length in ticks
+int song_position_tick(int order, int row);
+
+int ins_find_empty(void);
+int sample_find_empty(void);
+void ins_swap_refs(int a, int b);
+void sample_swap_refs(unsigned a, unsigned b);
+int cleanup_unused_instruments(void);
+void rearrange_instruments(void);
+void pattern_swap(unsigned a, unsigned b);
+void rearrange_patterns(void);
+bool order_delete(int pos);
+bool order_insert(int pos, int mode);           // 0 same pattern, 1 new empty, 2 copy of next
+bool order_swap(int a, int b);
+void pattern_expand(int pat);
+void pattern_shrink(int pat);
+
+// ---- instrument.cpp
+void ins_clear(Instrument *ins);
+bool ins_is_empty(const Instrument *ins);
+void ins_change_volume(Instrument *ins, int delta);
+void ins_from_vgi(Instrument *ins, const uint8_t *vgi);
+bool ins_load(Instrument *ins, const char *filename);   // .vgi .tfi .dat .y12 .ins .bin
+bool ins_save_vgi(const Instrument *ins, const char *filename);
+int dt_from_reg(int v);
+int dt_to_reg(int v);
+extern const uint8_t g_defaultInsVgi[43];
+
+// ---- sample.cpp
+void sample_data_init(void);
+void sample_data_free(int idx);
+void sample_data_gc(void);
+int sample_data_find_free(void);
+void sample_clear(Sample *s);
+bool sample_is_empty(const Sample *s);
+void samples_clear_all(void);
+void sample_convert(Sample *s);
+void samples_convert_all(void);
+bool sample_load_wav(Sample *s, const char *filename, char *error);
+bool sample_copy(const Sample *src, Sample *dst);
+int samples_total_size(void);
+
+inline int rd16(const uint8_t *p) { return p[0] + p[1] * 0x100; }
+inline int rd32(const uint8_t *p) { return (int)(p[0] + p[1] * 0x100u + p[2] * 0x10000u + p[3] * 0x1000000u); }
+inline void wr32(uint8_t *p, unsigned v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
