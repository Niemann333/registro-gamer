+				uint16_t seqLen = ctr.readUint16(csr);
+				csr += 2;
+				for (uint16_t l = 0; l < seqLen; ++l) {
+					uint16_t data = ctr.readUint16(csr);
+					csr += 2;
+					if (l == 0)
