+  if (rgVge) {
+    isMuted[ch]=mute;
+    rWrite(0,0x90|(ch<<5)|(mute?15:(rgVgeVol[ch]&15)));
+    rgVgeLatch=(ch<<1)|1;
+    return;
+  }
   isMuted[ch]=mute;
   if (chan[ch].active) chan[ch].writeVol=true;
