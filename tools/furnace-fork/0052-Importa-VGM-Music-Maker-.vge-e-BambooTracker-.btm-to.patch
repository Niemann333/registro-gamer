diff --git a/src/engine/rgBT.cpp b/src/engine/rgBT.cpp
new file mode 100644
index 0000000..e005a08
--- /dev/null
+++ b/src/engine/rgBT.cpp
@@ -0,0 +1,220 @@
+// RG: BambooTracker dentro do Furnace (compatFlags.rgBT).
+// O importador (fileOps/btm.cpp) põe os padrões e instrumentos na música do Furnace (para ver) e guarda o .btm
+// original nas opções do YM2608 (rgBTData). Na hora de tocar, quem toca é o próprio BambooTracker
+// (extern/bambootracker): a cada tique ele gera as escritas nos registradores do YM2608, e elas vão direto
+// para o chip do Furnace. A memória do ADPCM também é a que o BambooTracker monta.
+
+#include "engine.h"
+#include <map>
+#include "../baseutils.h"
+#include "platform/ym2608.h"
+#include "../../extern/bambootracker/rgbt.h"
+
+// base64 -> bytes (o taDecodeBase64 do Furnace pula os bytes zero; aqui é binário)
+static std::string rgBTDecode(const String& in) {
+  std::string out;
+  out.reserve(in.size()*3/4);
+  unsigned int acc=0;
+  int bits=0;
+  for (char c: in) {
+    int v;
+    if (c>='A' && c<='Z') v=c-'A';
+    else if (c>='a' && c<='z') v=c-'a'+26;
+    else if (c>='0' && c<='9') v=c-'0'+52;
+    else if (c=='+') v=62;
+    else if (c=='/') v=63;
+    else continue;
+    acc=(acc<<6)|v;
+    bits+=6;
+    if (bits>=8) {
+      bits-=8;
+      out+=(char)((acc>>bits)&0xff);
+    }
+  }
+  return out;
+}
+
+static DivPlatformYM2608* rgBTChip(DivEngine* e, DivSong& song, DivDispatchContainer* disCont) {
+  if (song.systemLen<1) return NULL;
+  if (song.system[0]!=DIV_SYSTEM_YM2608 && song.system[0]!=DIV_SYSTEM_YM2608_EXT) return NULL;
+  if (disCont[0].dispatch==NULL) return NULL;
+  return (DivPlatformYM2608*)disCont[0].dispatch;
+}
+
+void DivEngine::rgBTSetup() {
+  DivPlatformYM2608* ym=rgBTChip(this,song,disCont);
+  bool on=song.compatFlags.rgBT && ym!=NULL && !song.systemFlags[0].getString("rgBTData","").empty();
+  if (ym!=NULL) ym->rgBT=on;
+  rgBTOn=on;
+  // memória do ADPCM já na hora (a exportação para VGM grava a memória antes de tocar)
+  if (on && rgBTEnsure()) {
+    size_t len=0;
+    const unsigned char* mem=rgBTPlayer->dram(len);
+    ym->rgBTSetMem(mem,len);
+  }
+}
+
+void DivEngine::rgBTRelease() {
+  if (rgBTPlayer!=NULL) {
+    delete rgBTPlayer;
+    rgBTPlayer=NULL;
+  }
+  rgBTLoaded="";
+}
+
+// carrega o .btm guardado na música (só quando mudou)
+bool DivEngine::rgBTEnsure() {
+  String data=song.systemFlags[0].getString("rgBTData","");
+  if (data.empty()) return false;
+  if (rgBTPlayer!=NULL && rgBTLoaded==data) return true;
+  if (rgBTPlayer==NULL) rgBTPlayer=new rgbt::Player;
+  std::string bin=rgBTDecode(data);
+  std::string msg;
+  if (!rgBTPlayer->load((const unsigned char*)bin.data(),bin.size(),msg)) {
+    logE("BambooTracker: %s",msg.c_str());
+    rgBTLoaded="";
+    return false;
+  }
+  rgBTLoaded=data;
+  return true;
+}
+
+void DivEngine::rgBTApply(void* writes) {
+  std::vector<rgbt::Write>& w=*(std::vector<rgbt::Write>*)writes;
+  DivPlatformYM2608* ym=rgBTChip(this,song,disCont);
+  if (ym==NULL) return;
+  for (rgbt::Write& i: w) {
+    if (i.addr==0xffff) continue; // o chip do BambooTracker foi zerado (o Furnace já zerou o dele)
+    ym->rgBTWrite(i.addr,i.val);
+  }
+}
+
+void DivEngine::rgBTStart(int order, int row) {
+  curOrder=order;
+  curRow=row;
+  prevOrder=order;
+  prevRow=row;
+  if (!rgBTEnsure()) return;
+  std::vector<rgbt::Write> w;
+  int sub=0;
+  for (size_t i=0; i<song.subsong.size(); i++) {
+    if (song.subsong[i]==curSubSong) sub=i;
+  }
+  rgBTPlayer->start(sub,order,row,w);
+  DivPlatformYM2608* ym=rgBTChip(this,song,disCont);
+  if (ym!=NULL) {
+    size_t len=0;
+    const unsigned char* mem=rgBTPlayer->dram(len);
+    ym->rgBTSetMem(mem,len);
+  }
+  rgBTApply(&w);
+}
+
+bool DivEngine::rgBTTick() {
+  if (rgBTPlayer==NULL || rgBTLoaded.empty()) return false;
+  std::vector<rgbt::Write> w;
+  int order=0, step=0;
+  bool newStep=false, ended=false;
+  bool looped=rgBTPlayer->tick(w,order,step,newStep,ended);
+  rgBTApply(&w);
+  if (ended) {
+    shallStop=true;
+    return true;
+  }
+  if (newStep && order>=0 && step>=0) {
+    playPosLock.lock();
+    prevOrder=order;
+    prevRow=step;
+    playPosLock.unlock();
+    curOrder=order;
+    curRow=step;
+  }
+  return looped;
+}
+
+// tempo de cada passo: o BambooTracker toca a música em silêncio uma vez (outro tocador, separado)
+void DivEngine::rgBTTimestamps() {
+  DivSubSong* sub=curSubSong;
+  DivSongTimestamps& ts=sub->ts;
+  for (int i=0; i<DIV_MAX_PATTERNS; i++) {
+    if (ts.orders[i]) {
+      delete[] ts.orders[i];
+      ts.orders[i]=NULL;
+    }
+  }
+  memset(ts.maxRow,0,DIV_MAX_PATTERNS);
+  ts.totalTime=TimeMicros(0,0);
+  ts.totalTicks=0;
+  ts.totalRows=0;
+  ts.isLoopDefined=true;
+  ts.isLoopable=true;
+  ts.loopStart.order=0;
+  ts.loopStart.row=0;
+  ts.loopStartTime=TimeMicros(0,0);
+
+  String data=song.systemFlags[0].getString("rgBTData","");
+  if (data.empty()) return;
+  int subIdx=0;
+  for (size_t i=0; i<song.subsong.size(); i++) {
+    if (song.subsong[i]==sub) subIdx=i;
+  }
+  // a conta é cara (a música inteira em silêncio): guarda o resultado por módulo e subfaixa
+  struct RGBTTiming {
+    std::vector<int> ords, steps;
+    std::vector<long> ticks;
+    int loopOrder=0, loopStep=0;
+    long total=0;
+    bool loops=true;
+  };
+  static std::map<std::pair<size_t,int>,RGBTTiming> cache;
+  std::pair<size_t,int> key(std::hash<std::string>()(data),subIdx);
+  if (cache.find(key)==cache.end()) {
+    if (cache.size()>16) cache.clear();
+    RGBTTiming tm;
+    rgbt::Player pl;
+    std::string bin=rgBTDecode(data);
+    std::string msg;
+    if (!pl.load((const unsigned char*)bin.data(),bin.size(),msg)) return;
+    pl.timing(subIdx,tm.ords,tm.steps,tm.ticks,tm.loopOrder,tm.loopStep,tm.total,tm.loops);
+    cache[key]=tm;
+  }
+  RGBTTiming& tm=cache[key];
+  std::vector<int>& ords=tm.ords;
+  std::vector<int>& steps=tm.steps;
+  std::vector<long>& ticks=tm.ticks;
+  int loopOrder=tm.loopOrder, loopStep=tm.loopStep;
+  long total=tm.total;
+  bool loops=tm.loops;
+  double hz=sub->hz;
+  if (hz<1) hz=60;
+  for (size_t i=0; i<ords.size(); i++) {
+    int o=ords[i], r=steps[i];
+    if (o<0 || o>=DIV_MAX_PATTERNS || r<0 || r>=DIV_MAX_ROWS) continue;
+    if (ts.orders[o]==NULL) {
+      ts.orders[o]=new TimeMicros[DIV_MAX_ROWS];
+      for (int k=0; k<DIV_MAX_ROWS; k++) ts.orders[o][k].seconds=-1;
+    }
+    if (ts.orders[o][r].seconds>=0) continue;
+    double t=(double)ticks[i]/hz;
+    ts.orders[o][r]=TimeMicros((int)t,(int)((t-(int)t)*1000000.0));
+    if (ts.maxRow[o]<r) ts.maxRow[o]=r;
+    ts.totalRows++;
+  }
+  double t=(double)total/hz;
+  ts.totalTime=TimeMicros((int)t,(int)((t-(int)t)*1000000.0));
+  ts.totalTicks=total;
+  ts.isLoopable=loops;
+  ts.isLoopDefined=loops;
+  if (loops) {
+    ts.loopStart.order=loopOrder;
+    ts.loopStart.row=loopStep;
+    ts.loopStartTime=ts.getTimes(loopOrder,loopStep);
+    if (ts.loopStartTime.seconds<0) ts.loopStartTime=TimeMicros(0,0);
+  } else {
+    ts.loopStartTime=ts.totalTime;
+  }
+  if (!ords.empty()) {
+    ts.loopEnd.order=ords.back();
+    ts.loopEnd.row=steps.back();
+  }
+}
diff --git a/src/engine/rgVge.cpp b/src/engine/rgVge.cpp
new file mode 100644
index 0000000..63e672a
--- /dev/null
+++ b/src/engine/rgVge.cpp
@@ -0,0 +1,283 @@
+// RG: VGM Music Maker dentro do Furnace (compatFlags.rgVGMMM).
+// A música continua sendo do Furnace (padrões, instrumentos, amostras: dá para ver e editar), mas quem toca é o
+// tocador do próprio VGMMM (extern/vgmmm): a cada tique ele gera as escritas nos registradores do YM2612 e do
+// SN76489, e elas vão direto para os chips do Furnace. Ao tocar, o módulo do VGMMM é remontado a partir da
+// música do Furnace (rgVgeBuild), então as edições valem.
+
+#include "engine.h"
+#include "rgVgeMap.h"
+#include "platform/genesis.h"
+#include "platform/sms.h"
+#include "../../extern/vgmmm/rgvge.h"
+
+void DivEngine::rgVgeSetup() {
+  bool on=song.compatFlags.rgVGMMM && song.systemLen>=2 &&
+    song.system[0]==DIV_SYSTEM_YM2612 && song.system[1]==DIV_SYSTEM_SMS &&
+    disCont[0].dispatch!=NULL && disCont[1].dispatch!=NULL;
+  if (song.systemLen>=1 && song.system[0]==DIV_SYSTEM_YM2612 && disCont[0].dispatch!=NULL) {
+    ((DivPlatformGenesis*)disCont[0].dispatch)->rgVge=on;
+  }
+  if (song.systemLen>=2 && song.system[1]==DIV_SYSTEM_SMS && disCont[1].dispatch!=NULL) {
+    ((DivPlatformSMS*)disCont[1].dispatch)->rgVge=on;
+  }
+  rgVgeOn=on;
+}
+
+// comprimento do padrão: 0Dxx nas colunas de efeito a partir da quinta (posto pelo importador)
+static int rgVgePatLen(DivSubSong* sub, int p) {
+  int len=sub->patLen;
+  for (int ch=0; ch<rgvge::CHANNELS; ch++) {
+    DivPattern* pat=sub->pat[ch].getPattern(p,false);
+    if (pat==NULL) continue;
+    for (int row=0; row<len; row++) {
+      for (int f=4; f<DIV_MAX_EFFECTS; f++) {
+        if (pat->newData[row][DIV_PAT_FX(f)]==0x0d) {
+          len=row+1;
+          break;
+        }
+      }
+    }
+  }
+  if (len<1) len=1;
+  if (len>rgvge::MAX_ROWS) len=rgvge::MAX_ROWS;
+  return len;
+}
+
+void DivEngine::rgVgeBuild() {
+  DivSubSong* sub=curSubSong;
+  DivConfig& f=song.systemFlags[0];
+  rgvge::clear();
+  rgvge::Header h;
+  rgvge::getHeader(h);
+  h.fmClock=f.getInt("rgVgeFM",7600489);
+  h.psgClock=f.getInt("rgVgePSG",3546894);
+  h.fps=(unsigned int)round(sub->hz);
+  if (h.fps<1) h.fps=50;
+  h.speedEven=f.getInt("rgVgeSpeedE",sub->speeds.val[0]);
+  h.speedOdd=f.getInt("rgVgeSpeedO",sub->speeds.val[sub->speeds.len>1?sub->speeds.len-1:0]);
+  h.interleave=f.getInt("rgVgeInter",MAX(1,sub->speeds.len/2));
+  h.sampleRate=f.getInt("rgVgeRate",22050);
+  h.orderLen=MAX(1,MIN(sub->ordersLen,rgvge::MAX_ORDERS));
+  h.loopPos=f.getInt("rgVgeLoop",0);
+  if (h.loopPos<0 || h.loopPos>=h.orderLen) h.loopPos=0;
+  h.dateCreated=f.getInt("rgVgeCreated",0);
+  h.dateModified=f.getInt("rgVgeModified",0);
+  h.saveCount=f.getInt("rgVgeSaves",0);
+  memset(h.name,0,sizeof(h.name));
+  memset(h.author,0,sizeof(h.author));
+  memset(h.message,0,sizeof(h.message));
+  strncpy(h.name,song.name.c_str(),64);
+  strncpy(h.author,song.author.c_str(),64);
+  strncpy(h.message,song.notes.c_str(),384);
+  rgvge::setHeader(h);
+
+  bool done[256];
+  memset(done,0,sizeof(done));
+  for (int i=0; i<h.orderLen; i++) {
+    int p=sub->orders.ord[0][i]&255;
+    rgvge::setOrderPattern(i,p);
+    if (done[p]) continue;
+    done[p]=true;
+    int len=rgVgePatLen(sub,p);
+    rgvge::setPatternLength(p,len);
+    for (int ch=0; ch<rgvge::CHANNELS; ch++) {
+      DivPattern* pat=sub->pat[ch].getPattern(sub->orders.ord[ch][i],false);
+      for (int row=0; row<len; row++) {
+        rgvge::Cell c;
+        c.note=rgvge::NOTE_EMPTY;
+        c.octave=0;
+        c.volume=0;
+        c.ins=0;
+        for (int k=0; k<4; k++) {
+          c.fx[k]=0;
+          c.param[k]=0;
+        }
+        if (pat!=NULL) {
+          short n=pat->newData[row][DIV_PAT_NOTE];
+          if (n==DIV_NOTE_OFF || n==DIV_NOTE_REL || n==DIV_MACRO_REL) {
+            c.note=rgvge::NOTE_OFF;
+          } else if (n>=60 && n<180) {
+            c.note=(n-60)%12;
+            c.octave=(n-60)/12;
+          }
+          short v=pat->newData[row][DIV_PAT_VOL];
+          if (v>=0) c.volume=rgVgeVolFromFur(ch,v);
+          short in=pat->newData[row][DIV_PAT_INS];
+          if (in>=0 && in<rgvge::MAX_INSTRUMENTS) c.ins=in+1;
+          for (int k=0; k<4; k++) {
+            short fx=pat->newData[row][DIV_PAT_FX(k)];
+            if (fx<0) continue;
+            unsigned char ofx, op;
+            if (rgVgeFxFromFur(fx,pat->newData[row][DIV_PAT_FXVAL(k)],ofx,op)) {
+              c.fx[k]=ofx;
+              c.param[k]=op;
+            }
+          }
+        }
+        rgvge::setCell(p,row,ch,c);
+      }
+    }
+  }
+
+  // instrumentos FM do Furnace -> VGMMM (mesmo número)
+  for (int i=0; i<MIN(song.insLen,(int)rgvge::MAX_INSTRUMENTS); i++) {
+    DivInstrument* ins=song.ins[i];
+    if (ins==NULL) continue;
+    rgvge::Ins vi;
+    memset(&vi,0,sizeof(vi));
+    vi.alg=ins->fm.alg&7;
+    vi.fb=ins->fm.fb&7;
+    vi.ams=ins->fm.ams&3;
+    vi.fms=ins->fm.fms&7;
+    for (int j=0; j<4; j++) {
+      const DivInstrumentFM::Operator& o=ins->fm.op[j];
+      vi.op[j].mult=o.mult&15;
+      vi.op[j].dt=(signed char)((o.dt&7)-3);
+      vi.op[j].tl=o.tl&0x7f;
+      vi.op[j].rs=o.rs&3;
+      vi.op[j].ar=o.ar&31;
+      vi.op[j].dr=(o.dr&31)|(o.am?0x80:0);
+      vi.op[j].sr=o.d2r&31;
+      vi.op[j].rr=o.rr&15;
+      vi.op[j].sl=o.sl&15;
+      vi.op[j].ssg=o.ssgEnv&15;
+    }
+    strncpy(vi.name,ins->name.c_str(),16);
+    vi.name[16]=0;
+    rgvge::setIns(i,vi);
+  }
+}
+
+struct RGVgeBufs {
+  std::vector<rgvge::Write> w;
+  std::vector<int> dac;
+};
+
+void DivEngine::rgVgeApply(void* writes, void* dac) {
+  std::vector<rgvge::Write>& w=*(std::vector<rgvge::Write>*)writes;
+  std::vector<int>& d=*(std::vector<int>*)dac;
+  DivPlatformGenesis* fm=(DivPlatformGenesis*)disCont[0].dispatch;
+  DivPlatformSMS* psg=(DivPlatformSMS*)disCont[1].dispatch;
+  for (rgvge::Write& i: w) {
+    if (i.type<2) {
+      fm->rgVgeWrite((i.type<<8)|i.reg,i.val);
+    } else if (i.type==2) {
+      psg->rgVgeWrite(i.val);
+    }
+  }
+  int rate=song.systemFlags[0].getInt("rgVgeRate",22050);
+  for (int s: d) fm->rgVgeDac(s,rate);
+}
+
+void DivEngine::rgVgeStart(int order, int row) {
+  rgVgeBuild();
+  RGVgeBufs b;
+  if (order<0 || order>=curSubSong->ordersLen) order=0;
+  rgvge::start(order,row,b.w,b.dac);
+  rgVgeApply(&b.w,&b.dac);
+  rgVgeFirstTick=true;
+  // no VGMMM o primeiro tique só vem depois de um tique de áudio (chips.cpp, audio_render)
+  rgVgeWait=true;
+  curOrder=order;
+  curRow=row;
+  prevOrder=order;
+  prevRow=row;
+}
+
+bool DivEngine::rgVgeTick() {
+  if (rgVgeWait) {
+    rgVgeWait=false;
+    return false;
+  }
+  RGVgeBufs b;
+  int order=0, row=0;
+  bool newRow=false;
+  bool looped=rgvge::tick(b.w,b.dac,order,row,newRow);
+  rgVgeApply(&b.w,&b.dac);
+  if (newRow) {
+    playPosLock.lock();
+    prevOrder=order;
+    prevRow=row;
+    playPosLock.unlock();
+    curOrder=order;
+    curRow=row;
+  }
+  if (rgVgeFirstTick) {
+    rgVgeFirstTick=false;
+    return false;
+  }
+  return looped;
+}
+
+// tempo de cada linha contado como o VGMMM (song_calc_timing): velocidade par/ímpar e intercalação, efeito 0F
+void DivEngine::rgVgeTimestamps() {
+  DivSubSong* sub=curSubSong;
+  DivSongTimestamps& ts=sub->ts;
+  DivConfig& f=song.systemFlags[0];
+  for (int i=0; i<DIV_MAX_PATTERNS; i++) {
+    if (ts.orders[i]) {
+      delete[] ts.orders[i];
+      ts.orders[i]=NULL;
+    }
+  }
+  memset(ts.maxRow,0,DIV_MAX_PATTERNS);
+  double hz=sub->hz;
+  if (hz<1) hz=50;
+  unsigned int even=MAX(1,f.getInt("rgVgeSpeedE",6));
+  unsigned int odd=MAX(1,f.getInt("rgVgeSpeedO",6));
+  unsigned int inter=MAX(1,f.getInt("rgVgeInter",1));
+  int loopPos=f.getInt("rgVgeLoop",0);
+  if (loopPos<0 || loopPos>=sub->ordersLen) loopPos=0;
+  bool useOdd=false;
+  unsigned int count=0;
+  uint64_t total=0;
+  int rows=0;
+  for (int o=0; o<sub->ordersLen; o++) {
+    int p=sub->orders.ord[0][o];
+    int len=rgVgePatLen(sub,p);
+    ts.orders[o]=new TimeMicros[DIV_MAX_ROWS];
+    for (int i=0; i<DIV_MAX_ROWS; i++) ts.orders[o][i].seconds=-1;
+    for (int row=0; row<len; row++) {
+      double t=(double)total/hz;
+      ts.orders[o][row]=TimeMicros((int)t,(int)((t-(int)t)*1000000.0));
+      // efeito 0F do VGMMM nesta linha (qualquer canal)
+      for (int ch=0; ch<rgvge::CHANNELS; ch++) {
+        DivPattern* pat=sub->pat[ch].getPattern(sub->orders.ord[ch][o],false);
+        if (pat==NULL) continue;
+        for (int k=0; k<4; k++) {
+          if (pat->newData[row][DIV_PAT_FX(k)]==0x0f) {
+            int v=pat->newData[row][DIV_PAT_FXVAL(k)];
+            if (v<0) v=0;
+            if ((v&0xf0)==0) {
+              inter=v&15;
+            } else {
+              even=v>>4;
+              odd=v&15;
+              if (even==0) even=1;
+              if ((v&15)==0) odd=1;
+            }
+          }
+        }
+      }
+      total+=useOdd?odd:even;
+      rows++;
+      count++;
+      if (inter<=count) {
+        count=0;
+        useOdd=!useOdd;
+      }
+    }
+    ts.maxRow[o]=len-1;
+  }
+  double t=(double)total/hz;
+  ts.totalTime=TimeMicros((int)t,(int)((t-(int)t)*1000000.0));
+  ts.totalTicks=total;
+  ts.totalRows=rows;
+  ts.isLoopDefined=true;
+  ts.isLoopable=true;
+  ts.loopStart.order=loopPos;
+  ts.loopStart.row=0;
+  ts.loopEnd.order=MAX(0,sub->ordersLen-1);
+  ts.loopEnd.row=MAX(0,ts.maxRow[ts.loopEnd.order]);
+  ts.loopStartTime=ts.getTimes(loopPos,0);
+}
diff --git a/src/engine/rgVgeMap.h b/src/engine/rgVgeMap.h
new file mode 100644
index 0000000..915795c
--- /dev/null
+++ b/src/engine/rgVgeMap.h
@@ -0,0 +1,86 @@
+// RG: VGM Music Maker <-> Furnace: efeitos, notas e volume nos dois sentidos.
+// O importador (fileOps/vge.cpp) mostra os efeitos do VGMMM com os códigos parecidos do Furnace, e
+// rgVge.cpp volta para os códigos do VGMMM na hora de tocar. As duas tabelas têm que ser o inverso uma da outra.
+#ifndef _RGVGEMAP_H
+#define _RGVGEMAP_H
+
+// efeito do VGMMM -> Furnace; false = célula vazia (ou efeito que o VGMMM ignora)
+static inline bool rgVgeFxToFur(unsigned char fx, unsigned char p, short& ofx, short& op) {
+  op=p;
+  switch (fx) {
+    case 0x00: if (p==0) return false; ofx=0x00; return true; // arpejo (000 = vazio)
+    case 0x01: case 0x02: case 0x03: case 0x04: case 0x0a: case 0x0f:
+      ofx=fx; return true;
+    case 0x05: ofx=0x06; return true; // portamento + volume
+    case 0x06: ofx=0x05; return true; // vibrato + volume
+    case 0x08: ofx=0x12; return true; // nível do operador 1..4
+    case 0x09: ofx=0x13; return true;
+    case 0x0c: ofx=0x14; return true;
+    case 0x0d: ofx=0x15; return true;
+    case 0x0b: ofx=0x18; return true; // canal 3 especial
+    case 0x0e:
+      switch (p>>4) {
+        case 0: case 1: case 2: case 3: // multiplicador do operador
+          ofx=0x16; op=(((p>>4)+1)<<4)|(p&15); return true;
+        case 0x9: ofx=0x0c; op=p&15; return true; // reinício da nota
+        case 0xc: ofx=0xec; op=p&15; return true; // corte
+        case 0xd: ofx=0xed; op=p&15; return true; // atraso
+        case 0xf: ofx=0x11; op=p&15; return true; // feedback
+        default: ofx=0x0e; return true;
+      }
+    case 0x15: ofx=0x10; return true; // LFO
+    case 0x17: ofx=0x20; return true; // modo do ruído
+    case 0x19: ofx=0x08; return true; // pan
+    case 0x1a: ofx=0x1a; return true; // tempo do DAC
+    case 0x1c: ofx=0x1c; return true; // toca amostra
+  }
+  return false;
+}
+
+// efeito do Furnace -> VGMMM; false = não existe no VGMMM
+static inline bool rgVgeFxFromFur(short fx, short p, unsigned char& ofx, unsigned char& op) {
+  if (p<0) p=0;
+  op=p&0xff;
+  switch (fx) {
+    case 0x00: case 0x01: case 0x02: case 0x03: case 0x04: case 0x0a: case 0x0f: case 0x0e: case 0x1a: case 0x1c:
+      ofx=fx; return true;
+    case 0x06: ofx=0x05; return true;
+    case 0x05: ofx=0x06; return true;
+    case 0x12: ofx=0x08; return true;
+    case 0x13: ofx=0x09; return true;
+    case 0x14: ofx=0x0c; return true;
+    case 0x15: ofx=0x0d; return true;
+    case 0x18: ofx=0x0b; return true;
+    case 0x16: {
+      int o=(p>>4)-1;
+      if (o<0 || o>3) return false;
+      ofx=0x0e; op=(o<<4)|(p&15); return true;
+    }
+    case 0x0c: ofx=0x0e; op=0x90|(p&15); return true;
+    case 0xec: ofx=0x0e; op=0xc0|(p&15); return true;
+    case 0xed: ofx=0x0e; op=0xd0|(p&15); return true;
+    case 0x11: ofx=0x0e; op=0xf0|(p&15); return true;
+    case 0x10: ofx=0x15; return true;
+    case 0x20: ofx=0x17; return true;
+    case 0x08: ofx=0x19; return true;
+  }
+  return false;
+}
+
+// volume: nos canais FM o 31 do VGMMM vira 7F (0x60+v); no PSG fica o número do VGMMM (1..31)
+static inline int rgVgeVolToFur(int ch, int v) {
+  if (v<=0) return -1;
+  return (ch<6)?(0x60+v):v;
+}
+static inline int rgVgeVolFromFur(int ch, int v) {
+  if (v<0) return 0;
+  if (ch<6) {
+    if (v>0x60) v-=0x60;
+    else v=v/3;
+  }
+  if (v<1) v=1;
+  if (v>31) v=31;
+  return v;
+}
+
+#endif
