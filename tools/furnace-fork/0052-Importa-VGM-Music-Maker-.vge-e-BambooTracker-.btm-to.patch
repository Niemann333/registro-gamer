+//---------- SSG ----------//
+namespace
+{
+constexpr int AUTO_ENV_SHAPE_TYPE[15] = { 17, 17, 17, 21, 21, 21, 21, 16, 17, 18, 19, 20, 21, 22, 23 };
+
+namespace ToneNoiseState
+{
+enum : uint8_t
+{
+	CLEAR_TN = 0,
+	TONE_TN = 1,
+	NOISE_TN = 2,
+	ALL_TN = 3
+};
