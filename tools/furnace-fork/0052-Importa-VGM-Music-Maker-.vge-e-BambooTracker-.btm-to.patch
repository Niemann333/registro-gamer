+// RG: byte do tocador do VGM Music Maker; o volume do canal mudo vira 15 (silêncio)
+void DivPlatformSMS::rgVgeWrite(unsigned char val) {
+  if (val&0x80) {
+    rgVgeLatch=(val>>4)&7;
+    if (rgVgeLatch&1) {
+      int ch=rgVgeLatch>>1;
+      rgVgeVol[ch]=val&15;
+      if (isMuted[ch]) val|=15;
+    }
+  } else if (rgVgeLatch&1) {
+    int ch=rgVgeLatch>>1;
+    rgVgeVol[ch]=val&15;
+    if (isMuted[ch]) val|=15;
+  }
+  rWrite(0,val);
+}
+
