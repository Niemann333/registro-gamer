From d1b270803b694079742537c2cf30d0fc39579875 Mon Sep 17 00:00:00 2001
From: Niemann333 <109040743+Niemann333@users.noreply.github.com>
Date: Wed, 25 Nov 2026 16:08:15 -0300
Subject: [PATCH 46/50] =?UTF-8?q?Modo=20FamiTracker:=20vibrato=20e=20arpej?=
 =?UTF-8?q?o=20no=20ru=C3=ADdo,=20000/1xx/2xx=20substituem=20o=203xx=20da?=
 =?UTF-8?q?=20mesma=20linha,=20sweep=20de=20hardware=20sem=20reescrever=20?=
 =?UTF-8?q?a=20altura,=20notas=20limitadas=20a=20C-0..B-7,=20slides=20at?=
 =?UTF-8?q?=C3=A9=20o=20limite=20do=20registrador?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 src/engine/platform/nes.cpp | 25 ++++++++++++++++++++++++-
 src/engine/platform/nes.h   |  3 +++
 src/engine/playback.cpp     | 18 ++++++++++++++++--
 3 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/src/engine/platform/nes.cpp b/src/engine/platform/nes.cpp
index 7a18634..906cf92 100644
--- a/src/engine/platform/nes.cpp
+++ b/src/engine/platform/nes.cpp
@@ -389,7 +389,8 @@ void DivPlatformNES::tick(bool sysTick) {
             }
           }
           // RG: no FamiTracker a sequência de pitch soma direto no índice do ruído (o importador inverte o sinal pensando nos pulsos)
-          if (parent->song.compatFlags.rgFamiTracker) ntPos-=chan[i].pitch2;
+          // RG: e o vibrato/pitch fino (efeitos 4xy/Pxx) também mexem no índice do ruído, como no FamiTracker
+          if (parent->song.compatFlags.rgFamiTracker) ntPos-=chan[i].pitch2+chan[i].pitch;
           else ntPos+=chan[i].pitch2;
           if (isE) {
             chan[i].freq=31-(ntPos&31);
@@ -426,7 +427,10 @@ void DivPlatformNES::tick(bool sysTick) {
       if (i==3) { // noise
         rWrite(0x4002+i*4,(chan[i].duty<<7)|chan[i].freq);
         rWrite(0x4003+i*4,(chan[i].len<<3));
+      } else if (parent->song.compatFlags.rgFamiTracker && i<2 && chan[i].sweep!=0x08 && !chan[i].rgSweepPend && !chan[i].keyOn) {
+        // RG: com o sweep de hardware ligado o FamiTracker deixa o chip mudar a altura sozinho
       } else {
+        chan[i].rgSweepPend=false;
         rWrite(0x4002+i*4,chan[i].freq&0xff);
         if ((chan[i].prevFreq>>8)!=(chan[i].freq>>8) || i==2) {
           rWrite(0x4003+i*4,(chan[i].len<<3)|(chan[i].freq>>8));
@@ -707,6 +711,11 @@ int DivPlatformNES::dispatch(DivCommand c) {
       break;
     case DIV_CMD_NOTE_PORTA: {
       int destFreq=chan[c.chan].calcBaseFreq(c.value2+chan[c.chan].sampleNoteDelta);
+      // RG: no FamiTracker os slides 1xx/2xx só param no limite do registrador (0..0x7FF), não na última nota
+      if (parent->song.compatFlags.rgFamiTracker && c.chan<3) {
+        if (c.value2+chan[c.chan].sampleNoteDelta>155) destFreq=1;
+        else if (c.value2+chan[c.chan].sampleNoteDelta<60) destFreq=0x800;
+      }
       bool return2=false;
       if (destFreq>chan[c.chan].baseFreq) {
         chan[c.chan].baseFreq+=c.value;
@@ -752,6 +761,9 @@ int DivPlatformNES::dispatch(DivCommand c) {
       }
       rWrite(0x4001+(c.chan*4),chan[c.chan].sweep);
       chan[c.chan].sweepChanged=true;
+      chan[c.chan].rgSweepPend=true;
+      // RG: o FamiTracker escreve a altura junto com o sweep, no mesmo quadro
+      if (parent->song.compatFlags.rgFamiTracker && chan[c.chan].sweep!=0x08) chan[c.chan].freqChanged=true;
       break;
     case DIV_CMD_NES_ENV_MODE:
       chan[c.chan].envMode=c.value&3;
@@ -814,6 +826,14 @@ int DivPlatformNES::dispatch(DivCommand c) {
       }
       break;
     case DIV_CMD_LEGATO:
+      // RG: modo FamiTracker: o arpejo do efeito também vale no ruído (o "período" do ruído é a própria nota)
+      if (c.chan==3 && c.value2==1 && parent->song.compatFlags.rgFamiTracker) {
+        if (!chan[c.chan].std.arp.has) {
+          chan[c.chan].baseFreq=c.value;
+          chan[c.chan].freqChanged=true;
+        }
+        break;
+      }
       if (c.chan==3) break;
       // RG: modo FamiTracker: arpejo do efeito (value2=1) não mexe na nota base e é ignorado enquanto a sequência de arpejo do instrumento roda
       if (c.value2==1 && parent->song.compatFlags.rgFamiTracker) {
@@ -1071,6 +1091,9 @@ void DivPlatformNES::notifyPitchTable(int sample) {
       if (n<0 || n>=192) continue;
       pitchTable.rgExactTab[n]=CLAMP(pitchTable.rgExactTab[n]-1-rgDetune[i],0,0x7ff)+1;
     }
+    // RG: o FamiTracker limita as notas a C-0..B-7 (Furnace 60..155)
+    for (int i=0; i<60; i++) pitchTable.rgExactTab[i]=pitchTable.rgExactTab[60];
+    for (int i=156; i<192; i++) pitchTable.rgExactTab[i]=pitchTable.rgExactTab[155];
   }
   samplePitchTable.update<Channel>(chan,5,parent->song.tuning,1,1,32000,false,parent->song.compatFlags.linearPitch,sample);
 }
diff --git a/src/engine/platform/nes.h b/src/engine/platform/nes.h
index 9148452..f4dc1c5 100644
--- a/src/engine/platform/nes.h
+++ b/src/engine/platform/nes.h
@@ -36,11 +36,14 @@ class DivPlatformNES: public DivDispatch {
     int rgMacVol;
     // RG: duty padrão (último Vxx); no FamiTracker cada nota nova volta a ele
     unsigned char rgDefDuty;
+    // RG: sweep de hardware acabou de ser (re)aplicado: só então o FamiTracker escreve a altura
+    bool rgSweepPend;
     Channel(bool linear=true):
       SharedChannel(15,linear),
       rgVolNZ(true),
       rgMacVol(15),
       rgDefDuty(0),
+      rgSweepPend(false),
       prevFreq(65535),
       duty(0),
       sweep(8),
diff --git a/src/engine/playback.cpp b/src/engine/playback.cpp
index 34bf441..1831c36 100644
--- a/src/engine/playback.cpp
+++ b/src/engine/playback.cpp
@@ -999,6 +999,13 @@ void DivEngine::processRow(int i, bool afterDelay) {
     // RG: no FamiTracker o canal tem um só efeito contínuo: portamento/slide (1xx 2xx 3xx Qxy Rxy) substitui o arpejo
     if (song.compatFlags.rgFamiTracker && (effect==0x01 || effect==0x02 || effect==0x03 || effect==0xe1 || effect==0xe2)) {
       chan[i].arp=0;
+      // RG: 1xx/2xx/Qxy/Rxy depois de um 3xx na mesma linha substituem o portamento: a nota toca normalmente
+      if (effect!=0x03 && calledPorta) {
+        calledPorta=false;
+        chan[i].inPorta=false;
+        dispatchCmd(DivCommand(DIV_CMD_PRE_PORTA,i,false,0));
+        if (chan[i].keyOn) chan[i].doNote=true;
+      }
     }
     if (!perSystemEffect(i,effect,effectVal)) switch (effect) {
       /// PANNING
@@ -1351,14 +1358,21 @@ void DivEngine::processRow(int i, bool afterDelay) {
         chan[i].arp=effectVal;
         // RG: no FamiTracker o canal tem um só "efeito contínuo": o arpejo substitui portamento/slide
         // (000 também conta: no FamiTracker ele ocupa o slot e desliga o portamento)
-        if (song.compatFlags.rgFamiTracker && chan[i].portaSpeed>0) {
+        if (song.compatFlags.rgFamiTracker && (chan[i].portaSpeed>0 || calledPorta)) {
           chan[i].portaSpeed=-1;
           chan[i].inPorta=false;
           dispatchCmd(DivCommand(DIV_CMD_HINT_PORTA,i,chan[i].portaNote,0));
+          dispatchCmd(DivCommand(DIV_CMD_PRE_PORTA,i,false,0));
+          // se o 3xx estava na mesma linha, a nota volta a tocar normalmente
+          if (calledPorta) {
+            calledPorta=false;
+            if (chan[i].keyOn) chan[i].doNote=true;
+          }
         }
         // COMPAT FLAG: reset note to base on arp stop (inverted in the GUI)
         // - a 0000 effect resets arpeggio position
-        if (chan[i].arp==0 && song.compatFlags.arp0Reset) {
+        // RG: no FamiTracker o 000 só desliga o arpejo; a altura fica onde estava
+        if (chan[i].arp==0 && song.compatFlags.arp0Reset && !song.compatFlags.rgFamiTracker) {
           chan[i].resetArp=true;
         }
         dispatchCmd(DivCommand(DIV_CMD_HINT_ARPEGGIO,i,chan[i].arp));
-- 
