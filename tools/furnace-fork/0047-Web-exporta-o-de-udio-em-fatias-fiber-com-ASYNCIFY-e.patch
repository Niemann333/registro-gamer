diff --git a/src/engine/wavOps.cpp b/src/engine/wavOps.cpp
index dc0c154..9872bc2 100644
--- a/src/engine/wavOps.cpp
+++ b/src/engine/wavOps.cpp
@@ -26,6 +26,50 @@
 
 #define EXPORT_BUFSIZE 2048
 
+#ifdef __EMSCRIPTEN__
+// RG: a versão web não tem threads; a exportação roda numa fiber e a interface chama rgExportStep()
+// a cada quadro, que executa ~25 ms de exportação e devolve o controle (a página não trava).
+#include <emscripten.h>
+#include <emscripten/fiber.h>
+static emscripten_fiber_t rgMainFib, rgExpFib;
+static void* rgMainAsy=NULL;
+static void* rgExpAsy=NULL;
+static void* rgExpStack=NULL;
+static bool rgExpRunning=false;
+static bool rgExpFinished=true;
+static double rgSliceEnd=0.0;
+#define RG_MAIN_ASY_SIZE (256*1024)
+#define RG_EXP_ASY_SIZE (1024*1024)
+#define RG_EXP_STACK_SIZE (4*1024*1024)
+
+static void rgExpEntry(void* arg) {
+  ((DivEngine*)arg)->runExportThread();
+  rgExpFinished=true;
+  emscripten_fiber_swap(&rgExpFib,&rgMainFib);
+}
+
+void DivEngine::rgExportYield() {
+  if (!rgExpRunning) return;
+  if (emscripten_get_now()<rgSliceEnd) return;
+  emscripten_fiber_swap(&rgExpFib,&rgMainFib);
+}
+
+void DivEngine::rgExportStep() {
+  if (rgExpFinished || rgExpRunning) return;
+  rgExpRunning=true;
+  rgSliceEnd=emscripten_get_now()+25.0;
+  emscripten_fiber_swap(&rgMainFib,&rgExpFib);
+  rgExpRunning=false;
+}
+#define RG_EXPORT_YIELD rgExportYield()
+#else
+void DivEngine::rgExportYield() {
+}
+void DivEngine::rgExportStep() {
+}
+#define RG_EXPORT_YIELD
+#endif
+
 void _runExportThread(DivEngine* caller) {
   caller->runExportThread();
 }
@@ -240,6 +284,7 @@ void DivEngine::runExportThread() {
       while (playing) {
         size_t total=0;
         nextBuf(NULL,outBuf,0,exportOutputs,EXPORT_BUFSIZE,true);
+        RG_EXPORT_YIELD;
         if (totalProcessed>EXPORT_BUFSIZE) {
           logE("error: total processed is bigger than export bufsize! %d>%d",totalProcessed,EXPORT_BUFSIZE);
           totalProcessed=EXPORT_BUFSIZE;
@@ -335,6 +380,7 @@ void DivEngine::runExportThread() {
       while (playing) {
         size_t total=0;
         nextBuf(NULL,outBuf,0,2,EXPORT_BUFSIZE,true);
+        RG_EXPORT_YIELD;
         if (totalProcessed>EXPORT_BUFSIZE) {
           logE("error: total processed is bigger than export bufsize! %d>%d",totalProcessed,EXPORT_BUFSIZE);
           totalProcessed=EXPORT_BUFSIZE;
@@ -495,6 +541,7 @@ void DivEngine::runExportThread() {
         while (playing) {
           size_t total=0;
           nextBuf(NULL,outBuf,0,exportOutputs,EXPORT_BUFSIZE,true);
+        RG_EXPORT_YIELD;
           if (totalProcessed>EXPORT_BUFSIZE) {
             logE("error: total processed is bigger than export bufsize! %d>%d",totalProcessed,EXPORT_BUFSIZE);
             totalProcessed=EXPORT_BUFSIZE;
@@ -640,12 +687,26 @@ bool DivEngine::saveAudio(const char* path, DivAudioExportOptions options) {
   if (exportOutputs>DIV_MAX_OUTPUTS) exportOutputs=DIV_MAX_OUTPUTS;
 
   exportLoopCount=options.loops+1;
+#ifdef __EMSCRIPTEN__
+  // RG: sem threads na web: prepara a fiber; a interface vai chamando rgExportStep()
+  if (rgMainAsy==NULL) rgMainAsy=malloc(RG_MAIN_ASY_SIZE);
+  if (rgExpAsy==NULL) rgExpAsy=malloc(RG_EXP_ASY_SIZE);
+  if (rgExpStack==NULL) rgExpStack=malloc(RG_EXP_STACK_SIZE);
+  emscripten_fiber_init_from_current_context(&rgMainFib,rgMainAsy,RG_MAIN_ASY_SIZE);
+  emscripten_fiber_init(&rgExpFib,rgExpEntry,this,rgExpStack,RG_EXP_STACK_SIZE,rgExpAsy,RG_EXP_ASY_SIZE);
+  rgExpFinished=false;
+  exportThread=NULL;
+#else
   exportThread=new std::thread(_runExportThread,this);
+#endif
   return true;
 #endif
 }
 
 void DivEngine::waitAudioFile() {
+#ifdef __EMSCRIPTEN__
+  while (!rgExpFinished) rgExportStep();
+#endif
   if (exportThread!=NULL) {
     exportThread->join();
   }
