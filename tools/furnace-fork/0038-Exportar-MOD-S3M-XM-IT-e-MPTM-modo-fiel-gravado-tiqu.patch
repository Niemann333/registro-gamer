+    if (!semis.empty()) {
+      double sx=0, sy=0;
+      for (double s: semis) {
+        sx+=cos(2*M_PI*s);
+        sy+=sin(2*M_PI*s);
+      }
+      frac=atan2(sy,sx)/(2*M_PI);
