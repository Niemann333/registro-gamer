+  }
+
+  // pitch (in units) of note index n of sample b
+  auto noteUnits=[&](int b, int n) -> double {
+    const MSmp& m=bank[b];
+    switch (fmt) {
+      case RG_FMT_MOD: {
+        // finetune shifts the period by 1/8 semitone steps
