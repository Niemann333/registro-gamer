+      w->writeS(patLen[i]);
+      w->writeS(pd.size());
+      w->write(pd.data(),pd.size());
+    }
+    for (size_t i=0; i<bank.size(); i++) {
+      MSmp& m=bank[i];
+      w->writeI(263);
+      putName(m.name,22);
+      w->writeC(0);
+      w->writeS(1);
+      w->writeI(40);
+      for (int k=0; k<96; k++) w->writeC(0);
+      for (int k=0; k<96; k++) w->writeC(0); // envelopes
+      for (int k=0; k<14; k++) w->writeC(0); // envelope settings, vibrato
+      w->writeS(0); // fadeout
+      for (int k=0; k<22; k++) w->writeC(0);
+      int bytes=m.bits16?2:1;
+      w->writeI(m.data.size()*bytes);
+      w->writeI(m.loopType?m.loopStart*bytes:0);
+      w->writeI(m.loopType?(m.loopEnd-m.loopStart)*bytes:0);
+      w->writeC(64);
+      w->writeC((signed char)m.fine);
+      w->writeC((m.loopType&3)|(m.bits16?0x10:0));
+      w->writeC(128);
+      w->writeC((signed char)m.rel);
+      w->writeC(0);
+      putName(m.name,22);
+      int last=0;
+      for (short v: m.data) {
+        if (m.bits16) {
+          w->writeS((short)(v-last));
+          last=v;
+        } else {
+          int b=v>>8;
+          w->writeC((signed char)(b-last));
+          last=b;
+        }
+      }
+    }
+  } else if (fmt==RG_FMT_S3M) {
+    int nsmp=bank.size(), npat=pats.size(), nord=order.size();
+    if (nord&1) nord++;
+    putName(songName,28);
+    w->writeC(0x1a);
+    w->writeC(16);
+    w->writeS(0);
+    w->writeS(nord);
+    w->writeS(nsmp);
+    w->writeS(npat);
+    w->writeS(0); // flags
+    w->writeS(0x1320); // made with (ST 3.20)
+    w->writeS(2); // unsigned samples
+    w->write("SCRM",4);
+    w->writeC(64); // global volume
+    w->writeC(speed);
+    w->writeC(tempo);
+    w->writeC(0x80|48); // stereo, master volume
+    w->writeC(0);
+    w->writeC(252); // panning table present
+    for (int k=0; k<10; k++) w->writeC(0);
+    for (int c=0; c<32; c++) {
+      if (c<nch) {
+        w->writeC((chPan[c]<32)?(c&7):(8+(c&7)));
+      } else {
+        w->writeC(255);
+      }
+    }
+    for (int i=0; i<nord; i++) w->writeC(i<(int)order.size()?order[i]:255);
+    size_t smpPtr=w->tell();
+    for (int i=0; i<nsmp; i++) w->writeS(0);
+    size_t patPtr=w->tell();
+    for (int i=0; i<npat; i++) w->writeS(0);
+    for (int c=0; c<32; c++) w->writeC(c<nch?(0x20|MIN(15,(chPan[c]*15+32)/64)):0);
+    auto align16=[&]() {
+      while (w->tell()&15) w->writeC(0);
+    };
+    std::vector<size_t> dataPtr(nsmp);
+    for (int i=0; i<nsmp; i++) {
+      MSmp& m=bank[i];
+      align16();
+      size_t at=w->tell();
+      w->seek(smpPtr+2*i,SEEK_SET);
+      w->writeS(at>>4);
+      w->seek(at,SEEK_SET);
+      w->writeC(1);
+      putName("",12);
+      dataPtr[i]=w->tell();
+      w->writeC(0);
+      w->writeS(0);
+      w->writeI(m.data.size());
+      w->writeI(m.loopType?m.loopStart:0);
+      w->writeI(m.loopType?m.loopEnd:0);
+      w->writeC(64);
+      w->writeC(0);
+      w->writeC(0);
+      w->writeC((m.loopType?1:0)|(m.bits16?4:0));
+      w->writeI(m.c5);
+      for (int k=0; k<12; k++) w->writeC(0);
+      putName(m.name,28);
+      w->write("SCRS",4);
+    }
+    for (int i=0; i<npat; i++) {
+      align16();
+      size_t at=w->tell();
+      w->seek(patPtr+2*i,SEEK_SET);
+      w->writeS(at>>4);
+      w->seek(at,SEEK_SET);
+      std::vector<unsigned char> pd;
+      for (int r=0; r<64; r++) {
+        for (int c=0; c<nch; c++) {
+          const Cell& o=pats[i][(size_t)r*nch+c];
+          int note=-1, cmd=0, par=0;
+          if (o.note==NOTE_CUT) note=254;
+          else if (o.note>=0) note=((o.note/12)<<4)|(o.note%12);
+          switch (o.fx) {
+            case FX_OFFSET: cmd=15; par=o.fv; break;
+            case FX_PAN: cmd=19; par=0x80|MIN(15,(o.fv*15+32)/64); break;
+            case FX_SLIDE_XF: cmd=(o.fv>0)?6:5; par=0xe0|abs(o.fv); break;
+            case FX_SLIDE_F: cmd=(o.fv>0)?6:5; par=0xf0|abs(o.fv); break;
+            case FX_SLIDE_R: cmd=(o.fv>0)?6:5; par=abs(o.fv); break;
+            case FX_JUMP: cmd=2; par=o.fv; break;
+            case FX_BREAK: cmd=3; par=o.fv; break;
+          }
+          unsigned char what=0;
+          if (note>=0 || o.ins) what|=0x20;
+          if (o.vtype==1) what|=0x40;
+          if (cmd) what|=0x80;
+          if (!what) continue;
+          pd.push_back(what|c);
+          if (what&0x20) {
+            pd.push_back(note>=0?note:255);
+            pd.push_back(o.ins);
+          }
+          if (what&0x40) pd.push_back(clampVol(o.vval));
+          if (what&0x80) {
+            pd.push_back(cmd);
+            pd.push_back(par);
+          }
+        }
+        pd.push_back(0);
+      }
+      w->writeS(pd.size()+2);
+      w->write(pd.data(),pd.size());
+    }
+    for (int i=0; i<nsmp; i++) {
+      MSmp& m=bank[i];
+      align16();
+      size_t at=w->tell();
+      w->seek(dataPtr[i],SEEK_SET);
+      w->writeC((at>>20)&0xff);
+      w->writeS((at>>4)&0xffff);
+      w->seek(at,SEEK_SET);
+      for (short v: m.data) {
+        if (m.bits16) {
+          w->writeS((unsigned short)(v+32768));
+        } else {
+          w->writeC((unsigned char)((v>>8)+128));
+        }
+      }
+    }
+  } else {
+    // MOD
+    if (order.size()>128) {
+      fail("internal error: too many orders");
+      delete w;
+      return;
+    }
+    putName(songName,20);
+    for (int i=0; i<31; i++) {
+      if (i<(int)bank.size()) {
+        MSmp& m=bank[i];
+        int len=MIN((int)m.data.size(),131070)&(~1);
+        if (len<(int)m.data.size()) logAppendf("WARNING: sample %d is longer than 128KB and was cut",i+1);
+        putName(m.name,22);
+        w->writeS_BE(len/2);
+        w->writeC(m.fine&15);
+        w->writeC(64);
+        if (m.loopType && m.loopEnd>m.loopStart) {
+          int ls=MIN(m.loopStart,len)/2;
+          int ll=(MIN(m.loopEnd,len)/2)-ls;
+          if (ll<1) ll=1;
+          w->writeS_BE(ls);
+          w->writeS_BE(ll);
+        } else {
+          w->writeS_BE(0);
+          w->writeS_BE(1);
+        }
+      } else {
+        putName("",22);
+        w->writeS_BE(0);
+        w->writeC(0);
+        w->writeC(0);
+        w->writeS_BE(0);
+        w->writeS_BE(1);
+      }
+    }
+    w->writeC(order.size());
+    w->writeC(127);
+    for (int i=0; i<128; i++) w->writeC(i<(int)order.size()?order[i]:0);
+    if (nch==4) {
+      w->write("M.K.",4);
+    } else if (nch<10) {
+      w->writeC('0'+nch);
+      w->write("CHN",3);
+    } else {
+      w->writeC('0'+nch/10);
+      w->writeC('0'+nch%10);
+      w->write("CH",2);
+    }
+    for (size_t i=0; i<pats.size(); i++) {
+      for (int r=0; r<64; r++) {
+        for (int c=0; c<nch; c++) {
+          const Cell& o=pats[i][(size_t)r*nch+c];
+          int per=0, cmd=0, par=0;
+          if (o.note>=0 && o.ins) {
+            per=ptPeriods[o.note];
+          }
+          switch (o.fx) {
+            case FX_OFFSET: cmd=9; par=o.fv; break;
+            case FX_PAN: cmd=8; par=MIN(255,o.fv*4); break;
+            case FX_SLIDE_F: cmd=14; par=((o.fv>0)?0x10:0x20)|abs(o.fv); break;
+            case FX_SLIDE_R: cmd=(o.fv>0)?1:2; par=abs(o.fv); break;
+            case FX_VOL: cmd=12; par=o.fv; break;
+            case FX_JUMP: cmd=11; par=o.fv; break;
+            case FX_BREAK: cmd=13; par=0; break;
+          }
+          if (o.note==NOTE_CUT && cmd==0) {
+            cmd=12;
+            par=0;
+          }
+          int ins=o.ins;
+          w->writeC((ins&0xf0)|((per>>8)&15));
+          w->writeC(per&0xff);
+          w->writeC(((ins&15)<<4)|cmd);
+          w->writeC(par);
+        }
+      }
+    }
+    for (int i=0; i<(int)bank.size() && i<31; i++) {
+      MSmp& m=bank[i];
+      int len=MIN((int)m.data.size(),131070)&(~1);
+      for (int k=0; k<len; k++) w->writeC((signed char)(m.data[k]>>8));
+    }
+  }
+
+  output.push_back(DivROMExportOutput(String("export")+sp.ext,w));
+  progress[0].amount=1.0f;
+  logAppend("finished!");
+  running=false;
+}
