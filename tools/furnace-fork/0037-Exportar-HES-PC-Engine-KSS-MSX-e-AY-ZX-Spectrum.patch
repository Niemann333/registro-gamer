index 0000000..05e91ac
--- /dev/null
+++ b/src/engine/export/kss.cpp
@@ -0,0 +1,282 @@
+/**
+ * Furnace Tracker - multi-system chiptune tracker
+ * Copyright (C) 2021-2026 tildearrow and contributors
+ *
