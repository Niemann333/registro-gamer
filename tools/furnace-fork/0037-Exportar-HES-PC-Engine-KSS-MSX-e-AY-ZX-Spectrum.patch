diff --git a/src/engine/export/ayconv.h b/src/engine/export/ayconv.h
new file mode 100644
index 0000000..ec5d314
--- /dev/null
+++ b/src/engine/export/ayconv.h
@@ -0,0 +1,58 @@
+// Registro Gamer: AY-3-8910 register writes for a console with another AY clock (KSS: MSX, AY: ZX Spectrum).
+// the tone, noise and envelope periods are rescaled so the pitch stays the same; writes that change nothing
+// are dropped (except the envelope shape, which restarts the envelope).
+#ifndef _RG_AYCONV_H
+#define _RG_AYCONV_H
+
+#include <vector>
+#include <math.h>
+
+struct RGAYConv {
+  double f; // target clock / source clock
+  int in[16], out[16];
+  bool clamped;
+  RGAYConv(double ratio): f(ratio), clamped(false) {
+    for (int i=0; i<16; i++) in[i]=0;
+    forget();
+  }
+  void forget() {
+    for (int i=0; i<16; i++) out[i]=-1;
+  }
+  bool exact() const { return fabs(f-1.0)<0.0005; }
+  int scale(int v, int maxV) {
+    if (exact()) return v;
+    int r=(int)floor(v*f+0.5);
+    if (v>0 && r<1) r=1;
+    if (r>maxV) {
+      r=maxV;
+      clamped=true;
+    }
+    return r;
+  }
+  void put(std::vector<std::pair<int,int>>& o, int r, int v) {
+    if (r!=13 && out[r]==v) return;
+    out[r]=v;
+    o.push_back(std::make_pair(r,v));
+  }
+  // returns the writes to make on the target chip
+  void write(int r, int v, std::vector<std::pair<int,int>>& o) {
+    if (r<0 || r>15) return;
+    in[r]=v&0xff;
+    if (r<6) {
+      int ch=r>>1;
+      int p=scale(in[ch*2]|((in[ch*2+1]&15)<<8),4095);
+      put(o,ch*2,p&0xff);
+      put(o,ch*2+1,(p>>8)|(in[ch*2+1]&0xf0));
+    } else if (r==6) {
+      put(o,6,scale(in[6]&31,31)|(in[6]&0xe0));
+    } else if (r==11 || r==12) {
+      int p=scale(in[11]|(in[12]<<8),65535);
+      put(o,11,p&0xff);
+      put(o,12,p>>8);
+    } else {
+      put(o,r,in[r]);
+    }
+  }
+};
+
+#endif
diff --git a/src/engine/export/aydrv.asm b/src/engine/export/aydrv.asm
new file mode 100644
index 0000000..0106d9f
--- /dev/null
+++ b/src/engine/export/aydrv.asm
@@ -0,0 +1,198 @@
+; driver AY (ZXAYEMUL) do Tracker do Registro Gamer (Z80, ZX Spectrum 128). Fica em $4100 (pilha logo abaixo); o registro da música vem
+; logo depois, até o fim da memória. o player chama INTERRUPT 50 vezes por segundo; o quadro é dividido em passos
+; com espera contada em ciclos, e um acumulador de 24 bits decide em que passos tocam os tiques (qualquer taxa).
+; montar: python3 scripts/rg-z80inc.py src/engine/export/aydrv.asm ayDriver "comentário"
+;
+; registro:
+;   00-0F vv          AY: registrador cmd = vv (portas $FFFD/$BFFD)
+;   E0 lo hi nl nh    toca n bytes que estão em hi:lo e volta (aninhado até 8)
+;   F0-FD             fim do tique; espera cmd-F0 tiques a mais
+;   FE nn             fim do tique; espera nn tiques a mais
+;   FF                volta ao ponto de repetição (ou acaba)
+
+        org $4100
+
+INIT:   jp init_
+PLAY:   jp play_
+
+; parâmetros (o exportador preenche)
+LOG:    defw 0
+RATE:   defb 0, 0, 0, 0
+STEPS:  defb 16
+DLY:    defw 100
+SC:     defb 0
+LOOPP:  defw 0
+
+; estado
+PTR:    defw 0
+CNT:    defw 0
+DEPTH:  defb 0
+WAIT:   defb 0
+STOP:   defb 0
+ACC:    defb 0, 0, 0, 0
+ACCI:   defb 0, 0, 0
+T1:     defb 0
+STK:    defs 32
+
+init_:  ld hl,(LOG)
+        ld (PTR),hl
+        xor a
+        ld (DEPTH),a
+        ld (WAIT),a
+        ld (STOP),a
+        ld hl,(ACCI)            ; o primeiro tique cai no primeiro passo
+        ld (ACC),hl
+        ld a,(ACCI+2)
+        ld (ACC+2),a
+        ret
+
+play_:  ld a,(STEPS)            ; o quadro é dividido em STEPS passos iguais (DLY voltas de espera cada):
+        ld (SC),a               ; a cada passo o acumulador soma RATE e, se passar de 2^24, toca um tique,
+ps:     ld hl,(ACC)             ; assim os tiques caem perto da hora certa mesmo fora do ritmo do quadro
+        ld de,(RATE)
+        add hl,de
+        ld (ACC),hl
+        ld a,(ACC+2)
+        ld hl,RATE+2
+        adc a,(hl)
+        ld (ACC+2),a
+        jr nc,pn
+        call TICK
+pn:     ld a,(SC)
+        dec a
+        ld (SC),a
+        ret z
+        ld hl,(DLY)
+pd:     dec hl
+        ld a,h
+        or l
+        jr nz,pd
+        jr ps
+
+TICK:   ld a,(STOP)
+        or a
+        ret nz
+        ld a,(WAIT)
+        or a
+        jr z,rd
+        dec a
+        ld (WAIT),a
+        ret
+rd:     call GB
+        cp $f0
+        jr nc,ctl
+        cp $e0
+        jr z,ref
+        ld (T1),a
+        call GB
+        ld e,a
+        ld a,(T1)
+        ld bc,$fffd
+        out (c),a
+        ld b,$bf
+        out (c),e
+        jr rd
+ctl:    cp $fe
+        jr c,wk
+        jr z,wn
+        ld hl,(LOOPP)           ; FF: repetição ou fim
+        ld a,h
+        or l
+        jr z,fim
+        ld (PTR),hl
+        jr rd
+wk:     sub $f0
+        ld (WAIT),a
+        ret
+wn:     call GB
+        ld (WAIT),a
+        ret
+fim:    ld a,1
+        ld (STOP),a
+        ld a,8                  ; silêncio: volumes zerados
+        ld e,0
+fi1:    ld bc,$fffd
+        out (c),a
+        ld b,$bf
+        out (c),e
+        inc a
+        cp 11
+        jr nz,fi1
+        ret
+
+; trecho repetido: guarda onde estava e vai para hi:lo
+ref:    call GB
+        ld (T1),a
+        call GB
+        push af
+        call GB
+        push af
+        call GB                 ; nh
+        ld b,a
+        pop af                  ; nl
+        ld c,a
+        push bc
+        ld a,(DEPTH)            ; empilha ponteiro e contador (4 bytes)
+        add a,a
+        add a,a
+        ld e,a
+        ld d,0
+        ld hl,STK
+        add hl,de
+        ld de,(PTR)
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        inc hl
+        ld de,(CNT)
+        ld (hl),e
+        inc hl
+        ld (hl),d
+        ld a,(DEPTH)
+        inc a
+        ld (DEPTH),a
+        pop bc
+        ld (CNT),bc
+        pop af                  ; hi
+        ld h,a
+        ld a,(T1)
+        ld l,a
+        ld (PTR),hl
+        jp rd
+
+; um byte do registro em A (no fim de um trecho repetido, volta)
+GB:     ld hl,(PTR)
+        ld a,(hl)
+        inc hl
+        ld (PTR),hl
+        ld c,a
+        ld a,(DEPTH)
+        or a
+        jr z,gb9
+        ld hl,(CNT)
+        dec hl
+        ld (CNT),hl
+        ld a,h
+        or l
+        jr nz,gb9
+        ld a,(DEPTH)            ; acabou o trecho: volta
+        dec a
+        ld (DEPTH),a
+        add a,a
+        add a,a
+        ld e,a
+        ld d,0
+        ld hl,STK
+        add hl,de
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        inc hl
+        ld (PTR),de
+        ld e,(hl)
+        inc hl
+        ld d,(hl)
+        ld (CNT),de
+gb9:    ld a,c
+        ret
+DRVEND:
