diff --git a/src/main.cpp b/src/main.cpp
index 2d3a151..d7be112 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -716,6 +716,18 @@ EM_ASYNC_JS(void, rgWebMountHome, (), {
 });
 #endif
 
+#ifdef __EMSCRIPTEN__
+#include <SDL.h>
+// Registro Gamer: a página manda um arquivo (vindo do computador) como se fosse "arrastar e soltar"
+extern "C" EMSCRIPTEN_KEEPALIVE void rg_web_drop(const char* path) {
+  SDL_Event ev;
+  memset(&ev,0,sizeof(ev));
+  ev.type=SDL_DROPFILE;
+  ev.drop.file=SDL_strdup(path);
+  SDL_PushEvent(&ev);
+}
+#endif
+
 #if defined(__EMSCRIPTEN__) && defined(main)
 #undef main // o SDL troca main por SDL_main; no navegador o main é este
 #endif
