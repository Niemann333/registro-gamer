+  call !GB
+  mov TLO,a
+  call !GB
+  mov THI,a
+  call !GB
+  mov BCNT,a
+cpyl:
+  mov y,#0
+  mov a,[TLO]+y
+  mov [BLO]+y,a
+  incw TLO
+  incw BLO
+  dbnz BCNT,cpyl
+  jmp !next
