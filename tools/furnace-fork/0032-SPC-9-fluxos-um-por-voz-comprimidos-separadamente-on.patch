   call !GB
   mov TLO,a
@@ -120,22 +199,19 @@ waitn:
   mov WAIT,a
   ret
 loopop:
-  mov a,!HASLOOP
+  mov a,LOOPL
+  or a,LOOPH
   beq endsong
-  mov a,!LOOPLO
-  mov PTR,a
-  mov a,!LOOPHI
-  mov PTRH,a
+  movw ya,LOOPL
+  movw PTR,ya
   jmp !next
 endsong:
+  mov a,SIDX
+  cmp a,#8
+  bne es2
   mov $F2,#$5C
   mov $F3,#$FF
+es2:
   mov WAIT,#$FF
   decw PTR
   ret
