+  writeOutVol(ch);
+}
+
+void DivPlatformPSX::forceIns() {
+  for (int i=0; i<24; i++) {
+    chan[i].insChanged=true;
+    chan[i].freqChanged=true;
+    writeOutVol(i);
+  }
+}
