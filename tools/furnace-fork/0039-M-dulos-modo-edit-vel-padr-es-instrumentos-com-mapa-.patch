+      en.pts.resize(maxNodes);
+      break;
+    }
+    en.pts.erase(en.pts.begin()+best);
+    if (en.loopStart>best) en.loopStart--;
+    if (en.loopEnd>best) en.loopEnd--;
+    if (en.susStart>best) en.susStart--;
+    if (en.susEnd>best) en.susEnd--;
