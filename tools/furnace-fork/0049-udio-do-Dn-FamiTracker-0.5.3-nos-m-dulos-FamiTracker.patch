+
+	uint8_t m_cPort;
+
+	int m_iCounter;
+
+	uint32_t m_iNoisePeriod;
+	uint32_t m_iNoiseClock;
+	uint32_t m_iNoiseState;
+
+	uint32_t m_iEnvelopePeriod;
+	uint32_t m_iEnvelopeClock;
+	char m_iEnvelopeLevel;
+	char m_iEnvelopeShape;
+	bool m_bEnvelopeHold;
+};
