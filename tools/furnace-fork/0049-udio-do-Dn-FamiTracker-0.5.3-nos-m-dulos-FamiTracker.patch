+	void SetupMixer(
+		int LowCut,
+		int HighCut,
+		int HighDamp,
+		int Volume,
+		bool UseSurveyMix,
+		int16_t FDSLowpass,
+		int16_t N163Lowpass,
+		std::vector<int16_t> DeviceMixOffsets
+	);
