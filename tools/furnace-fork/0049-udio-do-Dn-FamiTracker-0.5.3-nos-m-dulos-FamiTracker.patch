+enum chip_level_t {
+	CHIP_LEVEL_APU1,
+	CHIP_LEVEL_APU2,
+	CHIP_LEVEL_VRC6,
+	CHIP_LEVEL_VRC7,
+	CHIP_LEVEL_FDS,
