From 21481c25b11168622b1b0f1471f2507b15093177 Mon Sep 17 00:00:00 2001
From: Niemann333 <109040743+Niemann333@users.noreply.github.com>
Date: Thu, 26 Nov 2026 15:42:58 -0300
Subject: [PATCH 51/53] NSF com Sunsoft 5B; rgf_subsong_name

---
 src/engine/export/nsf.cpp | 11 ++++++++++-
 src/rgplayer.cpp          |  7 +++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/engine/export/nsf.cpp b/src/engine/export/nsf.cpp
index dd6d9a9..2c14565 100644
--- a/src/engine/export/nsf.cpp
+++ b/src/engine/export/nsf.cpp
@@ -65,7 +65,7 @@ static void putStr(SafeWriter* w, const String& str) {
 }
 
 void DivExportNSF::run() {
-  int sysNES=-1, sysFDS=-1, sysVRC6=-1, sysVRC7=-1, sysN163=-1, sysMMC5=-1;
+  int sysNES=-1, sysFDS=-1, sysVRC6=-1, sysVRC7=-1, sysN163=-1, sysMMC5=-1, sys5B=-1;
   std::vector<int> sys;
   for (int i=0; i<e->song.systemLen; i++) {
     int* slot=NULL;
@@ -76,6 +76,8 @@ void DivExportNSF::run() {
       case DIV_SYSTEM_VRC7: slot=&sysVRC7; break;
       case DIV_SYSTEM_N163: slot=&sysN163; break;
       case DIV_SYSTEM_MMC5: slot=&sysMMC5; break;
+      // Sunsoft 5B (FME-7): o AY8910 do Furnace no modo 5B (chipType 2)
+      case DIV_SYSTEM_AY8910: if (e->song.systemFlags[i].getInt("chipType",0)==2) slot=&sys5B; break;
       default: break;
     }
     if (slot==NULL) {
@@ -138,6 +140,12 @@ void DivExportNSF::run() {
           f.push_back(w.addr-0x4000);
           f.push_back(w.val&0xff);
         }
+      } else if (w.sys==sys5B) {
+        // registrador em $C000, valor em $E000
+        if (w.addr<16) {
+          f.push_back(0x80); f.push_back(0x00); f.push_back(0xc0); f.push_back(w.addr);
+          f.push_back(0x80); f.push_back(0x00); f.push_back(0xe0); f.push_back(w.val&0xff);
+        }
       } else if (w.sys==sysVRC7) {
         if (w.addr<0x40) {
           f.push_back(0x81);
@@ -218,6 +226,7 @@ void DivExportNSF::run() {
   if (sysFDS>=0) exp|=4;
   if (sysMMC5>=0) exp|=8;
   if (sysN163>=0) exp|=16;
+  if (sys5B>=0) exp|=32;
 
   SafeWriter* w=new SafeWriter;
   w->init();
diff --git a/src/rgplayer.cpp b/src/rgplayer.cpp
index 7ee4f04..f2aaa53 100644
--- a/src/rgplayer.cpp
+++ b/src/rgplayer.cpp
@@ -99,6 +99,13 @@ RGF_EXPORT int rgf_subsong(int i) {
   return e->rgPlayStart(sampleRate)?1:0;
 }
 
+// nome da subfaixa i (sem trocar a música que está tocando)
+RGF_EXPORT const char* rgf_subsong_name(int i) {
+  if (e==NULL || i<0 || i>=(int)e->song.subsong.size()) return "";
+  strBuf=e->song.subsong[i]->name;
+  return strBuf.c_str();
+}
+
 RGF_EXPORT int rgf_restart() {
   return (e!=NULL && e->rgPlayStart(sampleRate))?1:0;
 }
-- 
