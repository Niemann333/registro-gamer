+  bool rounded;
+  bool frameBorders;
+  int mainFont;                // fonte embutida (6 = arquivo em mainPath)
+  const char* mainPath;
+  int mainSize;
+  int patFont;
+  const char* patPath;
+  int patSize;
+};
