+int rgFTRowLen(int& accum, int tempoN, int tempoD, double hz, int speed) {
+  if (speed<1) speed=1;
+  int rate=(int)round(hz);
+  if (rate<1) rate=1;
+  int tempo=(tempoN==tempoD)?0:(int)round((double)tempoN*2.5*hz/(double)MAX(1,tempoD));
+  int inc, dec, rem;
+  if (tempo>0) {
+    inc=60*rate;
+    dec=(tempo*24)/speed;
+    rem=(tempo*24)%speed;
+  } else {
+    inc=speed;
+    dec=1;
+    rem=0;
+  }
+  if (dec<1) dec=1;
+  // quadro da linha: o acumulador está <= 0, então soma e subtrai
+  int a=accum+inc-rem-dec;
+  int len=1;
+  while (a>0 && len<4096) {
+    a-=dec;
+    len++;
+  }
+  accum=a;
+  return len;
+}
