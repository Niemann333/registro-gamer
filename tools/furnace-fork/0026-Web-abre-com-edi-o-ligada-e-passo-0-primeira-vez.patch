 src/gui/gui.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/gui/gui.cpp b/src/gui/gui.cpp
index 56b9de7..d7b453c 100644
--- a/src/gui/gui.cpp
+++ b/src/gui/gui.cpp
@@ -9385,6 +9385,16 @@ void FurnaceGUI::syncState() {
   followPattern=e->getConfBool("followPattern",true);
   editStep=e->getConfInt("editStep",1);
   editStepCoarse=e->getConfInt("editStepCoarse",16);
+#ifdef __EMSCRIPTEN__
+  // Web (Chiptune Studio): na primeira vez, o Tracker já abre com a edição ligada (clicar na casa e digitar)
+  // e com passo 0 (a nota fica onde foi escrita). Depois vale o que a pessoa escolher.
+  if (!e->getConfBool("rgWebDefaults1",false)) {
+    edit=true;
+    editStep=0;
+    e->setConf("rgWebDefaults1",true);
+    e->setConf("rgPassoZero",true);
+  }
+#endif
   noteInputMode=e->getConfInt("noteInputMode",GUI_NOTE_INPUT_POLY);
   if (noteInputMode!=GUI_NOTE_INPUT_MONO && noteInputMode!=GUI_NOTE_INPUT_POLY && noteInputMode!=GUI_NOTE_INPUT_CHORD) {
     noteInputMode=GUI_NOTE_INPUT_POLY;
