+        bits+=6;
+        if (bits>=8) {
+          bits-=8;
+          bin+=(char)((acc>>bits)&0xff);
+        }
+      }
+      if (rgvge::load((const unsigned char*)bin.data(),bin.size())==0) return true;
+    }
+  }
+  return false;
+}
