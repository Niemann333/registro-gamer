 src/main.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/main.cpp b/src/main.cpp
index 0e46579..2d3a151 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -721,7 +721,15 @@ EM_ASYNC_JS(void, rgWebMountHome, (), {
 #endif
 // TODO: CoInitializeEx on Windows?
 // TODO: add crash log
+#ifdef __EMSCRIPTEN__
+// o clang 15 renomeia main(argc,argv) e o Emscripten 3.1.6 não acha; exporta "main" com o nome certo
+static int furnaceMain(int argc, char** argv);
+extern "C" int rgWebMain(int argc, char** argv) __asm__("main");
+extern "C" int rgWebMain(int argc, char** argv) { return furnaceMain(argc,argv); }
+static int furnaceMain(int argc, char** argv) {
+#else
 int main(int argc, char** argv) {
+#endif
 #ifdef __EMSCRIPTEN__
   rgWebMountHome();
 #endif
